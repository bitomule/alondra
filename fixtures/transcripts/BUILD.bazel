load("//bazel/rules:tree.bzl", "repo_tree")

# Transcripts in the shape a real session leaves, below every crate that replays them.
# `//crates/scenarios:transcript_guard_test` checks each.
filegroup(
    name = "transcripts",
    srcs = glob(["**/*.ndjson"]),
    visibility = ["//visibility:public"],
)

repo_tree()
