filegroup(
    name = "all",
    srcs = glob(["*.json"], allow_empty = True),
    visibility = ["//visibility:public"],
)

# What the daemon renders: one golden per screen and client.
filegroup(
    name = "cards",
    srcs = glob(["cards/*.json"], allow_empty = True),
    visibility = ["//visibility:public"],
)

# The cards the iPhone app and the demo bundle: a bundle keeps no folders, so the Mac and terminal
# files, which share their names with the iPhone ones, stay out.
filegroup(
    name = "cards_ios",
    srcs = glob(["cards/*.json"], exclude = ["cards/*-mac.json", "cards/*-tui.json"], allow_empty = True),
    visibility = ["//visibility:public"],
)

# The Mac sidebar the demo shows, which the Mac app bundles beside the iPhone cards.
filegroup(
    name = "demo_mac",
    srcs = ["cards/sidebar-mac.json", "cards/sidebar-mac-es.json"],
    visibility = ["//visibility:public"],
)

# Views as a daemon newer than the client sends them: kinds and values the client does not know.
filegroup(
    name = "newer_daemon",
    srcs = glob(["newer-daemon/*.json"], allow_empty = True),
    visibility = ["//visibility:public"],
)
