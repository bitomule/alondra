# Opt-in like the system suites: real daemons, relay and loopback ports, outside `make test`.
# Every sandbox Mac runs its tasks and orchestrator batches through the Agent SDK host, whose
# native Claude is the sandbox's scripted fake: the pinned Node and the host bundle are data.
sh_test(
    name = "scenarios",
    timeout = "long",
    srcs = ["scenarios.sh"],
    args = [
        "$(rootpath //crates/alondrad)",
        "$(rootpath //crates/alondra)",
        "$(rootpath //crates/relay:alondra-relay)",
        "$(rootpath //tools/sandbox:alondra-sandbox)",
        "$(rootpath //agent-host:pinned_node)",
        "$(rootpath //agent-host:persistent.cjs)",
    ],
    data = [
        "//:plugin_files",
        "//agent-host:persistent.cjs",
        "//agent-host:pinned_node",
        "//tools:e2e_sdk_backend.py",
        "//tools:e2e-sandbox.sh",
        "//tools:sandbox_accounts.py",
        "//tools:e2e-sandbox-stop.sh",
        "//crates/alondra",
        "//crates/alondrad",
        "//crates/relay:alondra-relay",
        "//tools/sandbox:alondra-sandbox",
    ],
    env_inherit = [
        "HOME",
        "PATH",
    ],
    tags = [
        "local",
        "manual",
        "requires-network",
    ],
)

