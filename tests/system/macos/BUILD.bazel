# The CLI gate's local daemon checks against this checkout's binaries; the Tart gate runs the
# same checks on the published package.
sh_test(
    name = "local_daemon_test",
    srcs = ["local_daemon_test.py"],
    args = [
        "$(rootpath //crates/alondra:alondra)",
        "$(rootpath //crates/alondrad:alondrad)",
    ],
    data = [
        "cli.py",
        "//crates/alondra:alondra",
        "//crates/alondrad:alondrad",
    ],
    size = "small",
    # Starts daemons on loopback outside Bazel's sandbox; unlike `local`, its result is still cached.
    tags = ["no-sandbox"],
)

sh_test(
    name = "build_from_source_test",
    srcs = ["build_from_source_test.py"],
    data = ["build_from_source.sh"],
    size = "small",
    # Runs git and make from the script in a temporary directory outside Bazel's sandbox.
    tags = ["no-sandbox"],
)
