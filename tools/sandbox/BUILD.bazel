load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//tools:rust_test.bzl", "low_opt_rust_test")

rust_binary(
    name = "alondra-sandbox",
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    compile_data = glob(["fixtures/**"]),
    crate_name = "alondra_sandbox",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/e2e:alondra_e2e",
        "@crates//:anyhow",
        "@crates//:base64",
        "@crates//:clap",
        "@crates//:iroh",
        "@crates//:p256",
        "@crates//:ring",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tokio",
        "@crates//:toml",
        "@crates//:ureq",
    ],
)

low_opt_rust_test(
    name = "alondra-sandbox_test",
    size = "small",
    crate = ":alondra-sandbox",
    edition = "2024",
    deps = ["@crates//:tempfile"],
)
