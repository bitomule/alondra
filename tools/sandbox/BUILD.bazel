load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

rust_binary(
    name = "alondra-sandbox",
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    crate_name = "alondra_sandbox",
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/e2e:alondra_e2e",
        "@crates//:anyhow",
        "@crates//:base64",
        "@crates//:clap",
        "@crates//:iroh",
        "@crates//:p256",
        "@crates//:ring",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tokio",
        "@crates//:toml",
        "@crates//:ureq",
    ],
)

rust_test(
    name = "alondra-sandbox_test",
    crate = ":alondra-sandbox",
    edition = "2024",
    deps = ["@crates//:tempfile"],
)
