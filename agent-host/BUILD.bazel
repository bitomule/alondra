load(":toolchain.bzl", "pinned_node")
load("@host_npm//:defs.bzl", "npm_link_all_packages")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_test", "js_run_binary")

package(default_visibility = ["//visibility:public"])
npm_link_all_packages(name = "node_modules")
exports_files(["pnpm-lock.yaml", "package.json"])

ts_project(
    name = "host_lib",
    srcs = ["session.ts", "main.ts", "frame.ts", "bootstrap.ts", "channel.ts", "diagnostics.ts", "journal.ts", "ownership.ts", "persistent.ts", "persistent-core.ts", "host-session.ts", "codex-session.ts", "codex-rollout.ts", "codex-main.ts", "persistent-main.ts", "probe.ts", "persistent-fixture-main.ts", "usage-probe.ts", "model-probe.ts"],
    tsconfig = "tsconfig.json",
    declaration = True,
    transpiler = "tsc",
    deps = [
        ":node_modules/@anthropic-ai/claude-agent-sdk",
        ":node_modules/@anthropic-ai/sdk",
        ":node_modules/@modelcontextprotocol/sdk",
        ":node_modules/@types/node",
        ":node_modules/zod",
    ],
)

js_test(
    name = "sdk_test",
    no_copy_to_bin = ["//crates/agent-protocol:wire_fixtures"],
    entry_point = "session.test.mjs",
    data = [":host_lib", "fake-claude.mjs", "//crates/agent-protocol:fixtures/start.json", ":node_modules/@anthropic-ai/claude-agent-sdk", ":node_modules/@modelcontextprotocol/sdk", ":node_modules/zod"],
)

js_binary(
    name = "bundle_tool",
    entry_point = "bundle.mjs",
    data = [":node_modules/esbuild", ":node_modules/@esbuild/darwin-arm64"],
)
js_run_binary(
    name = "bundle",
    tool = ":bundle_tool",
    srcs = [":host_lib", "main.ts", "session.ts", ":node_modules/@anthropic-ai/claude-agent-sdk", ":node_modules/@modelcontextprotocol/sdk", ":node_modules/zod"],
    outs = ["host.cjs", "host.meta.json"],
    args = ["$(location main.ts)", "$(location host.cjs)", "$(location host.meta.json)"],
)
js_binary(
    name = "sea_tool",
    entry_point = "sea.mjs",
    data = [":node_modules/postject"],
)
js_run_binary(
    name = "sea",
    tool = ":sea_tool",
    srcs = ["host.cjs"],
    outs = ["host", "host.manifest.json"],
    args = ["$(location host.cjs)", "$(location host)", "$(location host.manifest.json)"],
)
# The host a release ships: the persistent host, Node and the SDK in one executable, signed ad hoc
# under the hardened runtime with the entitlements the release's Developer ID signature keeps.
js_run_binary(
    name = "release_host",
    tool = ":sea_tool",
    srcs = ["persistent.cjs", "host-entitlements.plist"],
    outs = ["alondra-host", "alondra-host.manifest.json"],
    args = ["$(location persistent.cjs)", "$(location alondra-host)", "$(location alondra-host.manifest.json)", "$(location host-entitlements.plist)"],
)
exports_files(["host-entitlements.plist"])
js_test(
    name = "sea_test",
    entry_point = "sea.test.mjs",
    data = [":sea", ":bundle", "fake-claude.py"],
)

js_test(
    name = "frame_test",
    no_copy_to_bin = ["//crates/agent-protocol:wire_fixtures"],
    entry_point = "frame.test.mjs",
    data = [
        ":host_lib",
        ":node_modules/zod",
        "//crates/agent-protocol:fixtures/action-capabilities.json",
        "//crates/agent-protocol:fixtures/controls.json",
        "//crates/agent-protocol:fixtures/decision.json",
        "//crates/agent-protocol:fixtures/decisions.json",
        "//crates/agent-protocol:fixtures/event.json",
        "//crates/agent-protocol:fixtures/hello.json",
        "//crates/agent-protocol:fixtures/integer-tokens.json",
        "//crates/agent-protocol:fixtures/nesting-depth.json",
        "//crates/agent-protocol:fixtures/opaque-objects.json",
        "//crates/agent-protocol:fixtures/receipt.json",
        "//crates/agent-protocol:fixtures/sdk-errors.json",
        "//crates/agent-protocol:fixtures/start.json",
    ],
)

# Future real Rust controller tests consume these executable artifacts, not main.ts's JSONline probe.
js_run_binary(
    name = "persistent_bundle",
    tool = ":bundle_tool",
    srcs = [":host_lib", "persistent-main.ts"],
    outs = ["persistent.cjs", "persistent.meta.json"],
    args = ["$(location persistent-main.ts)", "$(location persistent.cjs)", "$(location persistent.meta.json)"],
)
js_run_binary(
    name = "persistent_fixture_bundle",
    tool = ":bundle_tool",
    srcs = [":host_lib", "persistent-fixture-main.ts"],
    outs = ["persistent-fixture.cjs", "persistent-fixture.meta.json"],
    args = ["$(location persistent-fixture-main.ts)", "$(location persistent-fixture.cjs)", "$(location persistent-fixture.meta.json)"],
)
exports_files(["persistent-fake-claude.py", "descendant-fake-claude.py", "orchestrator-fake-claude.py"])
