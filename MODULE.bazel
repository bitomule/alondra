module(name = "alondra", version = "0.1.0")

bazel_dep(name = "apple_support", version = "2.8.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_apple", version = "5.0.0-rc3", repo_name = "build_bazel_rules_apple")
bazel_dep(name = "rules_swift", version = "4.0.0-rc3", repo_name = "build_bazel_rules_swift")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_swift_package_manager", version = "1.23.0")

# simpool routes `ios_test_runner` through a shared, flock-guarded simulator pool, so concurrent
# test actions never share one fixed-name simulator.
bazel_dep(name = "simpool", version = "0.3.1")
git_override(
    module_name = "simpool",
    remote = "https://github.com/bitomule/simpool.git",
    commit = "6cc9ab608bff593eb558c454663361506855cdbb",
    strip_prefix = "bazel",
)

swift_deps = use_extension("@rules_swift_package_manager//:extensions.bzl", "swift_deps")
swift_deps.from_package(
    declare_swift_deps_info = True,
    resolved = "//:Package.resolved",
    swift = "//:Package.swift",
)
use_repo(
    swift_deps,
    "swift_deps_info",
    "swift_package",
    "swiftpkg_highlightswift",
    "swiftpkg_swift_composable_architecture",
    "swiftpkg_swift_collections",
    "swiftpkg_swift_snapshot_testing",
    "swiftpkg_swift_issue_reporting",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(edition = "2024")
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
        "//crates/core:Cargo.toml",
        "//crates/foundation:Cargo.toml",
        "//crates/domain:Cargo.toml",
        "//crates/agent-protocol:Cargo.toml",
        "//crates/alondrad:Cargo.toml",
        "//crates/e2e:Cargo.toml",
        "//crates/alondra:Cargo.toml",
        "//crates/relay:Cargo.toml",
    ],
)
use_repo(crate, "crates")

alondra_signing = use_repo_rule("//signing:repo.bzl", "alondra_signing")

alondra_signing(name = "alondra_signing")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# IrohLib: iroh's Swift bindings. The xcframework and the generated Swift file come from the
# same iroh-ffi release; bump both together and test the apps on a device.
http_archive(
    name = "iroh_xcframework",
    build_file_content = """
load("@build_bazel_rules_apple//apple:apple.bzl", "apple_static_xcframework_import")

apple_static_xcframework_import(
    name = "Iroh",
    xcframework_imports = glob(["Iroh.xcframework/**"]),
    sdk_frameworks = ["SystemConfiguration", "Network"],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "ad46dadf09f9224157512992923562931ed60f252414230d50893a4d515c5776",
    url = "https://github.com/n0-computer/iroh-ffi/releases/download/v1.1.0/IrohLib.xcframework.zip",
)

http_file(
    name = "irohlib_swift",
    downloaded_file_path = "IrohLib.swift",
    sha256 = "681abdbd903ad86848571dbfbbf5540733da541584edae6592e0cabef3c3b856",
    url = "https://raw.githubusercontent.com/n0-computer/iroh-ffi/v1.1.0/IrohLib/Sources/IrohLib/IrohLib.swift",
)
