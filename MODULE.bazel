module(name = "alondra", version = "0.1.0")

bazel_dep(name = "apple_support", version = "2.8.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_apple", version = "5.0.0-rc3", repo_name = "build_bazel_rules_apple")
bazel_dep(name = "rules_swift", version = "4.0.1", repo_name = "build_bazel_rules_swift")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_swift_package_manager", version = "1.23.0")
bazel_dep(name = "sourcekit_bazel_bsp", version = "0.8.3", dev_dependency = True)

# Developer tools, fetched by Bazel and put on PATH by //bazel/env:bazel_env (bazel/env/README.md):
# musts, and simpool with the runner that routes `ios_test_runner` through its shared, flock-guarded
# simulator pool, so concurrent test actions never share one fixed-name simulator. Their pins live
# in bazel/env/tools.bzl.
bazel_dep(name = "bazel_env.bzl", version = "0.10.0", dev_dependency = True)

developer_tools = use_extension("//bazel/env:tools.bzl", "developer_tools")
use_repo(developer_tools, "musts", "simpool", "simpool_bin", "simpool_env")

swift_deps = use_extension("@rules_swift_package_manager//:extensions.bzl", "swift_deps")
swift_deps.from_package(
    declare_swift_deps_info = True,
    resolved = "//:Package.resolved",
    swift = "//:Package.swift",
)
use_repo(
    swift_deps,
    "swift_deps_info",
    "swift_package",
    "swiftpkg_highlightswift",
    "swiftpkg_swift_composable_architecture",
    "swiftpkg_swift_collections",
    "swiftpkg_swift_snapshot_testing",
    "swiftpkg_swift_issue_reporting",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
# rustc strips nothing itself: it runs rust-objcopy over the linked file and only warns when that
# fails, so a full disk left binaries cut to their last bytes as successful outputs
# (bazel/rules/rust_link_test.bzl). The linker leaves the debug information out, and fails loudly.
# These come after the `--codegen=strip=` rules_rust passes, and the last one wins; the `strip_level`
# of this tag never reaches the toolchain in this version of rules_rust.
LINKER_STRIPS = [
    "-Cstrip=none",
    "-Clink-arg=-Wl,-S",
]

rust.toolchain(
    edition = "2024",
    extra_exec_rustc_flags = LINKER_STRIPS,
    extra_rustc_flags = LINKER_STRIPS,
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
        "//crates/core:Cargo.toml",
        "//crates/domain-model:Cargo.toml",
        "//crates/domain-rules:Cargo.toml",
        "//crates/view-model:Cargo.toml",
        "//crates/views:Cargo.toml",
        "//crates/foundation:Cargo.toml",
        "//crates/spec-engine:Cargo.toml",
        "//crates/domain:Cargo.toml",
        "//crates/agent-protocol:Cargo.toml",
        "//crates/antigravity-protocol:Cargo.toml",
        "//crates/codex-protocol:Cargo.toml",
        "//crates/store:Cargo.toml",
        "//crates/provider-contract:Cargo.toml",
        "//crates/agent-application:Cargo.toml",
        "//crates/process-group:Cargo.toml",
        "//crates/agent-runtime:Cargo.toml",
        "//crates/provider-claude:Cargo.toml",
        "//crates/provider-antigravity:Cargo.toml",
        "//crates/provider-codex:Cargo.toml",
        "//crates/daemon-support:Cargo.toml",
        "//crates/system:Cargo.toml",
        "//crates/host:Cargo.toml",
        "//crates/daemon-engine:Cargo.toml",
        "//crates/daemon-engine-model:Cargo.toml",
        "//crates/store-sqlite:Cargo.toml",
        "//crates/engine-kernel:Cargo.toml",
        "//crates/engine-github:Cargo.toml",
        "//crates/engine-live:Cargo.toml",
        "//crates/engine-mcp:Cargo.toml",
        "//crates/engine-worktrees:Cargo.toml",
        "//crates/engine-orchestrator:Cargo.toml",
        "//crates/engine-admission:Cargo.toml",
        "//crates/engine-sdk:Cargo.toml",
        "//crates/alondrad:Cargo.toml",
        "//crates/e2e:Cargo.toml",
        "//crates/alondra:Cargo.toml",
        "//crates/relay:Cargo.toml",
    ],
)

# SQLite keeps memory statistics nobody reads, behind one process-wide mutex that every allocation
# takes: with many connections at once (the daemon's writer and readers, hundreds of parallel
# tests) the threads queue on it. SQLite's recommended options turn the statistics off.
crate.annotation(
    build_script_env = {"LIBSQLITE3_FLAGS": "-DSQLITE_DEFAULT_MEMSTATUS=0"},
    crate = "libsqlite3-sys",
)
use_repo(crate, "crates")

alondra_signing = use_repo_rule("//signing:repo.bzl", "alondra_signing")

alondra_signing(name = "alondra_signing")

private_literals = use_repo_rule("//tools:private_literals.bzl", "private_literals")

private_literals(name = "private_literals")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# IrohLib: iroh's Swift bindings. The xcframework and the generated Swift file come from the
# same iroh-ffi release; bump both together and test the apps on a device.
http_archive(
    name = "iroh_xcframework",
    build_file_content = """
load("@build_bazel_rules_apple//apple:apple.bzl", "apple_static_xcframework_import")

apple_static_xcframework_import(
    name = "Iroh",
    xcframework_imports = glob(["Iroh.xcframework/**"]),
    sdk_frameworks = ["SystemConfiguration", "Network"],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "ad46dadf09f9224157512992923562931ed60f252414230d50893a4d515c5776",
    url = "https://github.com/n0-computer/iroh-ffi/releases/download/v1.1.0/IrohLib.xcframework.zip",
)

http_file(
    name = "irohlib_swift",
    downloaded_file_path = "IrohLib.swift",
    sha256 = "681abdbd903ad86848571dbfbbf5540733da541584edae6592e0cabef3c3b856",
    url = "https://raw.githubusercontent.com/n0-computer/iroh-ffi/v1.1.0/IrohLib/Sources/IrohLib/IrohLib.swift",
)

# The SDK host is isolated from Rust targets and never uses a user's JS installation.
bazel_dep(name = "aspect_rules_js", version = "3.5.1")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "rules_nodejs", version = "6.7.6")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.19.0")
use_repo(node, "nodejs_toolchains")
register_toolchains("@nodejs_toolchains//:all")

host_pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
host_pnpm.pnpm(
    name = "host_pnpm",
    pnpm_version = "11.25.0",
    pnpm_version_integrity = "sha512-XN6SW08HX3Jetx+64YpC/+eEUkeJ8ZthxzHLhyHsKKruFg4BqNWvT+2ypCzb8wDv4j2zVrDUoXtNY+EfirfJVg==",
)
use_repo(host_pnpm, "host_pnpm")

host_npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
host_npm.npm_translate_lock(
    name = "host_npm",
    pnpm_lock = "//agent-host:pnpm-lock.yaml",
    no_optional = True,
    run_lifecycle_hooks = False,
    update_pnpm_lock = False,
    use_home_npmrc = False,
    use_pnpm = "@host_pnpm//:package/bin/pnpm.cjs",
)
use_repo(host_npm, "host_npm")

typescript = use_extension("@aspect_rules_ts//ts:extensions.bzl", "typescript")
typescript.deps(version = "5.9.3", integrity = "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==")
use_repo(typescript, "npm_typescript")

# Evaluated lazily only by the manual native harness; the SDK host keeps no_optional=True.
native_test_archive = use_repo_rule("//tests/native/claude:artifact.bzl", "native_test_archive")
native_test_archive(name = "claude_native_test")
