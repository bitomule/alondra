load("//bazel/rules:rust.bzl", "rust_library")
load("//bazel/rules:rust_test.bzl", "incremental_rust_test")
load("//bazel/rules:tree.bzl", "repo_tree")
load(":rust_incremental_test.bzl", "compiles_from_scratch_test", "compiles_incrementally_test")

rust_library(
    name = "fixture",
    testonly = True,
    srcs = ["testdata/lib.rs"],
    crate_root = "testdata/lib.rs",
    edition = "2024",
    tags = ["manual"],
)

compiles_incrementally_test(
    name = "compiles_incrementally_test",
    size = "small",
    target_under_test = ":fixture",
)

compiles_from_scratch_test(
    name = "compiles_from_scratch_test",
    size = "small",
    target_under_test = ":fixture",
)

incremental_rust_test(
    name = "test_fixture",
    size = "small",
    srcs = ["testdata/lib.rs"],
    crate_root = "testdata/lib.rs",
    edition = "2024",
    tags = ["manual"],
)

compiles_incrementally_test(
    name = "test_compiles_incrementally_test",
    size = "small",
    target_under_test = ":test_fixture",
)

compiles_from_scratch_test(
    name = "test_compiles_from_scratch_test",
    size = "small",
    target_under_test = ":test_fixture",
)

repo_tree()
