load("//tools/layers:crates.bzl", "application_crate")
load("//bazel/rules:tree.bzl", "repo_tree")
load("@crates//:defs.bzl", "all_crate_deps")
load("//bazel/rules:rust_test.bzl", "low_opt_rust_test")
load("@rules_rust//rust:defs.bzl", "rust_test")
load("//bazel/rules:rust_sources.bzl", "production_sources")
load("//bazel/rules:rust.bzl", "rust_library")
load("//bazel/rules:rust_inputs_test.bzl", "rust_inputs_test")

VIEWS_TEST_ONLY = ["src/domain_fixtures.rs"]

VIEWS_DEPS = all_crate_deps(normal = True) + [
    "//crates/core:alondra_core",
    "//crates/domain:domain",
    "//crates/domain-model:domain_model",
    "//crates/engine-ports:engine_ports",
    "//crates/foundation:foundation",
    "//crates/view-model:view_model",
]

# The screens: every view and card the clients render, built from the domain and the live snapshot.
application_crate(
    name = "views",
    srcs = production_sources(test_only = VIEWS_TEST_ONLY),
    crate_name = "alondra_views",
    version = "0.1.0",
    test_visibility = ["//crates/cli:__pkg__", "//crates/cli-tui:__pkg__", "//crates/daemon-server:__pkg__"],
    deps = VIEWS_DEPS,
)

low_opt_rust_test(
    name = "views_test",
    timeout = "moderate",
    compile_data = ["//crates/view-model:report_sources", "//fixtures/views:all", "//fixtures/views:cards", "//fixtures/views:metrics", "//fixtures/accounts:recorded-rows.json"],
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    crate_name = "alondra_views",
    crate_root = "src/lib.rs",
    deps = ["//crates/domain-rules:domain_rules"] + VIEWS_DEPS + all_crate_deps(normal_dev = True),
    edition = "2024",
    version = "0.1.0",
)

low_opt_rust_test(
    name = "foundation_contract_test",
    size = "small",
    crate_root = "tests/foundation.rs",
    srcs = ["tests/foundation.rs"],
    edition = "2024",
    version = "0.1.0",
    deps = [
        ":views",
        "//crates/core:alondra_core",
        "//crates/domain-model:domain_model",
        "//crates/foundation:foundation",
        "@crates//:serde_json",
    ],
)

# The domain and the screens never read what hooks deduced of a node: that deduction is kept only
# for the `claude --bg` nodes still handed over to the Agent SDK.
low_opt_rust_test(
    name = "hook_deduction_boundary_test",
    size = "small",
    crate_root = "tests/hook_deduction_boundary.rs",
    srcs = ["tests/hook_deduction_boundary.rs"],
    data = [":report_sources", "//crates/domain-model:report_sources", "//crates/domain-rules:report_sources", "//crates/view-model:report_sources"],
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates"},
)

# What the screens show after the domain runs its commands, for every client.
low_opt_rust_test(
    name = "domain_screens_test",
    size = "small",
    crate_root = "tests/domain_screens/main.rs",
    srcs = glob(["tests/domain_screens/*.rs"]),
    edition = "2024",
    deps = ["//crates/domain-rules:domain_rules"] + [
        ":views",
        "//crates/core:alondra_core",
        "//crates/domain:domain",
        "//crates/domain-model:domain_model",
        "//crates/foundation:foundation",
    ] + all_crate_deps(normal = True, normal_dev = True),
)

# The domain the view budgets measure and every JSON they write or read, apart from them: its code
# is generated incrementally here instead of from scratch in their crate on every edit below it.
rust_library(
    name = "budget_fixture",
    testonly = True,
    srcs = ["tests/views_budget_fixture.rs"],
    crate_name = "alondra_views_budget_fixture",
    crate_root = "tests/views_budget_fixture.rs",
    edition = "2024",
    version = "0.1.0",
    deps = ["//crates/domain-rules:domain_rules"] + [
        ":views",
        "//crates/core:alondra_core",
        "//crates/domain-model:domain_model",
        "@crates//:serde_json",
    ],
)

# Every family of views renders a real-size domain within its budget, with alondra_views built as
# the daemon links it: without the checks only its own unit tests compile in.
# It stays at the build's opt-level: the budget counts the instructions of that code. It compiles
# from scratch on every edit below it, so it holds only what it measures: `budget_inputs_test` keeps
# the fixture's source and the JSON library out of its compile. The count does not depend on the
# load, but the run still slows down when the Mac's queue is full: the limit is "moderate" (300 s).
rust_test(
    name = "views_budget_test",
    size = "small",
    timeout = "moderate",
    crate_root = "tests/views_budget.rs",
    srcs = ["tests/views_budget.rs", "tests/views_budget_meter.rs"],
    # The budgets count the whole process's instructions: one test at a time.
    args = ["--test-threads=1"],
    edition = "2024",
    version = "0.1.0",
    deps = ["//crates/domain-rules:domain_rules"] + [
        ":budget_fixture",
        ":views",
        "//crates/core:alondra_core",
        "//crates/domain:domain",
        "//crates/domain-model:domain_model",
        "@crates//:libc",
    ],
)

rust_inputs_test(
    name = "budget_inputs_test",
    size = "small",
    forbidden_externs = ["serde", "serde_json"],
    required_sources = ["crates/views/tests/views_budget.rs"],
    source_dir = "crates/views/src/",
    target_under_test = ":views_budget_test",
    test_only_sources = ["crates/views/tests/views_budget_fixture.rs"],
    test_sources = False,
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

# The library compiles only production sources: a test file among its inputs would rebuild every
# crate above it whenever the test changes.
rust_inputs_test(
    name = "production_inputs_test",
    size = "small",
    required_sources = ["crates/views/src/lib.rs", "crates/views/src/task_state.rs"],
    source_dir = "crates/views/src/",
    target_under_test = ":views",
    test_only_sources = ["crates/views/src/tests.rs", "crates/views/src/domain_fixtures.rs", "crates/test_support.rs"],
    test_sources = False,
)

# The crate's production sources: the crash report's log catalog reads them, and fails on a test
# file among them.
filegroup(
    name = "report_sources",
    srcs = production_sources(test_only = VIEWS_TEST_ONLY),
    visibility = ["//crates/alondra:__pkg__", "//crates/cli-report:__pkg__", "//crates/views:__pkg__"],
)

repo_tree()
