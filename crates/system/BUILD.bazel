load("//tools/bazel:crates.bzl", "adapter_out_crate")
load("//tools:tree.bzl", "repo_tree")
load("//tools:rust_inputs_test.bzl", "rust_inputs_test")
load("//tools:rust_test.bzl", "low_opt_rust_test")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:version.bzl", "VERSION")
load("//tools:rust_sources.bzl", "production_sources")

# The Mac as the engine reaches it through the `Worktrees` and `Disk` ports: git, the task
# worktrees and the disks. Only the roots link it, so editing it rebuilds this crate and their link.
WORKSPACE_DEPS = [
    "//crates/core:alondra_core",
    "//crates/domain-rules:domain_rules",
    "//crates/engine-ports:engine_ports",
    "//crates/foundation:foundation",
]

adapter_out_crate(
    name = "system",
    srcs = production_sources(),
    crate_name = "alondra_system",
    version = VERSION,
    deps = all_crate_deps(normal = True) + WORKSPACE_DEPS,
)

# The tests of the engine's crates make worktrees with its `worktree::testing` helpers.
rust_library(
    name = "system_test_hooks",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["test-hooks"],
    crate_name = "alondra_system",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = VERSION,
    visibility = ["//crates:__subpackages__", "//tools/sandbox:__pkg__"],
    deps = all_crate_deps(normal = True) + WORKSPACE_DEPS,
)

low_opt_rust_test(
    name = "system_test",
    timeout = "moderate",
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    crate_name = "alondra_system",
    crate_root = "src/lib.rs",
    edition = "2024",
    # Bazel test-setup resolves a relative HOME to this test's TEST_TMPDIR.
    env = {"HOME": "."},
    version = VERSION,
    deps = all_crate_deps(normal = True, normal_dev = True) + WORKSPACE_DEPS,
)

rust_inputs_test(
    name = "production_inputs_test",
    size = "small",
    required_sources = ["crates/system/src/lib.rs"],
    source_dir = "crates/system/src/",
    target_under_test = ":system",
    test_only_sources = [],
    test_sources = False,
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

# The crate's production sources: the crash report's log catalog reads them, and fails on a test
# file among them; alondrad's lock policy test reads them too.
filegroup(
    name = "report_sources",
    srcs = production_sources(),
    visibility = ["//crates/alondra:__pkg__", "//crates/alondrad:__pkg__", "//crates/cli-report:__pkg__"],
)

repo_tree()
