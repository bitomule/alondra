load("//tools/layers:crates.bzl", "root_binary")
load("//bazel/rules:tree.bzl", "repo_tree")
load("//bazel/rules:rust_test.bzl", "low_opt_rust_test")
load("@crates//:defs.bzl", "all_crate_deps")
load("//bazel/rules:rust.bzl", "rust_binary", "rust_library")
load("//bazel/rules:rust_inputs_test.bzl", "rust_inputs_test")
load("//bazel/rules:rust_link_test.bzl", "rust_link_test")
load("//:version.bzl", "VERSION")

DEPS = all_crate_deps(normal = True) + [
    "//crates/agent-protocol:agent_protocol",
    "//crates/agent-runtime:agent_runtime",
    "//crates/alondrad:alondrad_lib",
    "//crates/provider-claude:claude_host_model",
    "//crates/core:alondra_core", "//crates/domain-model:domain_model", "//crates/domain-rules:domain_rules", "//crates/view-model:view_model", "//crates/views:views",
    "//crates/daemon-engine:daemon_engine",
    "//crates/daemon-server:daemon_server",
    "//crates/daemon-support:daemon_support",
    "//crates/engine-admission:engine_admission",
    "//crates/engine-doubles:engine_doubles",
    "//crates/engine-kernel:engine_kernel",
    "//crates/engine-ports:engine_ports",
    "//crates/store-sqlite:store_sqlite",
    "//crates/engine-sdk:engine_sdk",
    "//crates/engine-orchestrator:engine_orchestrator",
    "//crates/scenarios-transcript:scenarios_transcript",
]

# The runner: the daemon assembled over fake edges, the format of a scenario and its checkpoints.
rust_library(
    name = "scenarios",
    testonly = True,
    srcs = glob(["src/**/*.rs"], exclude = ["src/bin/*.rs", "src/**/*_tests.rs"]),
    crate_name = "alondra_scenarios",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_flags = ["-Copt-level=0"],
    version = VERSION,
    visibility = ["//visibility:private"],
    deps = DEPS,
)

# The process a scenario's Claude host runs as: it listens on the host's socket and holds its lock,
# and relays what the daemon sends to the host the scenario plays.
rust_binary(
    name = "host_relay",
    testonly = True,
    srcs = ["src/bin/host_relay.rs"],
    crate_root = "src/bin/host_relay.rs",
    edition = "2024",
    version = VERSION,
    deps = ["@crates//:libc"],
)

RELAY_ENV = {"SCENARIO_HOST_RELAY": "$(rootpath :host_relay)"}

# The tests of the harness itself: it sees a failure with its own error, runs a scenario twice to
# the same bytes and lets nothing out to a real service.
low_opt_rust_test(
    name = "scenarios_harness_test",
    size = "medium",
    srcs = glob(["tests/harness/*.rs"]) + ["//crates:test_support.rs"],
    crate_root = "tests/harness/main.rs",
    data = [":host_relay"],
    edition = "2024",
    env = {"HOME": ".", "TEST_EXECS": "$(rootpath :host_relay) /bin/sleep /usr/bin/id", "TZ": "UTC"} | RELAY_ENV,
    version = VERSION,
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        ":scenarios",
        "//crates/agent-protocol:agent_protocol",
        "//crates/agent-runtime:agent_runtime",
        "//crates/core:alondra_core",
        "//crates/daemon-engine:daemon_engine",
        "//crates/engine-ports:engine_ports",
        "//crates/scenarios-transcript:scenarios_transcript",
    ],
)

# The harness's tests link the library: with one of its sources among their own they would compile
# it a second time, from scratch, on every edit of a crate below it.
rust_inputs_test(
    name = "harness_inputs_test",
    size = "small",
    fixture_sources = ["crates/test_support.rs"],
    required_sources = ["crates/scenarios/tests/harness/main.rs"],
    source_dir = "crates/scenarios/src/",
    target_under_test = ":scenarios_harness_test",
    test_only_sources = ["crates/scenarios/" + source for source in glob(["src/**/*.rs"])],
    test_sources = False,
)

# Every case of `cases/`, one after another, each with its name. Bazel's rust_test always runs the
# libtest harness, so the runner is a binary and `scenarios_test` runs it: `--test_arg=<name>` runs
# the cases whose name contains it, and the shards split the rest.
rust_binary(
    name = "scenarios_runner",
    testonly = True,
    srcs = ["tests/scenarios_test.rs"],
    crate_root = "tests/scenarios_test.rs",
    edition = "2024",
    rustc_env = {"SCENARIO_CASES": "crates/scenarios/cases"},
    rustc_flags = ["-Copt-level=0"],
    version = VERSION,
    deps = DEPS + [":scenarios"],
)

# A runner left broken by a full disk failed every shard (bazel/rules/rust_link_test.bzl).
rust_link_test(
    name = "runner_link_test",
    size = "small",
    target_under_test = ":scenarios_runner",
)

# Every edit of any crate relinks the runner and reruns this test, so its cases run in shards side
# by side, one case each: the edit loop waits for the longest case. The runner fails when the
# count differs from the number of cases.
sh_test(
    name = "scenarios_test",
    size = "medium",
    shard_count = 41,
    srcs = ["run_scenarios.sh"],
    data = [":host_relay", ":scenarios_runner"] + glob(["cases/**"]),
    env = {"HOME": ".", "TEST_EXECS": "own-sandbox", "TZ": "UTC"} | RELAY_ENV,
)

# `bazel run //crates/scenarios:accept -- <case>` writes the checkpoints of the case into the tree.
rust_binary(
    name = "accept",
    testonly = True,
    srcs = ["src/bin/accept.rs"],
    crate_root = "src/bin/accept.rs",
    data = [":host_relay"] + glob(["cases/**"]),
    edition = "2024",
    # The daemon decides what only tests change by `BAZEL_TEST`, which `bazel run` does not set: a
    # case is accepted as `scenarios_test` plays it.
    env = RELAY_ENV | {"BAZEL_TEST": "1"},
    rustc_flags = ["-Copt-level=0"],
    version = VERSION,
    deps = DEPS + [":scenarios"],
)

# `bazel run //crates/scenarios:ablate -- <case> --revert <files>` shows the case failing without
# the fix and passing with it.
rust_binary(
    name = "ablate",
    testonly = True,
    srcs = ["src/bin/ablate.rs"],
    crate_root = "src/bin/ablate.rs",
    edition = "2024",
    version = VERSION,
    deps = all_crate_deps(normal = True),
)

# Every transcript the repository keeps, wherever it is and whatever its name, is anonymized. It
# reads the private literals through @private_literals, a copy of the file ALONDRA_PRIVATE_LITERALS
# names that Bazel watches, so it is cached until the list or a transcript changes; without that list
# it fails, unless the variable says `none` (the public CI).
low_opt_rust_test(
    name = "transcript_guard_test",
    size = "small",
    srcs = ["tests/transcript_guard.rs"],
    crate_root = "tests/transcript_guard.rs",
    data = [
        "//:tree",
        "@private_literals//:literals.txt",
    ],
    edition = "2024",
    env = {"ALONDRA_PRIVATE_LITERALS": "$(rootpath @private_literals//:literals.txt)"},
    deps = ["//crates/scenarios-transcript:scenarios_transcript"],
)

# `bazel run //crates/scenarios:capture -- --task <id> --out .scratch/<name>.ndjson` anonymizes the
# frames the hosts of a task, Claude's or Codex's, wrote on this Mac into transcripts for a reviewer
# to read, in the worktree's `.scratch`.
root_binary(
    name = "capture",
    srcs = ["src/bin/capture.rs"],
    crate_root = "src/bin/capture.rs",
    version = VERSION,
    deps = all_crate_deps(normal = True) + ["//crates/scenarios-transcript:scenarios_transcript"],
)

# `bazel run //crates/scenarios:from_report -- <package> --name <case> --out .scratch/<case>` drafts a
# scenario from an `alondra report` package and the list of what a person completes, after the
# report's own final check and the public data guard read it.
rust_binary(
    name = "from_report",
    testonly = True,
    srcs = ["src/bin/from_report.rs"],
    crate_root = "src/bin/from_report.rs",
    edition = "2024",
    rustc_flags = ["-Copt-level=0"],
    version = VERSION,
    deps = DEPS + [":scenarios", "//crates/alondra:alondra_lib"],
)

low_opt_rust_test(
    name = "from_report_bin_test",
    env = {"TEST_EXECS": "/usr/bin/defaults /usr/bin/python3"},
    size = "small",
    srcs = ["src/bin/from_report.rs", "src/bin/from_report_tests.rs"],
    crate_root = "src/bin/from_report.rs",
    data = ["//tools:public_data_guard.py"],
    edition = "2024",
    version = VERSION,
    deps = DEPS + [":scenarios", "//crates/alondra:alondra_lib"],
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

repo_tree()
