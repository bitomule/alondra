load("@crates//:defs.bzl", "all_crate_deps")
load("//tools:rust_test.bzl", "low_opt_rust_test")
load("@rules_rust//rust:defs.bzl", "rust_binary")

rust_binary(
    name = "alondra-relay",
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    compile_data = glob(["migrations/*.sql"]),
    crate_name = "alondra_relay",
    edition = "2024",
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + ["//crates/e2e:alondra_e2e"],
)

low_opt_rust_test(
    name = "alondra_relay_test",
    visibility = ["//apple/Data/Feed:__pkg__"],
    compile_data = glob(["tests/fixtures/**"]) + ["//fixtures/push"],
    crate = ":alondra-relay",
    edition = "2024",
    deps = all_crate_deps(normal_dev = True),
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])
