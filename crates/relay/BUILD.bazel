load("@crates//:defs.bzl", "all_crate_deps", "crate_deps")
load("//tools:rust_test.bzl", "low_opt_rust_test")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")

rust_library(
    name = "alondra_relay_lib",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]) + ["//crates:test_support.rs"],
    compile_data = glob(["migrations/*.sql"]),
    crate_name = "alondra_relay",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + ["//crates/e2e:alondra_e2e"],
)

rust_binary(
    name = "alondra-relay",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    edition = "2024",
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = crate_deps(["anyhow", "tokio"]) + [":alondra_relay_lib"],
)

low_opt_rust_test(
    name = "alondra_relay_test",
    visibility = ["//apple/Data/Feed:__pkg__"],
    compile_data = glob(["tests/fixtures/**"]) + ["//fixtures/push", "//:web/react-router.config.ts"],
    crate = ":alondra_relay_lib",
    edition = "2024",
    deps = all_crate_deps(normal_dev = True),
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])
