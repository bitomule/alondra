load("@crates//:defs.bzl", "all_crate_deps", "crate_deps")
load("//tools:rust_test.bzl", "low_opt_rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load("//:version.bzl", "VERSION")

REPORT_SOURCES = [
    "//crates/alondrad:report_sources",
    "//crates/core:report_sources",
    "//crates/daemon-engine:report_sources",
    "//crates/daemon-support:report_sources",
    "//crates/domain:report_sources",
    "//crates/foundation:report_sources",
    "//crates/store:report_sources",
    "//crates/agent-application:report_sources",
    "//crates/agent-protocol:report_sources",
    "//crates/agent-runtime:report_sources",
    "//crates/provider-claude:report_sources",
    "//crates/provider-contract:report_sources",
    "//crates/process-group:report_sources",
]

# The crash report keeps a line of alondrad.log only as the text of a log! call in the code: this
# writes the catalog of those calls and the words of the code (`src/report/extract.rs`).
cargo_build_script(
    name = "log_catalog",
    srcs = ["build.rs", "src/report/extract.rs"],
    crate_root = "build.rs",
    data = REPORT_SOURCES,
    edition = "2024",
)

rust_library(
    name = "alondra_lib",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    compile_data = ["//launchd:alondra.plist.in"],
    crate_name = "alondra",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = VERSION,
    deps = all_crate_deps(normal = True) + [":log_catalog", "//crates/core:alondra_core", "//crates/e2e:alondra_e2e"],
)

rust_binary(
    name = "alondra",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    edition = "2024",
    version = VERSION,
    visibility = ["//visibility:public"],
    deps = crate_deps(["anyhow"]) + [":alondra_lib"],
)

low_opt_rust_test(
    name = "alondra_test",
    size = "small",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]) + ["//crates:test_support.rs"],
    crate_name = "alondra",
    crate_root = "src/lib.rs",
    compile_data = [
        "//fixtures/diffs",
        "//launchd:alondra.plist.in",
        "//:plugin/skills/alondra/SKILL.md",
        "//:plugin-orchestrator/skills/alondra-orchestrator/SKILL.md",
    ],
    deps = all_crate_deps(normal = True, normal_dev = True) + [":log_catalog", "//crates/core:alondra_core", "//crates/e2e:alondra_e2e"],
    data = REPORT_SOURCES + ["//fixtures/report", "//fixtures/cli", "//fixtures/client-v2", "//fixtures/markdown", "//fixtures/views:all", "//fixtures/views:cards", "//fixtures/views:newer_daemon", "//fixtures/views:metrics", "//fixtures/domain-v2:text-completion.commands.json"],
    edition = "2024",
    version = VERSION,
)

# Cargo integration tests. Paths are runfiles-relative: Bazel runs tests from the
# workspace root inside runfiles.
[low_opt_rust_test(
    name = name + "_test",
    timeout = "moderate",
    srcs = ["tests/" + name + ".rs", "//crates:test_support.rs"],
    crate_root = "tests/" + name + ".rs",
    data = [":alondra"],
    edition = "2024",
    rustc_env = {"CARGO_BIN_EXE_alondra": "$(rootpath :alondra)"},
    deps = all_crate_deps(normal = True, normal_dev = True),
) for name in [
    "cli_api",
    "doctor_json",
    "domain_mcp",
    "hook_transport",
    "version",
]]

[low_opt_rust_test(
    name = name + "_test",
    timeout = "moderate",
    srcs = ["tests/" + name + ".rs"],
    data = glob(["src/**/*.rs"]),
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/alondra"},
    deps = all_crate_deps(normal = True, normal_dev = True),
) for name in [
    "english_quotes",
    "no_literal_texts",
    "no_sleep_wording",
]]

# Reads the checkout itself through the Makefile's runfiles link, so it is never cached.
low_opt_rust_test(
    name = "no_old_commands_test",
    size = "small",
    srcs = ["tests/no_old_commands.rs"],
    data = ["//:Makefile"],
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/alondra"},
    tags = ["external", "local"],
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])
