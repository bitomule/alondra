load("//tools/bazel:crates.bzl", "root_binary", "root_library")
load("//tools:tree.bzl", "repo_tree")
load("@crates//:defs.bzl", "all_crate_deps", "crate_deps")
load("//tools:rust_test.bzl", "low_opt_rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//tools:rust_sources.bzl", "production_sources")
load("//:version.bzl", "VERSION")
load("//tools:rust_inputs_test.bzl", "rust_inputs_test")

# Each crate's part of the crash report's log catalog, from its production sources, in the
# catalog's order: `--log` reads its log calls, `--words` the words of its code
# (`src/report/extract.rs`). The report's own schema adds the values it expects in the state it
# reads, among them phases only older releases stored.
CATALOG_FRAGMENTS = [
    ("alondrad", "//crates/alondrad:report_sources", "--log --words"),
    ("alondrad_launcher", "//crates/alondrad:launcher_report_sources", "--log"),
    ("daemon_support", "//crates/daemon-support:report_sources", "--log --words"),
    ("daemon_engine", "//crates/daemon-engine:report_sources", "--log --words"),
    ("daemon_engine_model", "//crates/daemon-engine-model:report_sources", "--log --words"),
    ("daemon_engine_store", "//crates/daemon-engine-store:report_sources", "--log --words"),
    ("daemon_engine_machine", "//crates/daemon-engine-machine:report_sources", "--log --words"),
    ("engine_admission", "//crates/engine-admission:report_sources", "--log --words"),
    ("engine_github", "//crates/engine-github:report_sources", "--log --words"),
    ("engine_live", "//crates/engine-live:report_sources", "--log --words"),
    ("engine_mcp", "//crates/engine-mcp:report_sources", "--log --words"),
    ("engine_worktrees", "//crates/engine-worktrees:report_sources", "--log --words"),
    ("engine_kernel", "//crates/engine-kernel:report_sources", "--log --words"),
    ("engine_ports", "//crates/engine-ports:report_sources", "--words"),
    ("engine_orchestrator", "//crates/engine-orchestrator:report_sources", "--log --words"),
    ("engine_sdk", "//crates/engine-sdk:report_sources", "--log --words"),
    ("core", "//crates/core:report_sources", "--log --words"),
    ("domain_rules", "//crates/domain-rules:report_sources", "--log --words"),
    ("view_model", "//crates/view-model:report_sources", "--log --words"),
    ("views", "//crates/views:report_sources", "--log --words"),
    ("provider_claude", "//crates/provider-claude:report_sources", "--log --words"),
    ("domain", "//crates/domain:report_sources", "--words"),
    ("foundation", "//crates/foundation:report_sources", "--words"),
    ("store", "//crates/store:report_sources", "--words"),
    ("agent_application", "//crates/agent-application:report_sources", "--words"),
    ("agent_protocol", "//crates/agent-protocol:report_sources", "--words"),
    ("agent_runtime", "//crates/agent-runtime:report_sources", "--words"),
    ("provider_contract", "//crates/provider-contract:report_sources", "--words"),
    ("process_group", "//crates/process-group:report_sources", "--words"),
    ("report_schema", "src/report/check/schema.rs", "--words"),
]

REPORT_SOURCES = [sources for _, sources, _ in CATALOG_FRAGMENTS if sources.startswith("//")]

# The crash report keeps a line of alondrad.log only as the text of a log! call in the code: this
# writes the catalog of those calls and the words of the code. Each crate's part comes from its
# production sources in its own action, which fails on a test file, and the parts are joined in
# another: a test never reaches the CLI, and a change that leaves every part the same never
# recompiles it, because a build script's data are compile inputs of the crate it builds for.
root_binary(
    name = "log_catalog_extract",
    srcs = ["log_catalog.rs", "src/report/extract.rs"],
    crate_root = "log_catalog.rs",
)

[genrule(
    name = "log_catalog_" + name,
    srcs = [sources],
    outs = ["log_catalog/" + name + ".catalog", "log_catalog/" + name + ".words"],
    cmd = "$(execpath :log_catalog_extract) fragment $(OUTS) " + kind + " $(SRCS)",
    tools = [":log_catalog_extract"],
) for name, sources, kind in CATALOG_FRAGMENTS]

genrule(
    name = "log_catalog_files",
    srcs = [":log_catalog_" + name for name, _, _ in CATALOG_FRAGMENTS],
    outs = ["log-catalog.txt", "vocabulary.txt"],
    cmd = "$(execpath :log_catalog_extract) join $(OUTS) $(SRCS)",
    tools = [":log_catalog_extract"],
)

cargo_build_script(
    name = "log_catalog",
    srcs = ["build.rs", "src/report/extract.rs"],
    build_script_env = {"ALONDRA_LOG_CATALOG_GENERATED": "1"},
    crate_root = "build.rs",
    data = [":log-catalog.txt", ":vocabulary.txt"],
    edition = "2024",
)

root_library(
    name = "alondra_lib",
    srcs = production_sources(test_only = ["src/account_native_smoke.rs", "src/service_client/live_transfer_test.rs", "src/tui/md/corpus.rs"], exclude = ["src/main.rs"]),
    compile_data = ["//launchd:alondra.plist.in"],
    crate_name = "alondra",
    crate_root = "src/lib.rs",
    version = VERSION,
    test_visibility = ["//crates/scenarios:__pkg__"],
    deps = all_crate_deps(normal = True) + [":log_catalog", "//crates/core:alondra_core", "//crates/domain-rules:domain_rules", "//crates/views:views", "//crates/e2e:alondra_e2e"],
)

root_binary(
    name = "alondra",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    version = VERSION,
    visibility = ["//visibility:public"],
    deps = crate_deps(["anyhow"]) + [":alondra_lib"],
)

low_opt_rust_test(
    name = "alondra_test",
    size = "small",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]) + ["//crates:test_support.rs"],
    crate_name = "alondra",
    crate_root = "src/lib.rs",
    compile_data = [
        "//fixtures/diffs",
        "//launchd:alondra.plist.in",
        "//:plugin/skills/alondra/SKILL.md",
        "//:plugin-orchestrator/skills/alondra-orchestrator/SKILL.md",
    ],
    deps = all_crate_deps(normal = True, normal_dev = True) + [":log_catalog", "//crates/core:alondra_core", "//crates/domain-rules:domain_rules", "//crates/views:views", "//crates/e2e:alondra_e2e"],
    data = REPORT_SOURCES + ["//fixtures/report", "//fixtures/cli", "//fixtures/client-v2", "//fixtures/markdown", "//fixtures/views:all", "//fixtures/views:cards", "//fixtures/views:newer_daemon", "//fixtures/views:metrics", "//fixtures/domain-v2:text-completion.commands.json"],
    edition = "2024",
    version = VERSION,
)

# Cargo integration tests. Paths are runfiles-relative: Bazel runs tests from the
# workspace root inside runfiles.
[low_opt_rust_test(
    name = name + "_test",
    timeout = "moderate",
    srcs = ["tests/" + name + ".rs", "//crates:test_support.rs"],
    crate_root = "tests/" + name + ".rs",
    data = [":alondra"],
    edition = "2024",
    rustc_env = {"CARGO_BIN_EXE_alondra": "$(rootpath :alondra)"},
    deps = all_crate_deps(normal = True, normal_dev = True),
) for name in [
    "cli_api",
    "doctor_json",
    "domain_mcp",
    "hook_transport",
    "version",
]]

[low_opt_rust_test(
    name = name + "_test",
    timeout = "moderate",
    srcs = ["tests/" + name + ".rs"],
    data = glob(["src/**/*.rs"]),
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/alondra"},
    deps = all_crate_deps(normal = True, normal_dev = True),
) for name in [
    "english_quotes",
    "no_literal_texts",
    "no_sleep_wording",
]]

low_opt_rust_test(
    name = "no_sfltool_test",
    size = "small",
    srcs = ["tests/no_sfltool.rs"],
    data = glob(["src/**/*.rs"]) + REPORT_SOURCES,
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/alondra"},
)

rust_binary(
    name = "fake_daemon",
    testonly = True,
    srcs = ["tests/support/fake_daemon.rs"],
    crate_root = "tests/support/fake_daemon.rs",
    edition = "2024",
    deps = crate_deps(["libc"]),
)

low_opt_rust_test(
    name = "doctor_service_test",
    timeout = "moderate",
    srcs = ["tests/doctor_service.rs", "//crates:test_support.rs"],
    crate_root = "tests/doctor_service.rs",
    data = [":alondra", ":fake_daemon"],
    edition = "2024",
    rustc_env = {
        "CARGO_BIN_EXE_alondra": "$(rootpath :alondra)",
        "CARGO_BIN_EXE_fake_daemon": "$(rootpath :fake_daemon)",
    },
    deps = all_crate_deps(normal = True, normal_dev = True),
)

# The library compiles only production sources: a test file among its inputs would rebuild every
# crate above it whenever the test changes.
rust_inputs_test(
    name = "production_inputs_test",
    size = "small",
    required_sources = ["crates/alondra/src/lib.rs"],
    source_dir = "crates/alondra/src/",
    target_under_test = ":alondra_lib",
    test_only_sources = ["crates/alondra/src/account_native_smoke.rs", "crates/alondra/src/service_client/live_transfer_test.rs", "crates/alondra/src/tui/md/corpus.rs", "crates/alondra/src/tui/tests/screens.rs"],
    test_sources = False,
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

repo_tree()
