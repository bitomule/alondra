load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

rust_binary(
    name = "alondra",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["//launchd:alondra.plist.in"],
    edition = "2024",
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + ["//crates/core:alondra_core", "//crates/e2e:alondra_e2e"],
)

rust_test(
    name = "alondra_test",
    crate = ":alondra",
    data = ["//fixtures/markdown"],
    edition = "2024",
)
