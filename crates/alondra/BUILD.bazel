load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

rust_binary(
    name = "alondra",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["//launchd:alondra.plist.in"],
    edition = "2024",
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + ["//crates/core:alondra_core", "//crates/e2e:alondra_e2e"],
)

rust_test(
    name = "alondra_test",
    crate = ":alondra",
    data = ["//fixtures/client-v2", "//fixtures/markdown", "//fixtures/domain-v2:text-completion.commands.json"],
    edition = "2024",
)

# Cargo integration tests. Paths are runfiles-relative: Bazel runs tests from the
# workspace root inside runfiles.
[rust_test(
    name = name + "_test",
    srcs = ["tests/" + name + ".rs"],
    data = [":alondra"],
    edition = "2024",
    rustc_env = {"CARGO_BIN_EXE_alondra": "$(rootpath :alondra)"},
    deps = all_crate_deps(normal = True, normal_dev = True),
) for name in [
    "domain_mcp",
    "hook_transport",
]]

[rust_test(
    name = name + "_test",
    srcs = ["tests/" + name + ".rs"],
    data = glob(["src/**/*.rs"]),
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/alondra"},
    deps = all_crate_deps(normal = True, normal_dev = True),
) for name in [
    "english_quotes",
    "no_sleep_wording",
]]
