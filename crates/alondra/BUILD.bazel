load("//tools/layers:crates.bzl", "root_binary", "root_library")
load("//tools:tree.bzl", "repo_tree")
load("@crates//:defs.bzl", "all_crate_deps", "crate_deps")
load("//tools:rust_test.bzl", "low_opt_rust_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//:version.bzl", "VERSION")
load(":catalog.bzl", "CATALOG_FRAGMENTS", "REPORT_SOURCES")
load("//tools:rust_inputs_test.bzl", "rust_inputs_test")

# The crash report keeps a line of alondrad.log only as the text of a log! call in the code: this
# writes the catalog of those calls and the words of the code. Each crate's part comes from its
# production sources in its own action, which fails on a test file, and the parts are joined in
# another: a test never reaches the CLI, and a change that leaves every part the same never
# recompiles it, because a build script's data are compile inputs of the crate it builds for.
root_binary(
    name = "log_catalog_extract",
    srcs = ["log_catalog.rs", "//crates/cli-report:src/report/extract.rs"],
    crate_root = "log_catalog.rs",
)

[genrule(
    name = "log_catalog_" + name,
    srcs = [sources],
    outs = ["log_catalog/" + name + ".catalog", "log_catalog/" + name + ".words"],
    cmd = "$(execpath :log_catalog_extract) fragment $(OUTS) " + kind + " $(SRCS)",
    tools = [":log_catalog_extract"],
) for name, sources, kind in CATALOG_FRAGMENTS]

genrule(
    name = "log_catalog_files",
    srcs = [":log_catalog_" + name for name, _, _ in CATALOG_FRAGMENTS],
    outs = ["log-catalog.txt", "vocabulary.txt"],
    cmd = "$(execpath :log_catalog_extract) join $(OUTS) $(SRCS)",
    tools = [":log_catalog_extract"],
    # The report's test reads the catalog this binary carries.
    visibility = ["//crates/cli-report:__pkg__"],
)

cargo_build_script(
    name = "log_catalog",
    srcs = ["build.rs", "//crates/cli-report:src/report/extract.rs"],
    build_script_env = {"ALONDRA_LOG_CATALOG_GENERATED": "1"},
    crate_root = "build.rs",
    data = [":log-catalog.txt", ":vocabulary.txt"],
    edition = "2024",
)

# The root: it installs the transport, the account and the doctor's checks into the client port,
# the log catalog into the report, and hands each command to its adapter. Only it compiles the
# catalog, so a word changed in any crate recompiles the root alone.
root_library(
    name = "alondra_lib",
    srcs = ["src/lib.rs"],
    crate_name = "alondra",
    crate_root = "src/lib.rs",
    version = VERSION,
    test_visibility = ["//crates/scenarios:__pkg__"],
    deps = all_crate_deps(normal = True) + [
        ":log_catalog",
        "//crates/cli:cli",
        "//crates/cli-mcp:cli_mcp",
        "//crates/cli-report:cli_report",
        "//crates/cli-tui:cli_tui",
        "//crates/client-port:client_port",
        "//crates/client-transport:client_transport",
    ],
)

root_binary(
    name = "alondra",
    srcs = ["src/main.rs"],
    crate_root = "src/main.rs",
    version = VERSION,
    visibility = ["//visibility:public"],
    deps = crate_deps(["anyhow"]) + [":alondra_lib"],
)

# Cargo integration tests. Paths are runfiles-relative: Bazel runs tests from the
# workspace root inside runfiles.
[low_opt_rust_test(
    name = name + "_test",
    timeout = "moderate",
    srcs = ["tests/" + name + ".rs", "//crates:test_support.rs"],
    crate_root = "tests/" + name + ".rs",
    data = [":alondra"],
    edition = "2024",
    env = {"TEST_EXECS": execs},
    rustc_env = {"CARGO_BIN_EXE_alondra": "$(rootpath :alondra)"},
    deps = all_crate_deps(normal = True, normal_dev = True),
) for name, execs in {
    "cli_api": "$(rootpath :alondra) /bin/sh /usr/bin/defaults /usr/bin/id /usr/bin/plutil /usr/bin/sw_vers /usr/sbin/lsof tmpdir",
    "doctor_json": "$(rootpath :alondra)",
    "domain_mcp": "$(rootpath :alondra)",
    "hook_transport": "$(rootpath :alondra)",
    "version": "$(rootpath :alondra)",
}.items()]

# The sources of every crate of the binary, for the tests that read what a person sees.
CLI_SOURCES = glob(["src/**/*.rs"]) + [
    "//crates/cli:sources",
    "//crates/cli-mcp:sources",
    "//crates/cli-report:sources",
    "//crates/cli-tui:sources",
    "//crates/client-port:sources",
    "//crates/client-transport:sources",
]

[low_opt_rust_test(
    name = name + "_test",
    timeout = "moderate",
    srcs = ["tests/" + name + ".rs"],
    data = CLI_SOURCES,
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/alondra"},
    deps = all_crate_deps(normal = True, normal_dev = True),
) for name in [
    "english_quotes",
    "no_literal_texts",
    "no_sleep_wording",
]]

low_opt_rust_test(
    name = "no_sfltool_test",
    size = "small",
    srcs = ["tests/no_sfltool.rs"],
    data = CLI_SOURCES + REPORT_SOURCES,
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/alondra"},
)

rust_binary(
    name = "fake_daemon",
    testonly = True,
    srcs = ["tests/support/fake_daemon.rs"],
    crate_root = "tests/support/fake_daemon.rs",
    edition = "2024",
    deps = crate_deps(["libc"]),
)

low_opt_rust_test(
    name = "doctor_service_test",
    env = {"TEST_EXECS": "$(rootpath :alondra) $(rootpath :fake_daemon) /bin/cat /bin/mkdir /bin/mv /bin/rm /bin/sh /usr/bin/defaults /usr/bin/grep /usr/bin/id /usr/bin/plutil /usr/bin/sw_vers /usr/bin/touch /usr/bin/wc /usr/sbin/lsof tmpdir"},
    timeout = "moderate",
    srcs = ["tests/doctor_service.rs", "//crates:test_support.rs"],
    crate_root = "tests/doctor_service.rs",
    data = [":alondra", ":fake_daemon"],
    edition = "2024",
    rustc_env = {
        "CARGO_BIN_EXE_alondra": "$(rootpath :alondra)",
        "CARGO_BIN_EXE_fake_daemon": "$(rootpath :fake_daemon)",
    },
    deps = all_crate_deps(normal = True, normal_dev = True),
)

# The root library compiles `src/lib.rs` alone; every command lives in an adapter crate.
rust_inputs_test(
    name = "production_inputs_test",
    size = "small",
    required_sources = ["crates/alondra/src/lib.rs"],
    source_dir = "crates/alondra/src/",
    target_under_test = ":alondra_lib",
    test_sources = False,
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

repo_tree()
