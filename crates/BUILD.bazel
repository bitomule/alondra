load("//bazel/rules:tree.bzl", "repo_tree")
load("@crates//:defs.bzl", "all_crate_deps")
load("//bazel/rules:rust_test.bzl", "low_opt_rust_test")

exports_files(["test_support.rs"], visibility = ["//visibility:public"])

low_opt_rust_test(
    name = "test_directory_test",
    size = "small",
    srcs = ["test_support_tests.rs", "test_support.rs"],
    crate_root = "test_support_tests.rs",
    deps = all_crate_deps(package_name = "crates/core", normal_dev = True),
    edition = "2024",
)


WORKSPACE_MEMBERS = [
    "agent-application",
    "agent-protocol",
    "codex-protocol",
    "agent-runtime",
    "alondra",
    "alondrad",
    "cli",
    "cli-mcp",
    "cli-report",
    "cli-tui",
    "client-port",
    "client-transport",
    "core",
    "daemon-engine",
    "daemon-engine-model",
    "store-sqlite",
    "daemon-engine-machine",
    "daemon-server",
    "daemon-support",
    "domain",
    "domain-rules",
    "engine-admission",
    "engine-github",
    "engine-live",
    "engine-mcp",
    "engine-worktrees",
    "engine-kernel",
    "engine-ports",
    "github-gh",
    "engine-orchestrator",
    "engine-doubles",
    "engine-sdk",
    "e2e",
    "foundation",
    "process-group",
    "provider-claude",
    "provider-codex",
    "provider-conformance",
    "provider-contract",
    "relay",
    "scenarios",
    "scenarios-transcript",
    "host",
    "store",
    "system",
    "view-model",
    "views",
]

filegroup(
    name = "workspace_manifests",
    srcs = ["//crates/{}:Cargo.toml".format(member) for member in WORKSPACE_MEMBERS],
    visibility = ["//deploy/brew:__pkg__"],
)

sh_test(
    name = "cargo_bazel_deps_test",
    srcs = ["cargo_bazel_deps_test.py"],
    data = ["//:Cargo.toml"] + [
        "//crates/{}:{}".format(member, file)
        for member in WORKSPACE_MEMBERS
        for file in ["BUILD.bazel", "Cargo.toml"]
    ],
    size = "small",
)

repo_tree()
