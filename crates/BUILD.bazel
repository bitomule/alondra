load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_test")

exports_files(["test_support.rs"], visibility = ["//visibility:public"])

rust_test(
    name = "test_directory_test",
    srcs = ["test_support_tests.rs", "test_support.rs"],
    crate_root = "test_support_tests.rs",
    deps = all_crate_deps(package_name = "crates/core", normal_dev = True),
    edition = "2024",
)


sh_test(
    name = "cargo_bazel_deps_test",
    srcs = ["cargo_bazel_deps_test.py"],
    data = ["//:Cargo.toml"] + [
        "//crates/{}:{}".format(member, file)
        for member in [
            "agent-application",
            "agent-protocol",
            "agent-runtime",
            "alondra",
            "alondrad",
            "core",
            "domain",
            "e2e",
            "foundation",
            "process-group",
            "provider-claude",
            "provider-contract",
            "relay",
            "store",
        ]
        for file in ["BUILD.bazel", "Cargo.toml"]
    ],
    size = "small",
)
