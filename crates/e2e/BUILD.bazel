load("@crates//:defs.bzl", "all_crate_deps")
load("//tools:rust_test.bzl", "low_opt_rust_test")
load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "alondra_e2e",
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    crate_name = "alondra_e2e",
    edition = "2024",
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

low_opt_rust_test(
    name = "alondra_e2e_test",
    crate = ":alondra_e2e",
    deps = all_crate_deps(normal_dev = True),
    edition = "2024",
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])
