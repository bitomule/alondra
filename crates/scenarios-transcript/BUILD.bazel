load("//tools/layers:crates.bzl", "foundation_crate")
load("//tools:tree.bzl", "repo_tree")
load("//tools:rust_test.bzl", "low_opt_rust_test")
load("@crates//:defs.bzl", "all_crate_deps")
load("//:version.bzl", "VERSION")

foundation_crate(
    name = "scenarios_transcript",
    srcs = glob(["src/**/*.rs"], exclude = ["src/**/*_tests.rs"]),
    crate_name = "alondra_scenarios_transcript",
    version = VERSION,
    test_visibility = ["//crates/provider-conformance:__pkg__"],
    deps = all_crate_deps(normal = True),
)

low_opt_rust_test(
    name = "scenarios_transcript_test",
    size = "small",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "alondra_scenarios_transcript",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = VERSION,
    deps = all_crate_deps(normal = True, normal_dev = True),
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

repo_tree()
