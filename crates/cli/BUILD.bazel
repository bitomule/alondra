load("//tools/bazel:crates.bzl", "adapter_in_crate")
load("//tools:tree.bzl", "repo_tree")
load("@crates//:defs.bzl", "all_crate_deps")
load("//tools:rust_test.bzl", "low_opt_rust_test")
load("//tools:rust_sources.bzl", "production_sources")
load("//tools:rust_inputs_test.bzl", "rust_inputs_test")
load("//:version.bzl", "VERSION")

WORKSPACE_DEPS = [
    "//crates/client-port:client_port",
    "//crates/core:alondra_core",
    "//crates/host:host",
    "//crates/domain-rules:domain_rules",
    "//crates/e2e:alondra_e2e",
    "//crates/view-model:view_model",
]

TEST_ONLY = ["src/account_native_smoke.rs"]

# The `alondra` commands: the command line, setting up and checking this Mac, the account, the
# devices and Macs a terminal uses, and the one-shot commands that act on the daemon.
adapter_in_crate(
    name = "cli",
    srcs = production_sources(test_only = TEST_ONLY),
    compile_data = ["//launchd:alondra.plist.in"],
    crate_name = "alondra_cli",
    version = VERSION,
    deps = all_crate_deps(normal = True) + WORKSPACE_DEPS,
)

# The one-shot commands are checked against the views the daemon's renderer builds.
low_opt_rust_test(
    name = "cli_test",
    size = "small",
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    compile_data = ["//launchd:alondra.plist.in"],
    crate_name = "alondra_cli",
    crate_root = "src/lib.rs",
    data = ["//fixtures/cli"],
    edition = "2024",
    version = VERSION,
    deps = all_crate_deps(normal = True, normal_dev = True) + WORKSPACE_DEPS + [
        "//crates/client-transport:client_transport",
        "//crates/views:views",
    ],
)

# The library compiles only production sources: a test file among its inputs would rebuild every
# crate above it whenever the test changes.
rust_inputs_test(
    name = "production_inputs_test",
    size = "small",
    required_sources = ["crates/cli/src/lib.rs", "crates/cli/src/args.rs"],
    source_dir = "crates/cli/src/",
    target_under_test = ":cli",
    test_only_sources = ["crates/cli/src/account_native_smoke.rs"],
    test_sources = False,
)

# Every source, tests included, for the root's tests that read what a person sees.
filegroup(
    name = "sources",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//crates/alondra:__pkg__"],
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

repo_tree()
