load("//tools/layers:crates.bzl", "application_crate")
load("//bazel/rules:tree.bzl", "repo_tree")
load("//bazel/rules:rust_test.bzl", "low_opt_rust_test")
load("@crates//:defs.bzl", "all_crate_deps")
load("//bazel/rules:rust_inputs_test.bzl", "rust_inputs_test")
load("//:version.bzl", "VERSION")
load("//bazel/rules:rust_sources.bzl", "production_sources")

# The orchestrator knows the engine only through the ports of engine-ports: it depends on no engine
# subsystem, no subsystem depends on it, and only alondrad, which puts the daemon together, sees it.
WORKSPACE_DEPS = [
    "//crates/foundation:foundation",
    "//crates/engine-ports:engine_ports",
    "//crates/core:alondra_core",
    "//crates/domain-rules:domain_rules",
    "//crates/view-model:view_model",
    "//crates/domain:domain",
    "//crates/process-group:process_group",
    "//crates/provider-claude:provider_claude",
    "//crates/provider-codex:provider_codex",
    "//crates/store:store",
]

application_crate(
    name = "engine_orchestrator",
    srcs = production_sources(),
    crate_name = "alondra_engine_orchestrator",
    version = VERSION,
    test_visibility = ["//crates/machine-model:__pkg__"],
    deps = all_crate_deps(normal = True) + WORKSPACE_DEPS + [
        "//crates/daemon-engine-model:daemon_engine_model",
        "//crates/daemon-support:daemon_support",
        "//crates/engine-kernel:engine_kernel",
    ],
)

# What every test target links besides the crate's own dependencies: the doubles of the engine's
# other pieces and the store they open.
TEST_DEPS = [
    "//crates/codex-protocol:codex_protocol",
    "//crates/daemon-engine-model:daemon_engine_model",
    "//crates/daemon-support:daemon_support",
    "//crates/engine-doubles:engine_doubles",
    "//crates/engine-kernel:engine_kernel",
    "//crates/provider-contract:provider_contract",
    "//crates/store-sqlite:store_sqlite",
]

# The orchestrator's own tests on the doubled hosts of engine-doubles, which the orchestrator model
# of the Claude host model and the Codex host model play: they run no program, and no host or fake
# is an input.
low_opt_rust_test(
    name = "engine_orchestrator_test",
    size = "medium",
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    crate_name = "alondra_engine_orchestrator",
    crate_root = "src/lib.rs",
    edition = "2024",
    env = {"HOME": "."},
    version = VERSION,
    deps = all_crate_deps(normal = True, normal_dev = True) + WORKSPACE_DEPS + TEST_DEPS + ["//crates/provider-claude:claude_host_model", "//crates/provider-codex:codex_host_model"],
)

# The tests that still need a real Agent SDK host, a fake native Claude, or real processes: the same
# sources with the feature real-hosts, which compiles only them.
low_opt_rust_test(
    name = "engine_orchestrator_host_test",
    size = "large",
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    crate_features = ["real-hosts"],
    crate_name = "alondra_engine_orchestrator",
    crate_root = "src/lib.rs",
    data = [
        "//agent-host:alondra-host",
        "//agent-host:orchestrator-fake-claude.py",
        "//agent-host:persistent-fake-claude.py",
    ],
    edition = "2024",
    # Bazel test-setup resolves a relative HOME to this test's TEST_TMPDIR.
    env = {
        "FIXTURE_HOST": "$(rootpath //agent-host:alondra-host)",
        "FIXTURE_NATIVE": "$(rootpath //agent-host:persistent-fake-claude.py)",
        "FIXTURE_NODE": "$(rootpath //agent-host:alondra-host)",
        "FIXTURE_ORCHESTRATOR_NATIVE": "$(rootpath //agent-host:orchestrator-fake-claude.py)",
        "HOME": ".",
        "TEST_EXECS": "$(rootpath //agent-host:alondra-host) /bin/cat /bin/sleep /usr/bin/id /usr/bin/mkfifo /usr/bin/pgrep /usr/bin/python3 /usr/bin/true /usr/sbin/lsof tmpdir",
    },
    version = VERSION,
    deps = all_crate_deps(normal = True, normal_dev = True) + WORKSPACE_DEPS + TEST_DEPS + ["//crates/agent-runtime:agent_runtime"],
)

rust_inputs_test(
    name = "production_inputs_test",
    size = "small",
    required_sources = ["crates/engine-orchestrator/src/lib.rs", "crates/engine-orchestrator/src/domain_orchestrator.rs"],
    source_dir = "crates/engine-orchestrator/src/",
    target_under_test = ":engine_orchestrator",
    test_only_sources = ["crates/engine-orchestrator/src/orchestrator_sdk/tests.rs", "crates/test_support.rs"],
    test_sources = False,
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

# The crate's production sources: the crash report's log catalog reads them, and fails on a test
# file among them; alondrad's lock policy test reads them too.
filegroup(
    name = "report_sources",
    srcs = production_sources(),
    visibility = ["//crates/alondra:__pkg__", "//crates/cli-report:__pkg__", "//crates/alondrad:__pkg__", "//crates/daemon-server:__pkg__"],
)

repo_tree()
