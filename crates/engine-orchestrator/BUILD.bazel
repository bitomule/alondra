load("//tools:tree.bzl", "repo_tree")
load("//tools:rust_test.bzl", "LOW_OPT_LEVEL", "low_opt_rust_test")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//tools:rust_inputs_test.bzl", "rust_inputs_test")
load("//:version.bzl", "VERSION")
load("//tools:rust_sources.bzl", "production_sources")

# The orchestrator knows the engine only through the kernel's ports: it depends on no engine
# subsystem, no subsystem depends on it, and only alondrad, which puts the daemon together, sees it.
WORKSPACE_DEPS = [
    "//crates/agent-runtime:agent_runtime",
    "//crates/core:alondra_core",
    "//crates/domain-rules:domain_rules",
    "//crates/view-model:view_model",
    "//crates/domain:domain",
    "//crates/process-group:process_group",
    "//crates/provider-claude:provider_claude",
    "//crates/provider-codex:provider_codex",
    "//crates/store:store",
]

rust_library(
    name = "engine_orchestrator",
    srcs = production_sources(),
    crate_name = "alondra_engine_orchestrator",
    edition = "2024",
    version = VERSION,
    visibility = ["//crates/alondrad:__pkg__"],
    deps = all_crate_deps(normal = True) + WORKSPACE_DEPS + [
        "//crates/daemon-engine-model:daemon_engine_model",
        "//crates/daemon-support:daemon_support",
        "//crates/engine-kernel:engine_kernel",
    ],
)

# The engine's and alondrad's tests build against it: the inbox the engine's tests settle, and the
# fixture of an orchestrator over a runtime they opened.
rust_library(
    name = "engine_orchestrator_test_hooks",
    testonly = True,
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    crate_features = ["test-hooks"],
    crate_name = "alondra_engine_orchestrator",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_flags = [LOW_OPT_LEVEL],
    version = VERSION,
    visibility = ["//crates/alondrad:__pkg__", "//crates/machine-model:__pkg__", "//crates/scenarios:__pkg__"],
    deps = all_crate_deps(normal = True, normal_dev = True) + WORKSPACE_DEPS + [
        "//crates/daemon-engine-model:daemon_engine_model_test_hooks",
        "//crates/daemon-support:daemon_support_test_hooks",
        "//crates/engine-kernel:engine_kernel_test_hooks",
    ],
)

# Most of the orchestrator's tests run a real Agent SDK host or a fake Claude or Codex, so its one
# test target carries them; the few that need none take seconds next to them.
low_opt_rust_test(
    name = "engine_orchestrator_test",
    size = "large",
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    crate_name = "alondra_engine_orchestrator",
    crate_root = "src/lib.rs",
    data = [
        "//agent-host:alondra-codex-host",
        "//agent-host:alondra-host",
        "//agent-host:fake-codex.py",
        "//agent-host:orchestrator-fake-claude.py",
        "//agent-host:persistent-fake-claude.py",
    ],
    edition = "2024",
    # Bazel test-setup resolves a relative HOME to this test's TEST_TMPDIR.
    env = {
        "FIXTURE_CODEX_HOST": "$(rootpath //agent-host:alondra-codex-host)",
        "FIXTURE_CODEX_NATIVE": "$(rootpath //agent-host:fake-codex.py)",
        "FIXTURE_HOST": "$(rootpath //agent-host:alondra-host)",
        "FIXTURE_NATIVE": "$(rootpath //agent-host:persistent-fake-claude.py)",
        "FIXTURE_NODE": "$(rootpath //agent-host:alondra-host)",
        "FIXTURE_ORCHESTRATOR_NATIVE": "$(rootpath //agent-host:orchestrator-fake-claude.py)",
        "HOME": ".",
    },
    version = VERSION,
    deps = all_crate_deps(normal = True, normal_dev = True) + WORKSPACE_DEPS + [
        "//crates/codex-protocol:codex_protocol",
        "//crates/daemon-engine:daemon_engine_test_hooks",
        "//crates/engine-sdk:engine_sdk_test_hooks",
        "//crates/daemon-engine-model:daemon_engine_model_test_hooks",
        "//crates/daemon-support:daemon_support_test_hooks",
        "//crates/engine-kernel:engine_kernel_test_hooks",
        "//crates/provider-contract:provider_contract",
    ],
)

rust_inputs_test(
    name = "production_inputs_test",
    size = "small",
    required_sources = ["crates/engine-orchestrator/src/lib.rs", "crates/engine-orchestrator/src/domain_orchestrator.rs"],
    source_dir = "crates/engine-orchestrator/src/",
    target_under_test = ":engine_orchestrator",
    test_only_sources = ["crates/engine-orchestrator/src/orchestrator_sdk/tests.rs", "crates/test_support.rs"],
    test_sources = False,
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

# The crate's production sources: the crash report's log catalog reads them, and fails on a test
# file among them; alondrad's lock policy test reads them too.
filegroup(
    name = "report_sources",
    srcs = production_sources(),
    visibility = ["//crates/alondra:__pkg__", "//crates/alondrad:__pkg__"],
)

repo_tree()
