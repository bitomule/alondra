load(":build_inputs_test.bzl", "rust_inputs_test")
load("//tools:rust_test.bzl", "low_opt_rust_test")
load("@crates//:defs.bzl", "all_crate_deps", "crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load("//:version.bzl", "VERSION")

exports_files(
    ["src/domain_store/schema.sql", "src/domain_store/schedule_launch_transition.sql"],
    visibility = ["//crates/store:__pkg__", "//crates/agent-application:__pkg__", "//crates/provider-claude:__pkg__", "//crates/agent-runtime:__pkg__", "//crates/daemon-engine:__pkg__", "//crates/daemon-engine-store:__pkg__"],
)

# The engine's acceptance catalog checks that the scenarios it names have tests here.
exports_files(
    ["src/domain_api.rs", "src/service/domain_parity_tests.rs"],
    visibility = ["//crates/daemon-engine:__pkg__", "//crates/daemon-engine-store:__pkg__"],
)

rust_library(
    name = "alondrad_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs", "src/**/*_tests.rs", "src/**/tests.rs", "src/**/tests/*.rs"],
    ),
    crate_name = "alondrad",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = VERSION,
    deps = all_crate_deps(normal = True) + [
        "//crates/core:alondra_core",
        "//crates/daemon-engine:daemon_engine",
        "//crates/daemon-support:daemon_support",
        "//crates/domain:domain",
        "//crates/e2e:alondra_e2e",
        "//crates/process-group:process_group",
    ],
)

rust_binary(
    name = "alondrad",
    srcs = ["src/main.rs"],
    compile_data = ["Info.plist"],
    crate_root = "src/main.rs",
    edition = "2024",
    # macOS asks for Local Network access before alondrad may advertise on Bonjour; a
    # standalone executable carries the reason in an embedded Info.plist (TN3179).
    rustc_flags = ["-Clink-arg=-Wl,-sectcreate,__TEXT,__info_plist,$(execpath Info.plist)"],
    version = VERSION,
    visibility = ["//visibility:public"],
    deps = crate_deps(["anyhow"]) + [":alondrad_lib"],
)

# launchd runs this at a fixed path so macOS keeps alondrad's Local Network permission across
# updates; it carries the same Info.plist because the permission prompt shows its reason.
rust_binary(
    name = "alondrad-launcher",
    srcs = ["launcher/main.rs"],
    compile_data = ["Info.plist"],
    crate_root = "launcher/main.rs",
    edition = "2024",
    rustc_flags = ["-Clink-arg=-Wl,-sectcreate,__TEXT,__info_plist,$(execpath Info.plist)"],
    version = VERSION,
    visibility = ["//visibility:public"],
)

low_opt_rust_test(
    name = "launcher_test",
    size = "small",
    srcs = ["tests/launcher.rs", "//crates:test_support.rs"],
    crate_root = "tests/launcher.rs",
    data = [":alondrad-launcher"],
    edition = "2024",
    rustc_env = {"CARGO_BIN_EXE_alondrad-launcher": "$(rootpath :alondrad-launcher)"},
    version = VERSION,
    deps = all_crate_deps(normal_dev = True),
)

low_opt_rust_test(
    name = "alondrad_test",
    size = "large",
    timeout = "moderate",
    visibility = ["//apple/Data/Feed:__pkg__", "//apple/Data/Iroh:__pkg__"],
    compile_data = [
        "//crates/core:fixtures/ctrl_trivial_2.jsonl",
        "//crates/core:fixtures/quill.jsonl",
        "//fixtures/client-v2",
        "//fixtures/push",
        "//fixtures/views:all",
        "//fixtures/views:cards",
        "Info.plist",
    ],
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    crate_name = "alondrad",
    crate_root = "src/lib.rs",
    # Bazel test-setup resolves a relative HOME to this test's TEST_TMPDIR.
    env = {
        "FIXTURE_DAEMON": "$(rootpath :alondrad)",
        "HOME": ".",
        # The host a release ships: Node, the SDK and the host in one executable, so every SDK test
        # of the daemon runs the bytes Brew installs.
        "FIXTURE_NODE": "$(rootpath //agent-host:alondra-host)",
        "FIXTURE_HOST": "$(rootpath //agent-host:alondra-host)",
        "FIXTURE_NATIVE": "$(rootpath //agent-host:persistent-fake-claude.py)",
        "FIXTURE_CODEX_HOST": "$(rootpath //agent-host:alondra-codex-host)",
        "FIXTURE_CODEX_LEGACY_HOST": "$(rootpath //agent-host:codex-legacy-fixture)",
        "FIXTURE_CODEX_NATIVE": "$(rootpath //agent-host:fake-codex.py)",
        "FIXTURE_CODEX_MODEL_DOUBLE": "$(rootpath //agent-host:codex-model-double.py)",
        "FIXTURE_CODEX_MCP_NATIVE": "$(rootpath //agent-host:fake-codex-mcp.py)",
        "FIXTURE_ORCHESTRATOR_NATIVE": "$(rootpath //agent-host:orchestrator-fake-claude.py)",
    },
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        "//crates/core:alondra_core",
        "//crates/daemon-engine:daemon_engine_test_hooks",
        "//crates/daemon-support:daemon_support_test_hooks",
        "//crates/domain:domain",
        "//crates/e2e:alondra_e2e",
        "//crates/process-group:process_group",
    ],
    data = [
        ":alondrad",
        "//agent-host:orchestrator-fake-claude.py",
        "//agent-host:persistent-fake-claude.py",
        "//agent-host:alondra-host",
        "//agent-host:alondra-codex-host",
        "//agent-host:codex-legacy-fixture",
        "//agent-host:fake-codex.py",
        "//agent-host:codex-model-double.py",
        "//agent-host:fake-codex-mcp.py",
        "//crates/alondra:alondra",
        "//fixtures/client-v2",
        "//fixtures/views:all",
    ],
    edition = "2024",
    rustc_env = {"CARGO_BIN_EXE_alondra": "$(rootpath //crates/alondra:alondra)"},
    rustc_flags = ["-Clink-arg=-Wl,-sectcreate,__TEXT,__info_plist,$(execpath Info.plist)"],
    version = VERSION,
)

rust_inputs_test(
    name = "production_inputs_test",
    size = "small",
    target_under_test = ":alondrad_lib",
    test_sources = False,
)

rust_inputs_test(
    name = "alondrad_test_inputs_test",
    size = "small",
    target_under_test = ":alondrad_test",
    test_sources = True,
)

low_opt_rust_test(
    name = "lock_policy_test",
    size = "small",
    srcs = ["tests/lock_policy.rs"],
    data = [":report_sources", "//crates/daemon-engine:report_sources", "//crates/daemon-engine-model:report_sources", "//crates/daemon-engine-store:report_sources", "//crates/daemon-support:report_sources"],
    edition = "2024",
)

low_opt_rust_test(
    name = "relaunch_test",
    timeout = "moderate",
    srcs = ["tests/relaunch.rs"],
    data = [":alondrad"],
    edition = "2024",
    rustc_env = {"CARGO_BIN_EXE_alondrad": "$(rootpath :alondrad)"},
    version = VERSION,
    deps = all_crate_deps(normal = True, normal_dev = True) + ["//crates/core:alondra_core"],
)

low_opt_rust_test(
    name = "info_commands_test",
    size = "small",
    srcs = ["tests/info_commands.rs", "//crates:test_support.rs"],
    crate_root = "tests/info_commands.rs",
    data = [":alondrad"],
    edition = "2024",
    rustc_env = {"CARGO_BIN_EXE_alondrad": "$(rootpath :alondrad)"},
    version = VERSION,
    deps = all_crate_deps(normal = True, normal_dev = True),
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

# Read by the crash report's build script for its log catalog and the words of the code.
filegroup(
    name = "report_sources",
    srcs = glob(["src/**/*.rs", "launcher/**/*.rs"]),
    visibility = ["//crates/alondra:__pkg__"],
)
