load("//tools/layers:crates.bzl", "root_binary", "root_library")
load("//bazel/rules:tree.bzl", "repo_tree")
load("//bazel/rules:rust_inputs_test.bzl", "rust_inputs_test")
load("//bazel/rules:rust_test.bzl", "low_opt_rust_test")
load("@crates//:defs.bzl", "all_crate_deps", "crate_deps")
load("//:version.bzl", "VERSION")
load("//bazel/rules:rust_sources.bzl", "production_sources")
load("@bazel_skylib//rules:build_test.bzl", "build_test")

exports_files(["Info.plist"], visibility = ["//crates/daemon-server:__pkg__", "//deploy/brew:__pkg__"])

# The daemon's root: `main`, the supervision of what runs, and `assemble`, which puts the server
# together with the engine and registers the screens. Only it links `views`.
root_library(
    name = "alondrad_lib",
    srcs = production_sources(exclude = ["src/main.rs", "src/production.rs"]),
    crate_name = "alondrad",
    crate_root = "src/lib.rs",
    version = VERSION,
    deps = all_crate_deps(normal = True) + [
        "//crates/agent-runtime:agent_runtime",
        "//crates/core:alondra_core",
        "//crates/system:system",
        "//crates/host:host",
        "//crates/daemon-engine:daemon_engine",
        "//crates/daemon-server:daemon_server",
        "//crates/engine-admission:engine_admission",
        "//crates/engine-ports:engine_ports",
        "//crates/engine-sdk:engine_sdk",
        "//crates/store-sqlite:store_sqlite",
        "//crates/views:views",
    ],
    test_visibility = ["//crates/scenarios:__pkg__"],
)

# The daemon's real edges: GitHub through `gh`. Only the binary links it, so the daemon's tests and
# the scenarios, which link `alondrad_lib`, never build or rerun on an edit of the GitHub client.
root_library(
    name = "alondrad_production",
    srcs = ["src/production.rs"],
    crate_root = "src/production.rs",
    version = VERSION,
    deps = crate_deps(["anyhow"]) + [
        ":alondrad_lib",
        "//crates/github-gh:github_gh",
    ],
)

root_binary(
    name = "alondrad",
    srcs = ["src/main.rs"],
    compile_data = ["Info.plist"],
    crate_root = "src/main.rs",
    # macOS asks for Local Network access before alondrad may advertise on Bonjour; a
    # standalone executable carries the reason in an embedded Info.plist (TN3179).
    rustc_flags = ["-Clink-arg=-Wl,-sectcreate,__TEXT,__info_plist,$(execpath Info.plist)"],
    version = VERSION,
    visibility = ["//visibility:public"],
    deps = crate_deps(["anyhow"]) + [":alondrad_production"],
)

# launchd runs this at a fixed path so macOS keeps alondrad's Local Network permission across
# updates; it carries the same Info.plist because the permission prompt shows its reason.
root_binary(
    name = "alondrad-launcher",
    srcs = ["launcher/main.rs"],
    compile_data = ["Info.plist"],
    crate_root = "launcher/main.rs",
    rustc_flags = ["-Clink-arg=-Wl,-sectcreate,__TEXT,__info_plist,$(execpath Info.plist)"],
    version = VERSION,
    visibility = ["//visibility:public"],
)

low_opt_rust_test(
    name = "launcher_test",
    env = {"TEST_EXECS": "$(rootpath :alondrad-launcher) /bin/kill /bin/sh /bin/sleep tmpdir"},
    size = "small",
    srcs = ["tests/launcher.rs", "//crates:test_support.rs"],
    crate_root = "tests/launcher.rs",
    data = [":alondrad-launcher"],
    edition = "2024",
    rustc_env = {"CARGO_BIN_EXE_alondrad-launcher": "$(rootpath :alondrad-launcher)"},
    version = VERSION,
    deps = all_crate_deps(normal_dev = True),
)

low_opt_rust_test(
    name = "alondrad_test",
    size = "small",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs", "src/production.rs"]) + ["//crates/engine-sdk:fixtures"],
    crate_name = "alondrad",
    crate_root = "src/lib.rs",
    # Bazel test-setup resolves a relative HOME to this test's TEST_TMPDIR.
    env = {"HOME": "."},
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        "//crates/agent-runtime:agent_runtime",
        "//crates/core:alondra_core",
        "//crates/system:system",
        "//crates/host:host",
        "//crates/daemon-engine:daemon_engine",
        "//crates/daemon-server:daemon_server",
        "//crates/daemon-support:daemon_support",
        "//crates/domain-rules:domain_rules",
        "//crates/engine-doubles:engine_doubles",
        "//crates/engine-admission:engine_admission",
        "//crates/engine-ports:engine_ports",
        "//crates/engine-sdk:engine_sdk",
        "//crates/foundation:foundation",
        "//crates/store-sqlite:store_sqlite",
        "//crates/views:views",
    ],
    edition = "2024",
    version = VERSION,
)

rust_inputs_test(
    name = "production_inputs_test",
    size = "small",
    required_sources = ["crates/alondrad/src/lib.rs", "crates/alondrad/src/assemble.rs"],
    source_dir = "crates/alondrad/src/",
    target_under_test = ":alondrad_lib",
    test_only_sources = ["crates/alondrad/src/startup_tests.rs"],
    test_sources = False,
)

low_opt_rust_test(
    name = "lock_policy_test",
    size = "small",
    srcs = ["tests/lock_policy.rs"],
    data = [":report_sources", "//crates/daemon-server:report_sources", "//crates/daemon-engine:report_sources", "//crates/daemon-engine-model:report_sources", "//crates/store-sqlite:report_sources", "//crates/daemon-engine-machine:report_sources", "//crates/engine-admission:report_sources", "//crates/engine-github:report_sources", "//crates/engine-live:report_sources", "//crates/engine-mcp:report_sources", "//crates/engine-worktrees:report_sources", "//crates/engine-kernel:report_sources", "//crates/engine-orchestrator:report_sources", "//crates/engine-sdk:report_sources", "//crates/daemon-support:report_sources", "//crates/system:report_sources", "//crates/foundation:report_sources"],
    edition = "2024",
)

low_opt_rust_test(
    name = "relaunch_test",
    env = {"TEST_EXECS": "/bin/sh /usr/bin/id tmpdir"},
    timeout = "moderate",
    srcs = ["tests/relaunch.rs"],
    data = [":alondrad"],
    edition = "2024",
    rustc_env = {"CARGO_BIN_EXE_alondrad": "$(rootpath :alondrad)"},
    version = VERSION,
    deps = all_crate_deps(normal = True, normal_dev = True) + ["//crates/core:alondra_core", "//crates/domain-rules:domain_rules", "//crates/views:views"],
)

low_opt_rust_test(
    name = "info_commands_test",
    env = {"TEST_EXECS": "$(rootpath :alondrad)"},
    size = "small",
    srcs = ["tests/info_commands.rs", "//crates:test_support.rs"],
    crate_root = "tests/info_commands.rs",
    data = [":alondrad"],
    edition = "2024",
    rustc_env = {"CARGO_BIN_EXE_alondrad": "$(rootpath :alondrad)"},
    version = VERSION,
    deps = all_crate_deps(normal = True, normal_dev = True),
)

# The root's binaries against what they front: `alondrad --preflight` against the server's own
# preflight, and the real `alondra` CLI against a daemon the test puts together as the root does.
# The server's tests run none of them, so an edit of the root reruns only these.
low_opt_rust_test(
    name = "binary_smoke_test",
    size = "medium",
    srcs = ["tests/binary_smoke.rs", "tests/binary_smoke/cli_journeys.rs"],
    crate_root = "tests/binary_smoke.rs",
    data = [
        ":alondrad",
        "//crates/alondra:alondra",
    ],
    edition = "2024",
    # Bazel test-setup resolves a relative HOME to this test's TEST_TMPDIR.
    env = {
        "FIXTURE_DAEMON": "$(rootpath :alondrad)",
        "HOME": ".",
        "TEST_EXECS": "$(rootpath //crates/alondra:alondra) $(rootpath :alondrad)",
    },
    rustc_env = {"CARGO_BIN_EXE_alondra": "$(rootpath //crates/alondra:alondra)"},
    version = VERSION,
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        ":alondrad_lib",
        "//crates/agent-runtime:agent_runtime",
        "//crates/core:alondra_core",
        "//crates/daemon-engine:daemon_engine",
        "//crates/daemon-server:daemon_server",
        "//crates/domain-rules:domain_rules",
        "//crates/engine-admission:engine_admission",
        "//crates/engine-doubles:engine_doubles",
        "//crates/engine-ports:engine_ports",
        "//crates/engine-sdk:engine_sdk",
        "//crates/foundation:foundation",
        "//crates/store-sqlite:store_sqlite",
        "//crates/view-model:view_model",
        "//crates/views:views",
    ],
)

# The release runs codex_adoption_process_test, which no wildcard runs: this builds it with every
# validation of this package, so a change to the engine's fixtures it compiles cannot break the
# release unseen.
build_test(
    name = "codex_adoption_process_build_test",
    size = "small",
    targets = [":codex_adoption_process_test"],
)

# A real alondrad, killed and started again twice, adopts the live Codex host of a task with what
# it held. It starts the daemon three times under Seatbelt, so no wildcard runs it: the release's
# tests name it (deploy/brew/local-release.py).
low_opt_rust_test(
    name = "codex_adoption_process_test",
    timeout = "moderate",
    srcs = ["tests/codex_adoption.rs", "//crates/engine-sdk:fixtures"],
    crate_features = ["real-hosts"],
    crate_root = "tests/codex_adoption.rs",
    data = [
        ":alondrad",
        "//agent-host:alondra-codex-host",
        "//agent-host:alondra-host",
        "//agent-host:fake-codex.py",
        "//agent-host:persistent-fake-claude.py",
        "//crates/alondra:alondra",
    ],
    edition = "2024",
    # Bazel test-setup resolves a relative HOME to this test's TEST_TMPDIR.
    env = {
        "FIXTURE_CLI": "$(rootpath //crates/alondra:alondra)",
        "FIXTURE_CODEX_HOST": "$(rootpath //agent-host:alondra-codex-host)",
        "FIXTURE_CODEX_NATIVE": "$(rootpath //agent-host:fake-codex.py)",
        "FIXTURE_DAEMON": "$(rootpath :alondrad)",
        "FIXTURE_HOST": "$(rootpath //agent-host:alondra-host)",
        "FIXTURE_NATIVE": "$(rootpath //agent-host:persistent-fake-claude.py)",
        "FIXTURE_NODE": "$(rootpath //agent-host:alondra-host)",
        "HOME": ".",
        "TEST_EXECS": "e2e",
    },
    tags = [
        "e2e",
        "manual",
    ],
    target_compatible_with = ["@platforms//os:macos"],
    version = VERSION,
    deps = all_crate_deps(normal = True, normal_dev = True) + [
        ":alondrad_lib",
        "//crates/core:alondra_core",
        "//crates/domain:domain",
        "//crates/foundation:foundation",
        "//crates/agent-runtime:agent_runtime",
        "//crates/daemon-engine:daemon_engine",
        "//crates/daemon-engine-model:daemon_engine_model",
        "//crates/daemon-support:daemon_support",
        "//crates/domain-rules:domain_rules",
        "//crates/engine-kernel:engine_kernel",
        "//crates/engine-ports:engine_ports",
        "//crates/engine-admission:engine_admission",
        "//crates/engine-doubles:engine_doubles",
        "//crates/engine-sdk:engine_sdk",
        "//crates/process-group:process_group",
        "//crates/provider-contract:provider_contract",
        "//crates/store-sqlite:store_sqlite",
    ],
)

# The release's test reads this package's BUILD file to check the tests it names.
exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__", "//deploy/brew:__pkg__"])

# The crate's production sources: the crash report's log catalog reads them, and fails on a test
# file among them.
filegroup(
    name = "report_sources",
    srcs = production_sources(),
    visibility = ["//crates/alondra:__pkg__", "//crates/cli-report:__pkg__"],
)

filegroup(
    name = "launcher_report_sources",
    srcs = glob(["launcher/**/*.rs"]),
    visibility = ["//crates/alondra:__pkg__", "//crates/cli-report:__pkg__", "//crates/cli-report:__pkg__"],
)

repo_tree()
