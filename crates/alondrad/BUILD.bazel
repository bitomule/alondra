load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

exports_files(
    ["src/domain_store/schema.sql", "src/domain_store/schedule_launch_transition.sql"],
    visibility = ["//crates/store:__pkg__", "//crates/agent-application:__pkg__", "//crates/provider-claude:__pkg__", "//crates/agent-runtime:__pkg__"],
)

rust_binary(
    name = "alondrad",
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    compile_data = [
        "Info.plist",
        "src/domain_store/schema.sql",
        "src/domain_store/schedule_launch_transition.sql",
        "src/domain_store/model_metrics.sql",
    ],
    edition = "2024",
    # macOS asks for Local Network access before alondrad may advertise on Bonjour; a
    # standalone executable carries the reason in an embedded Info.plist (TN3179).
    rustc_flags = ["-Clink-arg=-Wl,-sectcreate,__TEXT,__info_plist,$(execpath Info.plist)"],
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + ["//crates/core:alondra_core", "//crates/e2e:alondra_e2e"],
)

# launchd runs this at a fixed path so macOS keeps alondrad's Local Network permission across
# updates; it carries the same Info.plist because the permission prompt shows its reason.
rust_binary(
    name = "alondrad-launcher",
    srcs = ["launcher/main.rs"],
    compile_data = ["Info.plist"],
    crate_root = "launcher/main.rs",
    edition = "2024",
    rustc_flags = ["-Clink-arg=-Wl,-sectcreate,__TEXT,__info_plist,$(execpath Info.plist)"],
    version = "0.1.0",
    visibility = ["//visibility:public"],
)

rust_test(
    name = "launcher_test",
    srcs = ["tests/launcher.rs", "//crates:test_support.rs"],
    crate_root = "tests/launcher.rs",
    data = [":alondrad-launcher"],
    edition = "2024",
    rustc_env = {"CARGO_BIN_EXE_alondrad-launcher": "$(rootpath :alondrad-launcher)"},
    version = "0.1.0",
    deps = all_crate_deps(normal_dev = True),
)

rust_test(
    name = "alondrad_test",
    visibility = ["//apple/Data/Feed:__pkg__", "//apple/Data/Iroh:__pkg__"],
    compile_data = [
        "//crates/core:fixtures/ctrl_trivial_2.jsonl",
        "//crates/core:fixtures/quill.jsonl",
        "//crates/core:src/domain/tests.rs",
        "//fixtures/client-v2",
        "//fixtures/push",
        "//fixtures/workflow",
        "//fixtures/views:all",
        "//fixtures/views:cards",
        "//fixtures/domain-v2:acceptance.json",
    ],
    crate = ":alondrad",
    # Bazel test-setup resolves a relative HOME to this test's TEST_TMPDIR.
    env = {"HOME": "."},
    deps = all_crate_deps(normal_dev = True) + [
        "//crates/domain:domain",
        "//crates/foundation:foundation",
        "//crates/provider-contract:provider_contract",
        "//crates/store:store",
    ],
    data = ["//crates/alondra:alondra", "//fixtures/client-v2", "//fixtures/views:all"],
    edition = "2024",
    rustc_env = {"CARGO_BIN_EXE_alondra": "$(rootpath //crates/alondra:alondra)"},
)

rust_test(
    name = "relaunch_test",
    srcs = ["tests/relaunch.rs"],
    data = [":alondrad"],
    edition = "2024",
    rustc_env = {"CARGO_BIN_EXE_alondrad": "$(rootpath :alondrad)"},
    version = "0.1.0",
    deps = all_crate_deps(normal = True, normal_dev = True) + ["//crates/core:alondra_core"],
)

rust_test(
    name = "info_commands_test",
    srcs = ["tests/info_commands.rs", "//crates:test_support.rs"],
    crate_root = "tests/info_commands.rs",
    data = [":alondrad"],
    edition = "2024",
    rustc_env = {"CARGO_BIN_EXE_alondrad": "$(rootpath :alondrad)"},
    version = "0.1.0",
    deps = all_crate_deps(normal = True, normal_dev = True),
)
