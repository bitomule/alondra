load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

rust_binary(
    name = "alondrad",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["src/domain_store/schema.sql", "src/domain_store/attachments_v2.sql", "src/domain_store/user_targets_v3.sql"],
    edition = "2024",
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + ["//crates/core:alondra_core", "//crates/e2e:alondra_e2e"],
)

rust_test(
    name = "alondrad_test",
    compile_data = [
        "//crates/core:fixtures/ctrl_trivial_2.jsonl",
        "//crates/core:fixtures/quill.jsonl",
    ],
    crate = ":alondrad",
    edition = "2024",
)
