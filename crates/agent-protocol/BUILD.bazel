load("//tools/layers:crates.bzl", "adapter_private_crate")
load("//bazel/rules:tree.bzl", "repo_tree")
load("@crates//:defs.bzl", "all_crate_deps")
load("//bazel/rules:rust_test.bzl", "low_opt_rust_test")
load("//bazel/rules:rust_sources.bzl", "production_sources")

adapter_private_crate(
    name = "agent_protocol",
    srcs = glob(["src/*.rs"]),
    crate_name = "alondra_agent_protocol",
    version = "0.1.0",
    test_visibility = ["//crates/scenarios:__pkg__"],
    deps = all_crate_deps(normal = True) + ["//crates/foundation:foundation"],
)

low_opt_rust_test(
    name = "agent_protocol_test",
    size = "small",
    crate_root = "tests/contract.rs",
    srcs = ["tests/contract.rs"],
    compile_data = glob(["fixtures/*.json"]),
    edition = "2024",
    version = "0.1.0",
    deps = [":agent_protocol", "//crates/foundation:foundation"] + all_crate_deps(normal = True),
)

exports_files(glob(["fixtures/*.json"]))

filegroup(
    name = "wire_fixtures",
    srcs = glob(["fixtures/*.json"]),
    visibility = ["//agent-host:__pkg__"],
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

filegroup(
    name = "transport_sources",
    srcs = ["src/codec.rs", "src/archived_receipts.rs", "src/correlation.rs", "src/json.rs", "src/ownership.rs", "src/schema.rs"],
    visibility = ["//crates/antigravity-protocol:__pkg__", "//crates/codex-protocol:__pkg__"],
)

# The crate's production sources: the crash report's log catalog reads them, and fails on a test
# file among them.
filegroup(
    name = "report_sources",
    srcs = production_sources(),
    visibility = ["//crates/alondra:__pkg__", "//crates/cli-report:__pkg__", "//crates/cli-report:__pkg__"],
)

repo_tree()
