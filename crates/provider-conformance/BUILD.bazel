load("//bazel/rules:tree.bzl", "repo_tree")
load("//bazel/rules:rust_test.bzl", "low_opt_rust_test")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:version.bzl", "VERSION")
load("//bazel/rules:rust_sources.bzl", "production_sources")

# The scenarios every provider adapter must pass. Each provider's own test target runs them through
# its private normalizer: `bazel test //crates/provider-claude:provider_claude_test
# --test_arg=conformance_tests::` (and the same for provider-codex and provider-antigravity) runs
# only the suite.
_DEPS = [
    "//crates/agent-application:agent_application",
    "//crates/domain:domain",
    "//crates/foundation:foundation",
    "//crates/provider-contract:provider_contract",
    "//crates/scenarios-transcript:scenarios_transcript",
    "//crates/store:store",
] + all_crate_deps(normal = True)

_DATA = glob(["transcripts/**/*.jsonl"]) + ["//crates/domain-store-schema:schema.sql"]

rust_library(
    name = "provider_conformance",
    testonly = True,
    srcs = production_sources(),
    compile_data = _DATA,
    crate_name = "alondra_provider_conformance",
    edition = "2024",
    version = VERSION,
    visibility = ["//crates/provider-antigravity:__pkg__", "//crates/provider-claude:__pkg__", "//crates/provider-codex:__pkg__"],
    deps = _DEPS,
)

low_opt_rust_test(
    name = "provider_conformance_test",
    size = "small",
    srcs = glob(["src/**/*.rs"]),
    compile_data = _DATA,
    crate_name = "alondra_provider_conformance",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = VERSION,
    deps = _DEPS + all_crate_deps(normal_dev = True),
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

repo_tree()
