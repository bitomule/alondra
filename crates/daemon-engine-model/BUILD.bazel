load("//tools:rust_test.bzl", "LOW_OPT_LEVEL", "low_opt_rust_test")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:version.bzl", "VERSION")

WORKSPACE_DEPS = [
    "//crates/core:alondra_core",
    "//crates/store:store",
]

rust_library(
    name = "daemon_engine_model",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "alondra_daemon_engine_model",
    edition = "2024",
    version = VERSION,
    visibility = ["//crates:__subpackages__"],
    deps = all_crate_deps(normal = True) + WORKSPACE_DEPS + ["//crates/daemon-support:daemon_support"],
)

rust_library(
    name = "daemon_engine_model_test_hooks",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["test-hooks"],
    crate_name = "alondra_daemon_engine_model",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_flags = [LOW_OPT_LEVEL],
    version = VERSION,
    visibility = ["//crates/daemon-engine:__pkg__", "//crates/daemon-engine-store:__pkg__"],
    deps = all_crate_deps(normal = True) + WORKSPACE_DEPS + ["//crates/daemon-support:daemon_support_test_hooks"],
)

low_opt_rust_test(
    name = "daemon_engine_model_test",
    size = "small",
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    crate_name = "alondra_daemon_engine_model",
    crate_root = "src/lib.rs",
    edition = "2024",
    env = {"HOME": "."},
    version = VERSION,
    deps = all_crate_deps(normal = True, normal_dev = True) + WORKSPACE_DEPS + ["//crates/daemon-support:daemon_support"],
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

filegroup(
    name = "report_sources",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//crates/alondra:__pkg__", "//crates/alondrad:__pkg__"],
)
