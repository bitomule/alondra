load("//tools:tree.bzl", "repo_tree")
load("//tools:rust_test.bzl", "LOW_OPT_LEVEL", "low_opt_rust_test")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:version.bzl", "VERSION")
load("//tools:rust_sources.bzl", "production_sources")
load("//tools:rust_inputs_test.bzl", "rust_inputs_test")

WORKSPACE_DEPS = [
    "//crates/core:alondra_core", "//crates/domain-rules:domain_rules",
    "//crates/store:store",
]

rust_library(
    name = "daemon_engine_model",
    srcs = production_sources(test_only = ["src/faults.rs"]),
    crate_name = "alondra_daemon_engine_model",
    edition = "2024",
    version = VERSION,
    visibility = ["//crates:__subpackages__"],
    deps = all_crate_deps(normal = True) + WORKSPACE_DEPS + ["//crates/daemon-support:daemon_support"],
)

rust_library(
    name = "daemon_engine_model_test_hooks",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["test-hooks"],
    crate_name = "alondra_daemon_engine_model",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_flags = [LOW_OPT_LEVEL],
    version = VERSION,
    visibility = ["//crates/engine-sdk:__pkg__", "//crates/daemon-engine:__pkg__", "//crates/engine-admission:__pkg__", "//crates/engine-github:__pkg__", "//crates/engine-kernel:__pkg__", "//crates/engine-orchestrator:__pkg__", "//crates/daemon-engine-machine:__pkg__", "//crates/daemon-engine-store:__pkg__"],
    deps = all_crate_deps(normal = True) + WORKSPACE_DEPS + ["//crates/daemon-support:daemon_support_test_hooks"],
)

low_opt_rust_test(
    name = "daemon_engine_model_test",
    size = "small",
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    crate_name = "alondra_daemon_engine_model",
    crate_root = "src/lib.rs",
    edition = "2024",
    env = {"HOME": "."},
    version = VERSION,
    deps = all_crate_deps(normal = True, normal_dev = True) + WORKSPACE_DEPS + ["//crates/daemon-support:daemon_support"],
)

# The library compiles only production sources: a test file among its inputs would rebuild every
# crate above it whenever the test changes.
rust_inputs_test(
    name = "production_inputs_test",
    size = "small",
    required_sources = ["crates/daemon-engine-model/src/lib.rs"],
    source_dir = "crates/daemon-engine-model/src/",
    target_under_test = ":daemon_engine_model",
    test_only_sources = ["crates/daemon-engine-model/src/faults.rs"],
    test_sources = False,
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

filegroup(
    name = "report_sources",
    srcs = production_sources(test_only = ["src/faults.rs"]),
    visibility = ["//crates/alondra:__pkg__", "//crates/alondrad:__pkg__"],
)

repo_tree()
