load("//tools/layers:crates.bzl", "application_crate")
load("//bazel/rules:tree.bzl", "repo_tree")
load("//bazel/rules:rust_test.bzl", "low_opt_rust_test")
load("@crates//:defs.bzl", "all_crate_deps")
load("//:version.bzl", "VERSION")
load("//bazel/rules:rust_sources.bzl", "production_sources")
load("//bazel/rules:rust_inputs_test.bzl", "rust_inputs_test")

WORKSPACE_DEPS = [
    "//crates/engine-ports:engine_ports",
    "//crates/core:alondra_core", "//crates/domain-rules:domain_rules",
    "//crates/store:store",
]

application_crate(
    name = "daemon_engine_model",
    srcs = production_sources(),
    crate_name = "alondra_daemon_engine_model",
    version = VERSION,
    deps = all_crate_deps(normal = True) + WORKSPACE_DEPS + ["//crates/daemon-support:daemon_support"],
    test_visibility = ["//crates/daemon-server:__pkg__"],
)

low_opt_rust_test(
    name = "daemon_engine_model_test",
    size = "small",
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    crate_name = "alondra_daemon_engine_model",
    crate_root = "src/lib.rs",
    edition = "2024",
    env = {"HOME": "."},
    version = VERSION,
    deps = all_crate_deps(normal = True, normal_dev = True) + WORKSPACE_DEPS + ["//crates/daemon-support:daemon_support"],
)

# The library compiles only production sources: a test file among its inputs would rebuild every
# crate above it whenever the test changes.
rust_inputs_test(
    name = "production_inputs_test",
    size = "small",
    required_sources = ["crates/daemon-engine-model/src/lib.rs"],
    source_dir = "crates/daemon-engine-model/src/",
    target_under_test = ":daemon_engine_model",
    test_sources = False,
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

filegroup(
    name = "report_sources",
    srcs = production_sources(),
    visibility = ["//crates/alondra:__pkg__", "//crates/cli-report:__pkg__", "//crates/alondrad:__pkg__", "//crates/daemon-server:__pkg__"],
)

repo_tree()
