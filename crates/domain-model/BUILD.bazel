load("//tools/layers:crates.bzl", "domain_crate")
load("//bazel/rules:tree.bzl", "repo_tree")
load("@crates//:defs.bzl", "all_crate_deps")
load("//bazel/rules:rust_test.bzl", "low_opt_rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc_test")
load("//bazel/rules:rust.bzl", "rust_binary")
load("//bazel/rules:rust_sources.bzl", "production_sources")
load("//bazel/rules:rust_inputs_test.bzl", "rust_inputs_test")

DOMAIN_MODEL_DEPS = all_crate_deps(normal = True) + [
    "//crates/core:alondra_core",
    "//crates/domain:domain",
    "//crates/foundation:foundation",
    "//crates/spec-engine:spec_engine",
]

# The domain's state, its reads and the guards every screen shares. What a command changes lives in
# //crates/domain-rules, behind the `DomainRules` port.
domain_crate(
    name = "domain_model",
    srcs = production_sources(),
    crate_name = "alondra_domain_model",
    version = "0.1.0",
    test_visibility = ["//crates/engine-doubles:__pkg__", "//crates/machine-model:__pkg__"],
    deps = DOMAIN_MODEL_DEPS,
)

# The lifecycle authority cannot be cloned, deserialized or made from the Task DTO.
rust_doc_test(
    name = "lifecycle_construction_test",
    size = "small",
    crate = ":domain_model",
    deps = ["//crates/domain:domain", "@crates//:serde_json"],
)

low_opt_rust_test(
    name = "domain_model_test",
    timeout = "moderate",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "alondra_domain_model",
    crate_root = "src/lib.rs",
    deps = DOMAIN_MODEL_DEPS + all_crate_deps(normal_dev = True),
    edition = "2024",
    version = "0.1.0",
)

# Opt-in profiling driver; ordinary tests do not execute it.
rust_binary(
    name = "read_index_cost",
    testonly = True,
    srcs = ["benches/read_index_cost.rs", "benches/inbox_graphs.rs", "benches/read_index.rs"],
    edition = "2024",
    deps = [":domain_model", "//crates/domain-rules:domain_rules", "@crates//:libc"] + all_crate_deps(normal = True),
)

low_opt_rust_test(
    name = "read_index_cost_test",
    size = "small",
    crate_root = "benches/read_index_cost.rs",
    srcs = ["benches/read_index_cost.rs", "benches/inbox_graphs.rs", "benches/read_index.rs"],
    edition = "2024",
    deps = [":domain_model", "//crates/domain-rules:domain_rules", "@crates//:libc"] + all_crate_deps(normal = True),
)

# The library compiles only production sources: a test file among its inputs would rebuild every
# crate above it whenever the test changes.
rust_inputs_test(
    name = "production_inputs_test",
    size = "small",
    required_sources = ["crates/domain-model/src/lib.rs", "crates/domain-model/src/checks.rs"],
    source_dir = "crates/domain-model/src/",
    target_under_test = ":domain_model",
    test_sources = False,
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

# The crate's production sources: the crash report's log catalog reads them, and fails on a test
# file among them.
filegroup(
    name = "report_sources",
    srcs = production_sources(),
    visibility = ["//crates/alondra:__pkg__", "//crates/cli-report:__pkg__", "//crates/cli-report:__pkg__", "//crates/views:__pkg__"],
)

# The sources the rules' tests scan with theirs: the refusal catalog against every code a guard or a
# rule produces, and the identity of a pull request against any provider's name.
filegroup(
    name = "scanned_sources",
    srcs = [
        "src/checklist.rs",
        "src/delivery_validation.rs",
        "src/checks.rs",
        "src/checks/open_pr.rs",
        "src/checks/plan_review.rs",
        "src/checks/pr_identity.rs",
        "src/checks/spec_rules.rs",
        "src/pr_identity.rs",
        "src/stage_rules.rs",
        "src/stages.rs",
    ],
    visibility = ["//crates/domain-rules:__pkg__"],
)

repo_tree()
