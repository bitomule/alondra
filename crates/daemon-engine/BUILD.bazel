load("//tools/bazel:crates.bzl", "application_crate")
load("//tools:tree.bzl", "repo_tree")
load("//tools:rust_inputs_test.bzl", "rust_inputs_test")
load("//tools:rust_test.bzl", "LOW_OPT_LEVEL", "low_opt_rust_test")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:version.bzl", "VERSION")
load("//tools:rust_sources.bzl", "production_sources")

WORKSPACE_DEPS = [
    "//crates/agent-application:agent_application",
    "//crates/agent-runtime:agent_runtime",
    "//crates/core:alondra_core", "//crates/domain-rules:domain_rules", "//crates/view-model:view_model",
    "//crates/domain:domain",
    "//crates/foundation:foundation",
    "//crates/process-group:process_group",
    "//crates/provider-claude:provider_claude",
    "//crates/provider-codex:provider_codex",
    "//crates/provider-contract:provider_contract",
    "//crates/store:store",
]

application_crate(
    name = "daemon_engine",
    srcs = production_sources(test_only = ["src/host_fixtures.rs", "src/machine_hooks.rs"]),
    crate_name = "alondra_daemon_engine",
    version = VERSION,
    deps = all_crate_deps(normal = True) + WORKSPACE_DEPS + [
        "//crates/daemon-engine-model:daemon_engine_model",
        "//crates/daemon-engine-store:daemon_engine_store",
        "//crates/daemon-engine-machine:daemon_engine_machine",
        "//crates/daemon-support:daemon_support",
        "//crates/engine-github:engine_github",
        "//crates/engine-live:engine_live",
        "//crates/engine-mcp:engine_mcp",
        "//crates/engine-worktrees:engine_worktrees",
        "//crates/engine-kernel:engine_kernel",
    ],
)

# alondrad's unit tests build against the hooks and fixtures its tests drive: a store that traces
# its reads, an SDK slice with a fake native Claude, a fake GitHub.
rust_library(
    name = "daemon_engine_test_hooks",
    testonly = True,
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    crate_features = ["test-hooks"],
    crate_name = "alondra_daemon_engine",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_flags = [LOW_OPT_LEVEL],
    version = VERSION,
    visibility = ["//crates/alondrad:__pkg__", "//crates/engine-admission:__pkg__", "//crates/engine-orchestrator:__pkg__", "//crates/engine-sdk:__pkg__", "//crates/machine-model:__pkg__", "//crates/scenarios:__pkg__"],
    deps = all_crate_deps(normal = True, normal_dev = True) + WORKSPACE_DEPS + [
        "//crates/codex-protocol:codex_protocol",
        "//crates/daemon-engine-model:daemon_engine_model_test_hooks",
        "//crates/daemon-engine-store:daemon_engine_store_test_hooks",
        "//crates/daemon-engine-machine:daemon_engine_machine_test_hooks",
        "//crates/daemon-support:daemon_support_test_hooks",
        "//crates/engine-github:engine_github_test_hooks",
        "//crates/engine-live:engine_live_test_hooks",
        "//crates/engine-mcp:engine_mcp_test_hooks",
        "//crates/engine-worktrees:engine_worktrees_test_hooks",
        "//crates/engine-kernel:engine_kernel_test_hooks",
    ],
)

ENGINE_TEST_SRCS = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"]

ENGINE_TEST_COMPILE_DATA = [
    "//fixtures/client-v2",
    "//fixtures/accounts:recorded-rows.json",
    "//fixtures/domain-v2:acceptance.json",
]

ENGINE_TEST_DEPS = all_crate_deps(normal = True, normal_dev = True) + WORKSPACE_DEPS + [
    "//crates/views:views",
    "//crates/codex-protocol:codex_protocol",
    "//crates/daemon-engine-model:daemon_engine_model_test_hooks",
    "//crates/daemon-engine-store:daemon_engine_store_test_hooks",
    "//crates/daemon-engine-machine:daemon_engine_machine_test_hooks",
    "//crates/daemon-support:daemon_support_test_hooks",
    "//crates/engine-github:engine_github_test_hooks",
    "//crates/engine-live:engine_live_test_hooks",
    "//crates/engine-mcp:engine_mcp_test_hooks",
    "//crates/engine-worktrees:engine_worktrees_test_hooks",
    "//crates/engine-kernel:engine_kernel_test_hooks",
]

# The engine's one test target. A few of its tests start the pinned Agent SDK host with a fake
# native Claude, whose paths they read from FIXTURE_* variables; the ones that need the SDK's
# owners, alondra or alondrad run with the crates above it.
low_opt_rust_test(
    name = "daemon_engine_test",
    size = "medium",
    srcs = ENGINE_TEST_SRCS,
    compile_data = ENGINE_TEST_COMPILE_DATA,
    crate_name = "alondra_daemon_engine",
    crate_root = "src/lib.rs",
    data = [
        "//agent-host:alondra-host",
        "//agent-host:persistent-fake-claude.py",
    ],
    edition = "2024",
    # Bazel test-setup resolves a relative HOME to this test's TEST_TMPDIR.
    env = {
        "FIXTURE_HOST": "$(rootpath //agent-host:alondra-host)",
        "FIXTURE_NATIVE": "$(rootpath //agent-host:persistent-fake-claude.py)",
        "FIXTURE_NODE": "$(rootpath //agent-host:alondra-host)",
        "HOME": ".",
    },
    version = VERSION,
    deps = ENGINE_TEST_DEPS,
)

rust_inputs_test(
    name = "production_inputs_test",
    size = "small",
    required_sources = ["crates/daemon-engine/src/lib.rs", "crates/daemon-engine/src/wiring.rs"],
    source_dir = "crates/daemon-engine/src/",
    target_under_test = ":daemon_engine",
    test_only_sources = ["crates/daemon-engine/src/host_fixtures.rs", "crates/daemon-engine/src/machine_hooks.rs", "crates/daemon-engine/src/wiring/owner_tests.rs", "crates/test_support.rs"],
    test_sources = False,
)

rust_inputs_test(
    name = "test_hooks_inputs_test",
    size = "small",
    required_sources = ["crates/daemon-engine/src/lib.rs", "crates/daemon-engine/src/wiring.rs"],
    source_dir = "crates/daemon-engine/src/",
    target_under_test = ":daemon_engine_test_hooks",
    test_only_sources = ["crates/daemon-engine/src/host_fixtures.rs", "crates/daemon-engine/src/machine_hooks.rs", "crates/daemon-engine/src/wiring/owner_tests.rs", "crates/test_support.rs"],
    test_sources = True,
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

# The crate's production sources: the crash report's log catalog reads them, and fails on a test
# file among them; alondrad's lock policy test reads them too.
filegroup(
    name = "report_sources",
    srcs = production_sources(test_only = ["src/host_fixtures.rs", "src/machine_hooks.rs"]),
    visibility = ["//crates/alondra:__pkg__", "//crates/alondrad:__pkg__"],
)

repo_tree()
