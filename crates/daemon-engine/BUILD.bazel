load("//tools/layers:crates.bzl", "application_crate")
load("//bazel/rules:tree.bzl", "repo_tree")
load("//bazel/rules:rust_inputs_test.bzl", "rust_inputs_test")
load("//bazel/rules:rust_test.bzl", "low_opt_rust_test")
load("@crates//:defs.bzl", "all_crate_deps")
load("//:version.bzl", "VERSION")
load("//bazel/rules:rust_sources.bzl", "production_sources")

WORKSPACE_DEPS = [
    "//crates/engine-ports:engine_ports",
    "//crates/agent-application:agent_application",
    "//crates/core:alondra_core", "//crates/domain-model:domain_model", "//crates/view-model:view_model",
    "//crates/domain:domain",
    "//crates/foundation:foundation",
    "//crates/host:host",
    "//crates/process-group:process_group",
    "//crates/provider-claude:provider_claude",
    "//crates/provider-codex:provider_codex",
    "//crates/provider-contract:provider_contract",
    "//crates/store:store",
]

application_crate(
    name = "daemon_engine",
    srcs = production_sources(test_only = ["src/wiring/owner_fixtures.rs"]) + ["//crates:test_support.rs"],
    crate_name = "alondra_daemon_engine",
    version = VERSION,
    test_visibility = ["//crates/engine-sdk:__pkg__", "//crates/machine-model:__pkg__"],
    deps = all_crate_deps(normal = True) + WORKSPACE_DEPS + [
        "//crates/daemon-engine-model:daemon_engine_model",
        "//crates/daemon-engine-machine:daemon_engine_machine",
        "//crates/daemon-support:daemon_support",
        "//crates/engine-github:engine_github",
        "//crates/engine-live:engine_live",
        "//crates/engine-mcp:engine_mcp",
        "//crates/engine-worktrees:engine_worktrees",
        "//crates/engine-kernel:engine_kernel",
    ],
)

ENGINE_TEST_SRCS = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"]

ENGINE_TEST_COMPILE_DATA = [
    "//fixtures/client-v2",
    "//fixtures/accounts:recorded-rows.json",
    "//fixtures/domain-v2:acceptance.json",
]

ENGINE_TEST_DEPS = all_crate_deps(normal = True, normal_dev = True) + WORKSPACE_DEPS + ["//crates/agent-runtime:agent_runtime"] + [
    "//crates/codex-protocol:codex_protocol",
    "//crates/provider-antigravity:provider_antigravity",
    "//crates/daemon-engine-model:daemon_engine_model",
    "//crates/store-sqlite:store_sqlite",
    "//crates/daemon-engine-machine:daemon_engine_machine",
    "//crates/daemon-support:daemon_support",
    "//crates/engine-doubles:engine_doubles",
    "//crates/engine-github:engine_github",
    "//crates/engine-live:engine_live",
    "//crates/engine-mcp:engine_mcp",
    "//crates/engine-worktrees:engine_worktrees",
    "//crates/engine-kernel:engine_kernel",
]

# The engine's one test target. A few of its tests start the pinned Agent SDK host with a fake
# native Claude, whose paths they read from FIXTURE_* variables; the ones that need the SDK's
# owners, alondra or alondrad run with the crates above it.
low_opt_rust_test(
    name = "daemon_engine_test",
    size = "medium",
    srcs = ENGINE_TEST_SRCS,
    compile_data = ENGINE_TEST_COMPILE_DATA,
    crate_name = "alondra_daemon_engine",
    crate_root = "src/lib.rs",
    data = [
        "//agent-host:alondra-host",
        "//agent-host:persistent-fake-claude.py",
    ],
    edition = "2024",
    # Bazel test-setup resolves a relative HOME to this test's TEST_TMPDIR.
    env = {
        "FIXTURE_HOST": "$(rootpath //agent-host:alondra-host)",
        "FIXTURE_NATIVE": "$(rootpath //agent-host:persistent-fake-claude.py)",
        "FIXTURE_NODE": "$(rootpath //agent-host:alondra-host)",
        "HOME": ".",
        "TEST_EXECS": "$(rootpath //agent-host:alondra-host) /bin/cat /bin/ls /bin/rm /bin/sh /usr/bin/git /usr/bin/id /usr/bin/python3 tmpdir",
    },
    version = VERSION,
    deps = ENGINE_TEST_DEPS,
)

rust_inputs_test(
    name = "production_inputs_test",
    size = "small",
    required_sources = ["crates/daemon-engine/src/lib.rs", "crates/daemon-engine/src/wiring.rs"],
    source_dir = "crates/daemon-engine/src/",
    target_under_test = ":daemon_engine",
    fixture_sources = ["crates/test_support.rs"],
    test_only_sources = ["crates/daemon-engine/src/wiring/owner_tests.rs", "crates/daemon-engine/src/wiring/owner_fixtures.rs"],
    test_sources = False,
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

# The SQLite-backed fixtures of an SDK node's owner, which the tests of the crates above include.
exports_files(["src/wiring/owner_fixtures.rs"], visibility = ["//crates/daemon-server:__pkg__", "//crates/engine-sdk:__pkg__"])

# The crate's production sources: the crash report's log catalog reads them, and fails on a test
# file among them; alondrad's lock policy test reads them too.
filegroup(
    name = "report_sources",
    srcs = production_sources(test_only = ["src/wiring/owner_fixtures.rs"]),
    visibility = ["//crates/alondra:__pkg__", "//crates/cli-report:__pkg__", "//crates/alondrad:__pkg__", "//crates/daemon-server:__pkg__"],
)

repo_tree()
