load("//tools/layers:crates.bzl", "adapter_out_crate")
load("//bazel/rules:tree.bzl", "repo_tree")
load("@crates//:defs.bzl", "all_crate_deps")
load("//bazel/rules:rust_test.bzl", "low_opt_rust_test")
load("@rules_rust//rust:defs.bzl", "rust_binary")
load("//bazel/rules:rust_sources.bzl", "production_sources")
load("//bazel/rules:rust_inputs_test.bzl", "rust_inputs_test")

RUNTIME_DEPS = ["//crates/engine-ports:engine_ports", "//crates/foundation:foundation", "//crates/process-group:process_group", "//crates/store:store"] + all_crate_deps(normal = True)

adapter_out_crate(
    name = "agent_runtime",
    srcs = production_sources(),
    crate_name = "alondra_agent_runtime",
    test_visibility = ["//crates/daemon-engine:__pkg__", "//crates/engine-orchestrator:__pkg__", "//crates/engine-sdk:__pkg__", "//crates/provider-claude:__pkg__", "//crates/daemon-server:__pkg__"],
    version = "0.1.0",
    deps = RUNTIME_DEPS,
)

low_opt_rust_test(
    name = "readiness_test",
    env = {"TEST_EXECS": "/bin/cat /usr/bin/true"},
    size = "small",
    srcs = glob(["src/**/*.rs"]) + ["tests/connect.rs", "//crates:test_support.rs"],
    crate_name = "alondra_agent_runtime",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    deps = RUNTIME_DEPS + all_crate_deps(normal_dev = True),
)


rust_binary(
    name = "owned_host_fixture",
    testonly = True,
    crate_root = "tests/fixtures/owned_host.rs",
    srcs = ["tests/fixtures/owned_host.rs", "tests/support/mod.rs", "//crates:test_support.rs"],
    compile_data = ["//crates/domain-store-schema:schema.sql"],
    edition = "2024",
    deps = [":agent_runtime", "//crates/domain:domain", "//crates/foundation:foundation", "//crates/provider-contract:provider_contract", "//crates/store:store"] + all_crate_deps(normal = True, normal_dev = True),
)
low_opt_rust_test(
    name = "owned_host_test",
    # 29 s of tests, 37 s whole, run alone with the Mac's load average at 208; in a full queue at load
    # 253 it got through 4 of the 17 tests in 62 s. 300 s is over three times that worst reading.
    timeout = "moderate",
    crate_root = "tests/owned_host.rs",
    srcs = ["tests/owned_host.rs", "tests/support/mod.rs", "//crates:test_support.rs"],
    compile_data = ["//crates/domain-store-schema:schema.sql"],
    data = [":owned_host_fixture"],
    # Every test spawns processes and asserts on kernel locks: run in parallel in one process, a
    # spawn in one test copies, for an instant, the locked descriptor of another into its child.
    env = {"HOME": ".", "ALONDRA_OWNED_HOST_FIXTURE": "$(rootpath :owned_host_fixture)", "RUST_TEST_THREADS": "1", "TEST_EXECS": "own-sandbox"},
    edition = "2024",
    deps = [":agent_runtime", "//crates/engine-doubles:engine_doubles", "//crates/process-group:process_group", "//crates/domain:domain", "//crates/foundation:foundation", "//crates/provider-contract:provider_contract", "//crates/store:store"] + all_crate_deps(normal = True, normal_dev = True),
)

# The library compiles only production sources: a test file among its inputs would rebuild every
# crate above it whenever the test changes.
rust_inputs_test(
    name = "production_inputs_test",
    size = "small",
    required_sources = ["crates/agent-runtime/src/lib.rs"],
    source_dir = "crates/agent-runtime/src/",
    target_under_test = ":agent_runtime",
    test_only_sources = ["crates/agent-runtime/tests/connect.rs", "crates/test_support.rs"],
    test_sources = False,
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

# The crate's production sources: the crash report's log catalog reads them, and fails on a test
# file among them.
filegroup(
    name = "report_sources",
    srcs = production_sources(),
    visibility = ["//crates/alondra:__pkg__", "//crates/cli-report:__pkg__", "//crates/cli-report:__pkg__"],
)

repo_tree()
