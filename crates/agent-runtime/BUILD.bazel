load("@crates//:defs.bzl", "all_crate_deps")
load("//tools:rust_test.bzl", "low_opt_rust_test")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")

rust_library(
    name = "agent_runtime",
    srcs = glob(["src/**/*.rs"]) + ["tests/connect.rs", "//crates:test_support.rs"],
    crate_name = "alondra_agent_runtime",
    edition = "2024",
    version = "0.1.0",
    visibility = ["//crates:__subpackages__"],
    deps = ["//crates/process-group:process_group", "//crates/store:store"] + all_crate_deps(normal = True),
)

low_opt_rust_test(
    name = "readiness_test",
    crate = ":agent_runtime",
    edition = "2024",
    deps = all_crate_deps(normal_dev = True),
)


rust_binary(
    name = "owned_host_fixture",
    crate_root = "tests/fixtures/owned_host.rs",
    srcs = ["tests/fixtures/owned_host.rs", "tests/support/mod.rs", "//crates:test_support.rs"],
    compile_data = ["//crates/alondrad:src/domain_store/schema.sql"],
    edition = "2024",
    deps = [":agent_runtime", "//crates/domain:domain", "//crates/foundation:foundation", "//crates/provider-contract:provider_contract", "//crates/store:store"] + all_crate_deps(normal = True, normal_dev = True),
)
low_opt_rust_test(
    name = "owned_host_test",
    crate_root = "tests/owned_host.rs",
    srcs = ["tests/owned_host.rs", "tests/support/mod.rs", "//crates:test_support.rs"],
    compile_data = ["//crates/alondrad:src/domain_store/schema.sql"],
    data = [":owned_host_fixture"],
    # Every test spawns processes and asserts on kernel locks: run in parallel in one process, a
    # spawn in one test copies, for an instant, the locked descriptor of another into its child.
    env = {"HOME": ".", "ALONDRA_OWNED_HOST_FIXTURE": "$(rootpath :owned_host_fixture)", "RUST_TEST_THREADS": "1"},
    edition = "2024",
    deps = [":agent_runtime", "//crates/process-group:process_group", "//crates/domain:domain", "//crates/foundation:foundation", "//crates/provider-contract:provider_contract", "//crates/store:store"] + all_crate_deps(normal = True, normal_dev = True),
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

# Read by the crash report's build script for its log catalog and the words of the code.
filegroup(
    name = "report_sources",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//crates/alondra:__pkg__"],
)
