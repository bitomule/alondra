load(":build_inputs_test.bzl", "rust_inputs_test")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

_PROVIDER_SOURCES = glob(["src/*.rs"], exclude = ["src/*_tests.rs"])
_PROVIDER_TEST_SOURCES = _PROVIDER_SOURCES + [
    "src/controller_tests.rs",
    "src/facade_tests.rs",
    "src/ended_tests.rs",
    "//crates:test_support.rs",
    "//crates/agent-application:tests/support/controller.rs",
]

_PROVIDER_DEPS = [
    "//crates/agent-protocol:agent_protocol",
    "//crates/agent-runtime:agent_runtime",
    "//crates/agent-application:agent_application",
    "//crates/provider-contract:provider_contract",
    "//crates/foundation:foundation",
    "//crates/store:store",
] + all_crate_deps(normal = True)

rust_library(
    name = "provider_claude",
    srcs = _PROVIDER_SOURCES,
    crate_name = "alondra_provider_claude",
    edition = "2024",
    version = "0.1.0",
    visibility = ["//crates:__subpackages__"],
    deps = _PROVIDER_DEPS,
)

rust_test(
    name = "provider_claude_test",
    crate_root = "src/lib.rs",
    srcs = _PROVIDER_TEST_SOURCES,
    crate_name = "alondra_provider_claude",
    version = "0.1.0",
    compile_data = ["//crates/agent-protocol:fixtures/hello.json", "//crates/alondrad:src/domain_store/schema.sql"],
    deps = _PROVIDER_DEPS + ["//crates/domain:domain"] + all_crate_deps(normal_dev = True),
    edition = "2024",
    env = {"HOME": "."},
)

rust_test(
    name = "sdk_worker_test",
    crate_root = "src/lib.rs",
    srcs = _PROVIDER_TEST_SOURCES + ["src/sdk_tests.rs"],
    crate_name = "alondra_provider_claude",
    version = "0.1.0",
    crate_features = ["sdk_fixture"],
    edition = "2024",
    deps = _PROVIDER_DEPS + ["//crates/domain:domain"] + all_crate_deps(normal_dev = True),
    compile_data = [
        "//crates/alondrad:src/domain_store/schema.sql",
        "//crates/agent-protocol:fixtures/hello.json",
    ],
    data = [
        "//agent-host:pinned_node",
        "//agent-host:persistent.cjs",
        "//agent-host:persistent-fake-claude.py",
    ],
    env = {
        "HOME": ".",
        "FIXTURE_NODE": "$(rootpath //agent-host:pinned_node)",
        "FIXTURE_HOST": "$(rootpath //agent-host:persistent.cjs)",
        "FIXTURE_NATIVE": "$(rootpath //agent-host:persistent-fake-claude.py)",
    },
)

rust_doc_test(
    name = "owner_facade_test",
    crate = ":provider_claude",
)

rust_inputs_test(
    name = "production_inputs_test",
    target_under_test = ":provider_claude",
    test_kind = "production",
)

rust_inputs_test(
    name = "component_inputs_test",
    target_under_test = ":provider_claude_test",
    test_kind = "component",
)

rust_inputs_test(
    name = "sdk_inputs_test",
    target_under_test = ":sdk_worker_test",
    test_kind = "sdk",
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

# Read by the crash report's build script for its log catalog and the words of the code.
filegroup(
    name = "report_sources",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//crates/alondra:__pkg__"],
)
