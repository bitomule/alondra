load("//tools/bazel:crates.bzl", "adapter_out_crate")
load("//tools:tree.bzl", "repo_tree")
load(":build_inputs_test.bzl", "rust_inputs_test")
load("//tools:rust_test.bzl", "low_opt_rust_test")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test")
load("//tools:rust_sources.bzl", "production_sources")

_PROVIDER_SOURCES = glob(["src/*.rs"], exclude = ["src/*_tests.rs"])
_PROVIDER_TEST_SOURCES = _PROVIDER_SOURCES + [
    "src/controller_tests.rs",
    "src/facade_tests.rs",
    "src/ended_tests.rs",
    "src/archive_tests.rs",
    "src/ported_transcript_tests.rs",
    "src/conformance_tests.rs",
    "//crates:test_support.rs",
    "//crates/agent-application:tests/support/controller.rs",
]

_PROVIDER_DEPS = [
    "//crates/agent-protocol:agent_protocol",
    "//crates/engine-ports:engine_ports",
    "//crates/agent-application:agent_application",
    "//crates/provider-contract:provider_contract",
    "//crates/foundation:foundation",
    "//crates/store:store",
] + all_crate_deps(normal = True)

adapter_out_crate(
    name = "provider_claude",
    srcs = _PROVIDER_SOURCES,
    crate_name = "alondra_provider_claude",
    version = "0.1.0",
    deps = _PROVIDER_DEPS,
    test_visibility = ["//crates/daemon-server:__pkg__"],
)

low_opt_rust_test(
    name = "provider_claude_test",
    size = "small",
    crate_root = "src/lib.rs",
    srcs = _PROVIDER_TEST_SOURCES,
    crate_name = "alondra_provider_claude",
    version = "0.1.0",
    compile_data = ["//crates/agent-protocol:fixtures/hello.json", "//crates/domain-store-schema:schema.sql", "//fixtures/transcripts"] + glob(["fixtures/native/*.jsonl"]),
    deps = _PROVIDER_DEPS + ["//crates/domain:domain", "//crates/scenarios-transcript:scenarios_transcript", "//crates/provider-conformance:provider_conformance"] + all_crate_deps(normal_dev = True),
    edition = "2024",
    env = {"HOME": "."},
)

low_opt_rust_test(
    name = "sdk_worker_test",
    size = "small",
    crate_root = "src/lib.rs",
    srcs = _PROVIDER_TEST_SOURCES + ["src/sdk_tests.rs"],
    crate_name = "alondra_provider_claude",
    version = "0.1.0",
    crate_features = ["sdk_fixture"],
    edition = "2024",
    deps = _PROVIDER_DEPS + ["//crates/agent-runtime:agent_runtime", "//crates/domain:domain", "//crates/scenarios-transcript:scenarios_transcript", "//crates/provider-conformance:provider_conformance"] + all_crate_deps(normal_dev = True),
    compile_data = [
        "//crates/domain-store-schema:schema.sql",
        "//crates/agent-protocol:fixtures/hello.json",
        "//fixtures/transcripts",
    ],
    data = [
        "//agent-host:pinned_node",
        "//agent-host:persistent.cjs",
        "//agent-host:persistent-fake-claude.py",
    ],
    env = {
        "HOME": ".",
        "FIXTURE_NODE": "$(rootpath //agent-host:pinned_node)",
        "FIXTURE_HOST": "$(rootpath //agent-host:persistent.cjs)",
        "FIXTURE_NATIVE": "$(rootpath //agent-host:persistent-fake-claude.py)",
    },
)

rust_doc_test(
    name = "owner_facade_test",
    size = "small",
    crate = ":provider_claude",
)

rust_inputs_test(
    name = "production_inputs_test",
    size = "small",
    target_under_test = ":provider_claude",
    test_kind = "production",
)

rust_inputs_test(
    name = "component_inputs_test",
    size = "small",
    target_under_test = ":provider_claude_test",
    test_kind = "component",
)

rust_inputs_test(
    name = "sdk_inputs_test",
    size = "small",
    target_under_test = ":sdk_worker_test",
    test_kind = "sdk",
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])
exports_files(["src/archive_tests.rs"], visibility = ["//crates/provider-codex:__pkg__"])

# The crate's production sources: the crash report's log catalog reads them, and fails on a test
# file among them.
filegroup(
    name = "report_sources",
    srcs = production_sources(),
    visibility = ["//crates/alondra:__pkg__", "//crates/cli-report:__pkg__", "//crates/cli-report:__pkg__"],
)

repo_tree()
