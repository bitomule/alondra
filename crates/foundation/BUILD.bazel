load("//tools/bazel:crates.bzl", "foundation_crate")
load("//tools:tree.bzl", "repo_tree")
load("@crates//:defs.bzl", "all_crate_deps")
load("//tools:rust_test.bzl", "low_opt_rust_test")
load("//tools:rust_sources.bzl", "production_sources")

foundation_crate(
    name = "foundation",
    srcs = production_sources(),
    crate_name = "alondra_foundation",
    version = "0.1.0",
    test_visibility = ["//crates/machine-model:__pkg__", "//crates/provider-conformance:__pkg__"],
    deps = all_crate_deps(normal = True),
)

low_opt_rust_test(
    name = "foundation_unit_test",
    size = "small",
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    crate_name = "alondra_foundation",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    deps = all_crate_deps(normal = True, normal_dev = True),
)

low_opt_rust_test(
    name = "foundation_test",
    size = "small",
    crate_root = "tests/wire.rs",
    srcs = ["tests/wire.rs"],
    edition = "2024",
    version = "0.1.0",
    deps = [":foundation"] + all_crate_deps(normal_dev = True),
)

low_opt_rust_test(
    name = "execution_identity_test",
    size = "small",
    crate_root = "tests/execution.rs",
    srcs = ["tests/execution.rs"],
    edition = "2024",
    deps = [":foundation"],
)

low_opt_rust_test(
    name = "message_uuid_test",
    size = "small",
    crate_root = "tests/message_uuid.rs",
    srcs = ["tests/message_uuid.rs"],
    edition = "2024",
    deps = [":foundation"] + all_crate_deps(normal_dev = True),
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

# The crate's production sources: the crash report's log catalog reads them, and fails on a test
# file among them.
filegroup(
    name = "report_sources",
    srcs = production_sources(),
    visibility = ["//crates/alondra:__pkg__"],
)

repo_tree()
