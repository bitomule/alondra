load("@crates//:defs.bzl", "all_crate_deps")
load("//tools:rust_test.bzl", "low_opt_rust_test")
load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "foundation",
    srcs = ["src/lib.rs", "src/execution.rs", "src/mcp.rs"],
    crate_name = "alondra_foundation",
    edition = "2024",
    version = "0.1.0",
    visibility = ["//crates:__subpackages__", "//tests:__subpackages__"],
    deps = all_crate_deps(normal = True),
)

low_opt_rust_test(
    name = "foundation_test",
    size = "small",
    crate_root = "tests/wire.rs",
    srcs = ["tests/wire.rs"],
    edition = "2024",
    version = "0.1.0",
    deps = [":foundation"] + all_crate_deps(normal_dev = True),
)

low_opt_rust_test(
    name = "execution_identity_test",
    size = "small",
    crate_root = "tests/execution.rs",
    srcs = ["tests/execution.rs"],
    edition = "2024",
    deps = [":foundation"],
)

low_opt_rust_test(
    name = "message_uuid_test",
    size = "small",
    crate_root = "tests/message_uuid.rs",
    srcs = ["tests/message_uuid.rs"],
    edition = "2024",
    deps = [":foundation"] + all_crate_deps(normal_dev = True),
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

# Read by the crash report's build script for its log catalog and the words of the code.
filegroup(
    name = "report_sources",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//crates/alondra:__pkg__"],
)
