load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

rust_library(
    name = "domain",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "alondra_domain",
    edition = "2024",
    version = "0.1.0",
    visibility = ["//crates:__subpackages__", "//tests:__subpackages__"],
    deps = ["//crates/foundation:foundation"],
)

rust_test(
    name = "domain_test",
    crate_root = "tests/lifecycle.rs",
    srcs = ["tests/lifecycle.rs"],
    edition = "2024",
    deps = [":domain", "//crates/foundation:foundation"] + all_crate_deps(normal_dev = True),
)

rust_doc_test(
    name = "construction_test",
    crate = ":domain",
)

rust_test(
    name = "identity_compatibility_test",
    crate_root = "tests/identity_compatibility.rs",
    srcs = ["tests/identity_compatibility.rs"],
    edition = "2024",
    deps = [":domain", "//crates/foundation:foundation"],
)
