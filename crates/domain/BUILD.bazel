load("//tools/layers:crates.bzl", "domain_crate")
load("//bazel/rules:tree.bzl", "repo_tree")
load("@crates//:defs.bzl", "all_crate_deps")
load("//bazel/rules:rust_test.bzl", "low_opt_rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc_test")
load("//bazel/rules:rust_sources.bzl", "production_sources")

domain_crate(
    name = "domain",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "alondra_domain",
    version = "0.1.0",
    test_visibility = ["//crates/engine-doubles:__pkg__", "//crates/machine-model:__pkg__", "//crates/provider-conformance:__pkg__"],
    deps = ["//crates/foundation:foundation"] + all_crate_deps(normal = True),
)

low_opt_rust_test(
    name = "domain_test",
    size = "small",
    crate_root = "tests/lifecycle.rs",
    srcs = ["tests/lifecycle.rs", "tests/support/mod.rs"],
    edition = "2024",
    deps = [":domain", "//crates/foundation:foundation"] + all_crate_deps(normal_dev = True),
)

low_opt_rust_test(
    name = "obligation_test",
    size = "small",
    crate_root = "tests/obligation.rs",
    srcs = ["tests/obligation.rs", "tests/support/mod.rs"],
    edition = "2024",
    deps = [":domain", "//crates/foundation:foundation"] + all_crate_deps(normal_dev = True),
)

rust_doc_test(
    name = "construction_test",
    size = "small",
    crate = ":domain",
)

low_opt_rust_test(
    name = "identity_compatibility_test",
    size = "small",
    crate_root = "tests/identity_compatibility.rs",
    srcs = ["tests/identity_compatibility.rs"],
    edition = "2024",
    deps = [":domain", "//crates/foundation:foundation"],
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

# The crate's production sources: the crash report's log catalog reads them, and fails on a test
# file among them.
filegroup(
    name = "report_sources",
    srcs = production_sources(),
    visibility = ["//crates/alondra:__pkg__", "//crates/cli-report:__pkg__", "//crates/cli-report:__pkg__"],
)

repo_tree()
