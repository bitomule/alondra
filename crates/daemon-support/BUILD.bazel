load("//tools/layers:crates.bzl", "port_crate")
load("//bazel/rules:tree.bzl", "repo_tree")
load("//bazel/rules:rust_inputs_test.bzl", "rust_inputs_test")
load("//bazel/rules:rust_test.bzl", "low_opt_rust_test")
load("@crates//:defs.bzl", "all_crate_deps")
load("//:version.bzl", "VERSION")
load("//bazel/rules:rust_sources.bzl", "production_sources")

WORKSPACE_DEPS = [
    "//crates/core:alondra_core",
    "//crates/foundation:foundation",
    "//crates/domain-model:domain_model",
    "//crates/engine-ports:engine_ports",
]

port_crate(
    name = "daemon_support",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "alondra_daemon_support",
    version = VERSION,
    deps = all_crate_deps(normal = True) + WORKSPACE_DEPS,
)

low_opt_rust_test(
    name = "daemon_support_test",
    timeout = "moderate",
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    crate_name = "alondra_daemon_support",
    crate_root = "src/lib.rs",
    edition = "2024",
    # Bazel test-setup resolves a relative HOME to this test's TEST_TMPDIR.
    env = {"HOME": "."},
    version = VERSION,
    deps = all_crate_deps(normal = True, normal_dev = True) + WORKSPACE_DEPS,
)

rust_inputs_test(
    name = "production_inputs_test",
    size = "small",
    required_sources = ["crates/daemon-support/src/lib.rs"],
    source_dir = "crates/daemon-support/src/",
    target_under_test = ":daemon_support",
    test_only_sources = ["crates/test_support.rs"],
    test_sources = False,
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

# Evidence alondrad's check of the domain v2 acceptance catalog finds tests in.
exports_files(["src/domain_authority.rs"], visibility = ["//crates/alondrad:__pkg__", "//crates/daemon-server:__pkg__"])

# The crate's production sources: the crash report's log catalog reads them, and fails on a test
# file among them; alondrad's lock policy test reads them too.
filegroup(
    name = "report_sources",
    srcs = production_sources(),
    visibility = ["//crates/alondra:__pkg__", "//crates/cli-report:__pkg__", "//crates/alondrad:__pkg__", "//crates/daemon-server:__pkg__", "//crates/daemon-engine:__pkg__", "//crates/store-sqlite:__pkg__"],
)

repo_tree()
