load("//tools/bazel:crates.bzl", "application_crate")
load("//tools:tree.bzl", "repo_tree")
load("//tools:rust_inputs_test.bzl", "rust_inputs_test")
load("//tools:rust_test.bzl", "low_opt_rust_test")
load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("//:version.bzl", "VERSION")
load("//tools:rust_sources.bzl", "production_sources")

WORKSPACE_DEPS = [
    "//crates/core:alondra_core", "//crates/domain-rules:domain_rules", "//crates/view-model:view_model",
    "//crates/e2e:alondra_e2e",
    "//crates/process-group:process_group",
    "//crates/provider-claude:provider_claude",
    "//crates/store:store",
]

application_crate(
    name = "daemon_support",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "alondra_daemon_support",
    version = VERSION,
    deps = all_crate_deps(normal = True) + WORKSPACE_DEPS,
)

# alondrad's and the engine's unit tests build against the hooks its tests drive: a poisoned lock, a full disk, a
# Claude home of the test's own.
rust_library(
    name = "daemon_support_test_hooks",
    testonly = True,
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    crate_features = ["test-hooks"],
    crate_name = "alondra_daemon_support",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = VERSION,
    visibility = ["//crates/engine-sdk:__pkg__", "//crates/alondrad:__pkg__", "//crates/daemon-server:__pkg__", "//crates/daemon-engine:__pkg__", "//crates/engine-admission:__pkg__", "//crates/engine-github:__pkg__", "//crates/engine-kernel:__pkg__", "//crates/engine-live:__pkg__", "//crates/engine-mcp:__pkg__", "//crates/engine-worktrees:__pkg__", "//crates/engine-orchestrator:__pkg__", "//crates/daemon-engine-machine:__pkg__", "//crates/daemon-engine-store:__pkg__", "//crates/daemon-engine-model:__pkg__", "//crates/scenarios:__pkg__"],
    deps = all_crate_deps(normal = True, normal_dev = True) + WORKSPACE_DEPS,
)

low_opt_rust_test(
    name = "daemon_support_test",
    timeout = "moderate",
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    compile_data = ["//fixtures/workflow"],
    crate_name = "alondra_daemon_support",
    crate_root = "src/lib.rs",
    edition = "2024",
    # Bazel test-setup resolves a relative HOME to this test's TEST_TMPDIR.
    env = {"HOME": "."},
    version = VERSION,
    deps = all_crate_deps(normal = True, normal_dev = True) + WORKSPACE_DEPS,
)

rust_inputs_test(
    name = "production_inputs_test",
    size = "small",
    required_sources = ["crates/daemon-support/src/lib.rs"],
    source_dir = "crates/daemon-support/src/",
    target_under_test = ":daemon_support",
    test_only_sources = ["crates/test_support.rs"],
    test_sources = False,
)

rust_inputs_test(
    name = "test_hooks_inputs_test",
    size = "small",
    required_sources = ["crates/daemon-support/src/lib.rs"],
    source_dir = "crates/daemon-support/src/",
    target_under_test = ":daemon_support_test_hooks",
    test_only_sources = ["crates/test_support.rs"],
    test_sources = True,
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

# Evidence alondrad's check of the domain v2 acceptance catalog finds tests in.
exports_files(["src/domain_authority.rs", "src/domain_cutover.rs"], visibility = ["//crates/alondrad:__pkg__", "//crates/daemon-server:__pkg__"])

# The crate's production sources: the crash report's log catalog reads them, and fails on a test
# file among them; alondrad's lock policy test reads them too.
filegroup(
    name = "report_sources",
    srcs = production_sources(),
    visibility = ["//crates/alondra:__pkg__", "//crates/cli-report:__pkg__", "//crates/alondrad:__pkg__", "//crates/daemon-server:__pkg__", "//crates/daemon-engine:__pkg__", "//crates/daemon-engine-machine:__pkg__", "//crates/daemon-engine-store:__pkg__"],
)

repo_tree()
