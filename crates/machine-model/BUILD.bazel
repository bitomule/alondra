load("//bazel/rules:tree.bzl", "repo_tree")
load("//bazel/rules:rust_test.bzl", "low_opt_rust_test")
load("//:version.bzl", "VERSION")

# The model of the whole machine: generated histories through the real domain and the decisions of
# the daemon's loops, reached through the engine's `machine_hooks` modules. The checks
# share one run per history across their properties; on a busy machine they alone take minutes, so
# they keep their own crate and time limit instead of the engine's unit target.
low_opt_rust_test(
    name = "machine_model_test",
    size = "medium",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["//:docs/architecture/state-machines.md"],
    crate_name = "alondra_machine_model",
    crate_root = "src/lib.rs",
    edition = "2024",
    env = {"HOME": "."},
    version = VERSION,
    deps = [
        "//crates/core:alondra_core",
        "//crates/domain-rules:domain_rules",
        "//crates/daemon-engine:daemon_engine",
        "//crates/engine-admission:engine_admission",
        "//crates/engine-orchestrator:engine_orchestrator",
        "//crates/engine-sdk:engine_sdk",
        "//crates/domain:domain",
        "//crates/foundation:foundation",
        "@crates//:proptest",
        "@crates//:serde_json",
    ],
)

repo_tree()
