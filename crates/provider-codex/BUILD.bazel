load("//tools/layers:crates.bzl", "adapter_out_crate")
load("//bazel/rules:tree.bzl", "repo_tree")
load("@crates//:defs.bzl", "all_crate_deps")
load("//bazel/rules:rust_test.bzl", "low_opt_rust_test")
load("//bazel/rules:rust.bzl", "rust_library")

_DEPS = [
    "//crates/codex-protocol:codex_protocol",
    "//crates/core:alondra_core",
    "//crates/engine-ports:engine_ports",
    "//crates/agent-application:agent_application",
    "//crates/provider-contract:provider_contract",
    "//crates/foundation:foundation",
    "//crates/store:store",
    "//crates/process-group:process_group",
] + all_crate_deps(normal = True)

adapter_out_crate(
    name = "provider_codex",
    srcs = glob(["src/*.rs"], exclude = ["src/*_tests.rs"]),
    crate_name = "alondra_provider_codex",
    version = "0.1.0",
    test_visibility = ["//crates/daemon-engine:__pkg__", "//crates/daemon-server:__pkg__", "//crates/engine-sdk:__pkg__"],
    deps = _DEPS,
)
_TEST_SRCS = glob(["src/*.rs"]) + ["//crates/provider-claude:src/archive_tests.rs", "//crates:test_support.rs"]

_TEST_DEPS = _DEPS + ["//crates/domain:domain", "//crates/provider-conformance:provider_conformance"] + all_crate_deps(normal_dev = True)

_TEST_COMPILE_DATA = ["//crates/agent-protocol:fixtures/hello.json", "//crates/domain-store-schema:schema.sql"] + glob(["fixtures/native/*.jsonl"])

# The crate's tests, and the orchestrator batch of `src/host_cases_tests.rs` on the Codex host model.
low_opt_rust_test(
    name = "provider_codex_test",
    size = "small",
    crate_root = "src/lib.rs",
    srcs = _TEST_SRCS,
    crate_features = ["host_model"],
    crate_name = "alondra_provider_codex",
    edition = "2024",
    version = "0.1.0",
    deps = _TEST_DEPS + [":codex_host_model", "//crates/engine-doubles:engine_doubles"],
    compile_data = _TEST_COMPILE_DATA,
    env = {"HOME": "."},
)

# The same orchestrator batch on the real Codex host with the fake app-server, so the model cannot
# drift from the host it stands for.
low_opt_rust_test(
    name = "codex_host_test",
    size = "medium",
    crate_root = "src/lib.rs",
    srcs = _TEST_SRCS,
    crate_features = ["host_fixture"],
    crate_name = "alondra_provider_codex",
    edition = "2024",
    version = "0.1.0",
    deps = _TEST_DEPS + ["//crates/agent-runtime:agent_runtime"],
    compile_data = _TEST_COMPILE_DATA,
    data = [
        "//agent-host:alondra-codex-host",
        "//agent-host:fake-codex.py",
    ],
    env = {
        "HOME": ".",
        "FIXTURE_CODEX_HOST": "$(rootpath //agent-host:alondra-codex-host)",
        "FIXTURE_CODEX_NATIVE": "$(rootpath //agent-host:fake-codex.py)",
        "TEST_EXECS": "$(rootpath //agent-host:alondra-codex-host) /usr/bin/python3 tmpdir",
    },
)
# The Codex host, its session and the fake native app-server played in a test's own process, on the
# transport the Claude host model speaks too: the doubled hosts of engine-doubles serve with it.
# Tests only.
_HOST_MODEL_DEPS = [
    "//crates/codex-protocol:codex_protocol",
    "//crates/core:alondra_core",
    "//crates/engine-doubles:engine_doubles",
    "//crates/process-group:process_group",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:sha2-0.10.9",
    "@crates//:tokio",
]

rust_library(
    name = "codex_host_model",
    testonly = True,
    srcs = glob(["model/**/*.rs"]) + ["//crates/provider-claude:model/host_transport.rs"],
    crate_name = "alondra_codex_host_model",
    crate_root = "model/fake_codex_host.rs",
    edition = "2024",
    version = "0.1.0",
    visibility = ["//crates/daemon-server:__pkg__", "//crates/engine-orchestrator:__pkg__", "//crates/engine-sdk:__pkg__"],
    deps = _HOST_MODEL_DEPS,
)

# The transport both host models speak, tried on its own: `host_transport.rs` is compiled into the
# Codex model, so its tests run with it.
low_opt_rust_test(
    name = "codex_host_model_test",
    size = "small",
    srcs = glob(["model/**/*.rs"]) + ["//crates/provider-claude:model/host_transport.rs"],
    crate_name = "alondra_codex_host_model",
    crate_root = "model/fake_codex_host.rs",
    edition = "2024",
    version = "0.1.0",
    deps = _HOST_MODEL_DEPS,
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

repo_tree()
