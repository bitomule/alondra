load("//tools/bazel:crates.bzl", "adapter_out_crate")
load("//tools:tree.bzl", "repo_tree")
load("@crates//:defs.bzl", "all_crate_deps")
load("//tools:rust_test.bzl", "low_opt_rust_test")
load("@rules_rust//rust:defs.bzl", "rust_library")

_DEPS = [
    "//crates/codex-protocol:codex_protocol",
    "//crates/engine-ports:engine_ports",
    "//crates/agent-application:agent_application",
    "//crates/provider-contract:provider_contract",
    "//crates/foundation:foundation",
    "//crates/store:store",
    "//crates/process-group:process_group",
] + all_crate_deps(normal = True)

adapter_out_crate(
    name = "provider_codex",
    srcs = glob(["src/*.rs"], exclude = ["src/*_tests.rs"]),
    crate_name = "alondra_provider_codex",
    version = "0.1.0",
    deps = _DEPS,
)
low_opt_rust_test(
    name = "provider_codex_test",
    size = "small",
    crate_root = "src/lib.rs",
    srcs = glob(["src/*.rs"]) + ["//crates/provider-claude:src/archive_tests.rs", "//crates:test_support.rs"],
    crate_name = "alondra_provider_codex",
    edition = "2024",
    version = "0.1.0",
    deps = _DEPS + ["//crates/domain:domain", "//crates/provider-conformance:provider_conformance"] + all_crate_deps(normal_dev = True),
    compile_data = ["//crates/agent-protocol:fixtures/hello.json", "//crates/domain-store-schema:schema.sql"] + glob(["fixtures/native/*.jsonl"]),
    env = {"HOME": "."},
)
# The Codex host, its session and the fake native app-server played in a test's own process, on the
# transport the Claude host model speaks too: the doubled hosts of engine-doubles serve with it.
# Tests only.
rust_library(
    name = "codex_host_model",
    testonly = True,
    srcs = glob(["model/**/*.rs"]) + ["//crates/provider-claude:model/host_transport.rs"],
    crate_name = "alondra_codex_host_model",
    crate_root = "model/fake_codex_host.rs",
    edition = "2024",
    version = "0.1.0",
    visibility = ["//crates/engine-sdk:__pkg__"],
    deps = [
        "//crates/codex-protocol:codex_protocol",
        "//crates/core:alondra_core",
        "//crates/engine-doubles:engine_doubles",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2-0.10.9",
        "@crates//:tokio",
    ],
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

repo_tree()
