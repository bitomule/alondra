load("//tools/layers:crates.bzl", "adapter_in_crate")
load("//bazel/rules:tree.bzl", "repo_tree")
load("//bazel/incremental/tests:rust_incremental_test.bzl", "compiles_incrementally_test")
load("//bazel/rules:rust_inputs_test.bzl", "rust_inputs_test")
load("//bazel/rules:rust_test.bzl", "incremental_rust_test")
load("@crates//:defs.bzl", "all_crate_deps")
load("//:version.bzl", "VERSION")
load("//bazel/rules:rust_sources.bzl", "production_sources")

TEST_ONLY = ["src/operation_journal/process_fixture.rs", "src/views/serialization.rs"]

WORKSPACE_DEPS = [
    "//crates/foundation:foundation",
    "//crates/core:alondra_core",
    "//crates/host:host",
    "//crates/domain:domain",
    "//crates/domain-model:domain_model",
    "//crates/e2e:alondra_e2e",
    "//crates/engine-ports:engine_ports",
    "//crates/view-model:view_model",
]

# The daemon's input adapter: its HTTP routes, the iroh and direct transports, the pushes and the
# screens' cache. It reaches the screens through the port `Screens`, so editing a screen never
# rebuilds it; only the root, `alondrad`, links `views`.
adapter_in_crate(
    name = "daemon_server",
    srcs = production_sources(test_only = TEST_ONLY),
    crate_name = "alondra_daemon_server",
    version = VERSION,
    deps = all_crate_deps(normal = True) + WORKSPACE_DEPS,
)

# What every test target compiles besides the sources: the fixtures the server's tests read.
TEST_COMPILE_DATA = [
    "//crates/core:fixtures/ctrl_trivial_2.jsonl",
    "//crates/core:fixtures/quill.jsonl",
    "//crates/domain-rules:src/tests.rs",
    "//crates/store-sqlite:src/schedule_acceptance_tests.rs",
    "//crates/store-sqlite:src/tests.rs",
    "//crates/daemon-support:src/domain_authority.rs",
    "//crates/engine-ports:src/domain_cutover.rs",
    "//fixtures/workflow",
    "//fixtures/domain-v2:acceptance.json",
    "//fixtures/client-v2",
    "//fixtures/push",
    "//fixtures/views:all",
    "//fixtures/views:cards",
    "//crates/alondrad:Info.plist",
]

TEST_SRCS = glob(["src/**/*.rs"]) + ["//crates/daemon-engine:src/wiring/owner_fixtures.rs", "//crates/engine-sdk:fixtures"]

# What every test target links besides the crate's own dependencies.
TEST_DEPS = all_crate_deps(normal = True, normal_dev = True) + WORKSPACE_DEPS + [
    "//crates/views:views",
    "//crates/daemon-engine:daemon_engine",
    "//crates/daemon-engine-model:daemon_engine_model",
    "//crates/store-sqlite:store_sqlite",
    "//crates/engine-doubles:engine_doubles",
    "//crates/engine-kernel:engine_kernel",
    "//crates/engine-admission:engine_admission",
    "//crates/engine-orchestrator:engine_orchestrator",
    "//crates/engine-sdk:engine_sdk",
    "//crates/agent-application:agent_application",
    "//crates/process-group:process_group",
    "//crates/provider-claude:provider_claude",
    "//crates/provider-codex:provider_codex",
    "//crates/provider-contract:provider_contract",
    "//crates/store:store",
]

# The Apple process tests run this binary as a daemon that advertises on the local network, so it
# carries the reason macOS shows for that permission, like `alondrad`.
TEST_RUSTC_FLAGS = ["-Clink-arg=-Wl,-sectcreate,__TEXT,__info_plist,$(execpath //crates/alondrad:Info.plist)"]

# The server's tests render with the real screens: they are the only test targets here that link
# `views`. These run on the doubled hosts of engine-doubles, which the Claude and Codex host models
# and the orchestrator model play: no Agent SDK host, fake native Claude or binary of the root is an
# input. The Apple packages run its fixture servers.
incremental_rust_test(
    name = "daemon_server_test",
    size = "large",
    visibility = ["//apple/Data/Feed:__pkg__", "//apple/Data/Iroh:__pkg__"],
    compile_data = TEST_COMPILE_DATA,
    srcs = TEST_SRCS,
    crate_name = "alondra_daemon_server",
    crate_root = "src/lib.rs",
    # Bazel test-setup resolves a relative HOME to this test's TEST_TMPDIR.
    env = {
        "HOME": ".",
        "TEST_EXECS": "/bin/cat /bin/ls /bin/sh /bin/sleep /usr/bin/defaults /usr/bin/head /usr/bin/id /usr/bin/python3 /usr/bin/touch /usr/bin/true /usr/bin/wc tmpdir",
    },
    deps = ["//crates/domain-rules:domain_rules"] + TEST_DEPS + ["//crates/provider-claude:claude_host_model", "//crates/provider-codex:codex_host_model"],
    data = [
        "//fixtures/client-v2",
        "//fixtures/views:all",
    ],
    edition = "2024",
    rustc_flags = TEST_RUSTC_FLAGS,
    version = VERSION,
)

# The tests that still need a real Agent SDK host or a fake native Claude or Codex: the same sources
# with the feature real-hosts, which compiles only them. No binary of the root is an input: the real
# `alondra` and `alondrad` run in `//crates/alondrad:binary_smoke_test`.
incremental_rust_test(
    name = "daemon_server_host_test",
    size = "medium",
    compile_data = TEST_COMPILE_DATA,
    srcs = TEST_SRCS,
    crate_features = ["real-hosts"],
    crate_name = "alondra_daemon_server",
    crate_root = "src/lib.rs",
    # Bazel test-setup resolves a relative HOME to this test's TEST_TMPDIR.
    env = {
        "HOME": ".",
        # The host a release ships: Node, the SDK and the host in one executable, so every SDK test
        # of the daemon runs the bytes Brew installs.
        "FIXTURE_NODE": "$(rootpath //agent-host:alondra-host)",
        "FIXTURE_HOST": "$(rootpath //agent-host:alondra-host)",
        "FIXTURE_NATIVE": "$(rootpath //agent-host:persistent-fake-claude.py)",
        "FIXTURE_CODEX_HOST": "$(rootpath //agent-host:alondra-codex-host)",
        "FIXTURE_CODEX_LEGACY_HOST": "$(rootpath //agent-host:codex-legacy-fixture)",
        "FIXTURE_CODEX_NATIVE": "$(rootpath //agent-host:fake-codex.py)",
        "FIXTURE_CODEX_MODEL_DOUBLE": "$(rootpath //agent-host:codex-model-double.py)",
        "FIXTURE_CODEX_MCP_NATIVE": "$(rootpath //agent-host:fake-codex-mcp.py)",
        "TEST_EXECS": "$(rootpath //agent-host:alondra-host) /usr/bin/git /usr/bin/python3 tmpdir",
    },
    deps = ["//crates/domain-rules:domain_rules"] + TEST_DEPS + ["//crates/agent-runtime:agent_runtime"],
    data = [
        "//agent-host:persistent-fake-claude.py",
        "//agent-host:alondra-host",
        "//agent-host:alondra-codex-host",
        "//agent-host:codex-legacy-fixture",
        "//agent-host:fake-codex.py",
        "//agent-host:codex-model-double.py",
        "//agent-host:fake-codex-mcp.py",
        "//fixtures/client-v2",
        "//fixtures/views:all",
    ],
    edition = "2024",
    rustc_flags = TEST_RUSTC_FLAGS,
    version = VERSION,
)

rust_inputs_test(
    name = "production_inputs_test",
    size = "small",
    required_sources = ["crates/daemon-server/src/lib.rs", "crates/daemon-server/src/domain_api.rs"],
    source_dir = "crates/daemon-server/src/",
    target_under_test = ":daemon_server",
    test_only_sources = ["crates/daemon-server/src/operation_journal/process_fixture.rs", "crates/daemon-server/src/service/tests/iroh_tests.rs"],
    test_sources = False,
)

rust_inputs_test(
    name = "daemon_server_test_inputs_test",
    size = "small",
    required_sources = ["crates/daemon-server/src/lib.rs", "crates/daemon-server/src/domain_api.rs"],
    source_dir = "crates/daemon-server/src/",
    target_under_test = ":daemon_server_test",
    test_only_sources = ["crates/daemon-server/src/operation_journal/process_fixture.rs", "crates/daemon-server/src/service/tests/iroh_tests.rs"],
    test_sources = True,
)

# Both test crates recompile the whole server on every edit of the engine or below: incremental,
# that takes 12-26 s instead of 36-49 s, for 1.9 GB per checkout (docs/architecture/build-graph.md).
[
    compiles_incrementally_test(
        name = target + "_compiles_incrementally_test",
        size = "small",
        target_under_test = ":" + target,
    )
    for target in ["daemon_server_test", "daemon_server_host_test"]
]

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

# The crate's production sources: the crash report's log catalog reads them, and fails on a test
# file among them.
filegroup(
    name = "report_sources",
    srcs = production_sources(test_only = TEST_ONLY),
    visibility = ["//crates/alondra:__pkg__", "//crates/alondrad:__pkg__", "//crates/cli-report:__pkg__"],
)

repo_tree()
