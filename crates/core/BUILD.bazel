load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_doc_test", "rust_library", "rust_test")

rust_library(
    name = "alondra_core",
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    compile_data = ["src/model_sheets.toml"],
    crate_name = "alondra_core",
    edition = "2024",
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + ["//crates/foundation:foundation", "//crates/domain:domain"],
)

exports_files(glob(["fixtures/*.jsonl"]) + ["src/domain/tests.rs"])

# The lifecycle authority cannot be cloned, deserialized or made from the Task DTO.
rust_doc_test(
    name = "lifecycle_construction_test",
    crate = ":alondra_core",
    deps = ["//crates/domain:domain", "@crates//:serde_json"],
)

rust_test(
    name = "alondra_core_test",
    compile_data = glob(["fixtures/*.jsonl", "fixtures/*.json"]) + ["src/model_sheets.toml", "//fixtures/views:all", "//fixtures/views:cards", "//fixtures/views:metrics"],
    crate = ":alondra_core",
    deps = all_crate_deps(normal_dev = True),
    edition = "2024",
)

# Opt-in profiling driver; ordinary tests do not execute it.
rust_binary(
    name = "read_index_cost",
    testonly = True,
    srcs = ["benches/read_index_cost.rs", "benches/inbox_graphs.rs", "benches/read_index.rs"],
    edition = "2024",
    deps = [":alondra_core"] + all_crate_deps(normal = True),
)


rust_test(
    name = "read_index_cost_test",
    crate_root = "benches/read_index_cost.rs",
    srcs = ["benches/read_index_cost.rs", "benches/inbox_graphs.rs", "benches/read_index.rs"],
    edition = "2024",
    deps = [":alondra_core"] + all_crate_deps(normal = True),
)

rust_test(
    name = "foundation_contract_test",
    crate_root = "tests/foundation.rs",
    srcs = ["tests/foundation.rs"],
    edition = "2024",
    version = "0.1.0",
    deps = [
        ":alondra_core",
        "//crates/foundation:foundation",
        "@crates//:serde_json",
    ],
)

# The domain and the screens never read what hooks deduced of a node: that deduction is kept only
# for the `claude --bg` nodes still handed over to the Agent SDK.
rust_test(
    name = "hook_deduction_boundary_test",
    crate_root = "tests/hook_deduction_boundary.rs",
    srcs = ["tests/hook_deduction_boundary.rs"],
    data = glob(["src/domain/**/*.rs", "src/views/**/*.rs"]),
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "crates/core"},
)

# Every family of views renders a real-size domain within its budget, with alondra_core built as
# the daemon links it: without the checks only its own unit tests compile in.
rust_test(
    name = "views_budget_test",
    crate_root = "tests/views_budget.rs",
    srcs = ["tests/views_budget.rs"],
    edition = "2024",
    version = "0.1.0",
    deps = [
        ":alondra_core",
        "//crates/domain:domain",
        "@crates//:serde_json",
    ],
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

# Read by the crash report's build script for its log catalog and the words of the code.
filegroup(
    name = "report_sources",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//crates/alondra:__pkg__"],
)
