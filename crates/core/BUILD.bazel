load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

rust_library(
    name = "alondra_core",
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    crate_name = "alondra_core",
    edition = "2024",
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True) + ["//crates/foundation:foundation"],
)

exports_files(glob(["fixtures/*.jsonl"]) + ["src/domain/tests.rs"])

rust_test(
    name = "alondra_core_test",
    compile_data = glob(["fixtures/*.jsonl", "fixtures/*.json"]) + ["//fixtures/views:all", "//fixtures/views:cards"],
    crate = ":alondra_core",
    deps = all_crate_deps(normal_dev = True),
    edition = "2024",
)

# Opt-in profiling driver; ordinary tests do not execute it.
rust_binary(
    name = "projection_cost",
    testonly = True,
    srcs = ["benches/projection_cost.rs", "benches/inbox_graphs.rs", "benches/read_index.rs"],
    edition = "2024",
    deps = [":alondra_core"] + all_crate_deps(normal = True),
)


rust_test(
    name = "projection_cost_test",
    crate_root = "benches/projection_cost.rs",
    srcs = ["benches/projection_cost.rs", "benches/inbox_graphs.rs", "benches/read_index.rs"],
    edition = "2024",
    deps = [":alondra_core"] + all_crate_deps(normal = True),
)

rust_test(
    name = "foundation_contract_test",
    crate_root = "tests/foundation.rs",
    srcs = ["tests/foundation.rs"],
    edition = "2024",
    version = "0.1.0",
    deps = [
        ":alondra_core",
        "//crates/foundation:foundation",
        "@crates//:serde_json",
    ],
)
