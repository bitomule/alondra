load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "alondra_core",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "alondra_core",
    edition = "2024",
    version = "0.1.0",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)

exports_files(glob(["fixtures/*.jsonl"]))

rust_test(
    name = "alondra_core_test",
    compile_data = glob(["fixtures/*.jsonl"]),
    crate = ":alondra_core",
    edition = "2024",
)
