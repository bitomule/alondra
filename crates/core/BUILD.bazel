load("//tools/bazel:crates.bzl", "domain_crate")
load("//tools:tree.bzl", "repo_tree")
load("@crates//:defs.bzl", "all_crate_deps")
load("//tools:rust_test.bzl", "low_opt_rust_test")
load("//tools:rust_sources.bzl", "production_sources")
load("//tools:rust_inputs_test.bzl", "rust_inputs_test")

CORE_DEPS = all_crate_deps(normal = True) + ["//crates/foundation:foundation", "//crates/domain:domain"]

domain_crate(
    name = "alondra_core",
    srcs = production_sources(test_only = ["src/recorded.rs", "src/model_decider/properties.rs"]),
    compile_data = ["src/model_sheets.toml"],
    crate_name = "alondra_core",
    version = "0.1.0",
    test_visibility = ["//crates/engine-doubles:__pkg__", "//crates/machine-model:__pkg__"],
    deps = CORE_DEPS,
)

exports_files(glob(["fixtures/*.jsonl"]))

low_opt_rust_test(
    name = "alondra_core_test",
    timeout = "moderate",
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    compile_data = glob(["fixtures/*.jsonl", "fixtures/*.json"]) + ["src/model_sheets.toml"],
    crate_name = "alondra_core",
    crate_root = "src/lib.rs",
    deps = CORE_DEPS + all_crate_deps(normal_dev = True),
    edition = "2024",
    version = "0.1.0",
)

# The library compiles only production sources: a test file among its inputs would rebuild every
# crate above it whenever the test changes.
rust_inputs_test(
    name = "production_inputs_test",
    size = "small",
    required_sources = ["crates/core/src/lib.rs"],
    source_dir = "crates/core/src/",
    target_under_test = ":alondra_core",
    test_only_sources = ["crates/core/src/recorded.rs", "crates/core/src/model_decider/properties.rs", "crates/test_support.rs"],
    test_sources = False,
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

# The crate's production sources: the crash report's log catalog reads them, and fails on a test
# file among them.
filegroup(
    name = "report_sources",
    srcs = production_sources(test_only = ["src/recorded.rs", "src/model_decider/properties.rs"]),
    visibility = ["//crates/alondra:__pkg__"],
)

repo_tree()
