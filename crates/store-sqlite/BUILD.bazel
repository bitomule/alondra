load("//tools/layers:crates.bzl", "adapter_out_crate")
load("//bazel/rules:tree.bzl", "repo_tree")
load("//bazel/rules:rust_test.bzl", "low_opt_rust_test")
load("@crates//:defs.bzl", "all_crate_deps")
load("//:version.bzl", "VERSION")
load("//bazel/rules:rust_sources.bzl", "production_sources")
load("//bazel/rules:rust_inputs_test.bzl", "rust_inputs_test")

WORKSPACE_DEPS = ["//crates/engine-ports:engine_ports", "//crates/agent-application:agent_application", "//crates/core:alondra_core", "//crates/domain-rules:domain_rules", "//crates/domain:domain", "//crates/foundation:foundation", "//crates/provider-codex:provider_codex", "//crates/provider-contract:provider_contract", "//crates/store:store"]
SQL = [
    "//crates/domain-store-schema:schema.sql",
    "//crates/domain-store-schema:schedule_launch_transition.sql",
    "src/model_metrics.sql",
]
TEST_DATA = SQL + ["//fixtures/domain-v2:acceptance.json"]

# The tests alondrad's check of the acceptance catalog finds its evidence in.
exports_files(["src/tests.rs", "src/schedule_acceptance_tests.rs"], visibility = ["//crates/alondrad:__pkg__", "//crates/daemon-server:__pkg__"])

adapter_out_crate(
    name = "store_sqlite",
    srcs = production_sources(),
    compile_data = SQL,
    crate_name = "alondra_store_sqlite",
    version = VERSION,
    deps = all_crate_deps(normal = True) + WORKSPACE_DEPS + [
        "//crates/daemon-engine-model:daemon_engine_model",
        "//crates/daemon-support:daemon_support",
    ],
    test_visibility = ["//crates/alondrad:__pkg__", "//crates/daemon-engine:__pkg__", "//crates/daemon-engine-machine:__pkg__", "//crates/daemon-server:__pkg__", "//crates/engine-admission:__pkg__", "//crates/engine-github:__pkg__", "//crates/engine-kernel:__pkg__", "//crates/engine-orchestrator:__pkg__", "//crates/engine-sdk:__pkg__", "//crates/scenarios:__pkg__"],
)

low_opt_rust_test(
    name = "store_sqlite_test",
    size = "medium",
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    compile_data = TEST_DATA,
    crate_name = "alondra_store_sqlite",
    crate_root = "src/lib.rs",
    edition = "2024",
    env = {"HOME": "."},
    version = VERSION,
    deps = all_crate_deps(normal = True, normal_dev = True) + WORKSPACE_DEPS + [
        "//crates/daemon-engine-model:daemon_engine_model",
        "//crates/daemon-support:daemon_support",
    ] + ["//crates/engine-doubles:engine_doubles"],
)

# The library compiles only production sources: a test file among its inputs would rebuild every
# crate above it whenever the test changes.
rust_inputs_test(
    name = "production_inputs_test",
    size = "small",
    required_sources = ["crates/store-sqlite/src/lib.rs"],
    source_dir = "crates/store-sqlite/src/",
    target_under_test = ":store_sqlite",
    test_only_sources = ["crates/test_support.rs"],
    test_sources = False,
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])
filegroup(
    name = "report_sources",
    srcs = production_sources(),
    visibility = ["//crates/alondra:__pkg__", "//crates/cli-report:__pkg__", "//crates/alondrad:__pkg__", "//crates/daemon-server:__pkg__"],
)

repo_tree()
