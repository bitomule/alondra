load("//tools/layers:crates.bzl", "port_crate")
load("//bazel/rules:tree.bzl", "repo_tree")
load("@crates//:defs.bzl", "all_crate_deps")
load("//bazel/rules:rust_test.bzl", "low_opt_rust_test")
load("@rules_rust//rust:defs.bzl", "rust_doc_test")
load("//bazel/rules:rust_sources.bzl", "production_sources")

port_crate(
    name = "store",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["src/controls.sql", "src/controls_before_mcp.sql", "src/controls_before_force_stop.sql", "src/controls_before_clear_auth.sql", "src/observations_before_retention.sql", "src/inputs_and_commands_before_compaction.sql", "src/cards_before_orchestrator.sql", "src/schema.sql"],
    crate_name = "alondra_store",
    version = "0.1.0",
    test_visibility = ["//crates/engine-doubles:__pkg__", "//crates/provider-conformance:__pkg__"],
    deps = ["//crates/domain:domain", "//crates/foundation:foundation", "//crates/provider-contract:provider_contract"] + all_crate_deps(normal = True),
)

low_opt_rust_test(
    name = "store_test",
    size = "medium",
    crate_root = "tests/lifecycle.rs",
    srcs = ["tests/lifecycle.rs", "//crates:test_support.rs"],
    compile_data = ["src/controls.sql", "src/controls_before_mcp.sql", "src/controls_before_force_stop.sql", "src/controls_before_clear_auth.sql", "src/cards_before_orchestrator.sql", "//crates/domain-store-schema:schema.sql", "//crates/domain-store-schema:schedule_launch_transition.sql"],
    edition = "2024",
    env = {"HOME": "."},
    deps = [":store", "//crates/domain:domain", "//crates/foundation:foundation", "//crates/provider-contract:provider_contract"] + all_crate_deps(normal = True, normal_dev = True),
)

low_opt_rust_test(
    name = "codec_test",
    size = "small",
    crate = ":store",
    edition = "2024",
    deps = all_crate_deps(normal_dev = True),
)

rust_doc_test(
    name = "dispatch_authority_test",
    size = "small",
    crate = ":store",
)


low_opt_rust_test(
    name = "journal_format_test",
    size = "small",
    crate_root = "tests/journal_format.rs",
    srcs = ["tests/journal_format.rs", "//crates:test_support.rs"],
    compile_data = ["fixtures/legacy-journal.sql", "src/controls.sql", "src/observations_before_retention.sql", "src/inputs_and_commands_before_compaction.sql", "src/schema.sql", "//crates/domain-store-schema:schema.sql"],
    edition = "2024",
    env = {"HOME": "."},
    deps = [":store", "//crates/foundation:foundation"] + all_crate_deps(normal = True, normal_dev = True),
)

low_opt_rust_test(
    name = "recorded_journal_test",
    size = "small",
    crate_root = "tests/recorded_journal.rs",
    srcs = ["tests/recorded_journal.rs"],
    compile_data = ["fixtures/disk-pause-resting-node.sql", "fixtures/sdk-host-disconnect-loop.sql", "fixtures/turn-of-a-held-input.sql", "fixtures/user-pause-own-turns.sql", "//crates/domain-store-schema:schema.sql"],
    edition = "2024",
    env = {"HOME": "."},
    deps = [":store", "//crates/domain:domain", "//crates/foundation:foundation"] + all_crate_deps(normal = True, normal_dev = True),
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

# What the component stage-handover owns here, with its store suite: the spec engine validates it,
# and the kernel's boundary test reads it.
filegroup(
    name = "stage_handover_files",
    srcs = ["src/context_handoff.rs"],
    visibility = ["//:__pkg__", "//crates/engine-kernel:__pkg__"],
)

# The crate's production sources: the crash report's log catalog reads them, and fails on a test
# file among them.
filegroup(
    name = "report_sources",
    srcs = production_sources(),
    visibility = ["//crates/alondra:__pkg__", "//crates/cli-report:__pkg__", "//crates/cli-report:__pkg__"],
)

repo_tree()
