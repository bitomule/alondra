load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

rust_library(
    name = "store",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["src/controls.sql", "src/controls_before_mcp.sql", "src/controls_before_force_stop.sql", "src/controls_before_clear_auth.sql", "src/observations_before_retention.sql", "src/inputs_and_commands_before_compaction.sql", "src/schema.sql"],
    crate_name = "alondra_store",
    edition = "2024",
    version = "0.1.0",
    visibility = ["//crates:__subpackages__", "//tests:__subpackages__"],
    deps = ["//crates/domain:domain", "//crates/foundation:foundation", "//crates/provider-contract:provider_contract"] + all_crate_deps(normal = True),
)

rust_test(
    name = "store_test",
    crate_root = "tests/lifecycle.rs",
    srcs = ["tests/lifecycle.rs", "//crates:test_support.rs"],
    compile_data = ["src/controls.sql", "src/controls_before_mcp.sql", "src/controls_before_force_stop.sql", "src/controls_before_clear_auth.sql", "//crates/alondrad:src/domain_store/schema.sql", "//crates/alondrad:src/domain_store/schedule_launch_transition.sql"],
    edition = "2024",
    env = {"HOME": "."},
    deps = [":store", "//crates/domain:domain", "//crates/foundation:foundation", "//crates/provider-contract:provider_contract"] + all_crate_deps(normal = True, normal_dev = True),
)

rust_test(
    name = "codec_test",
    crate = ":store",
    edition = "2024",
    deps = all_crate_deps(normal_dev = True),
)

rust_doc_test(
    name = "dispatch_authority_test",
    crate = ":store",
)


rust_test(
    name = "journal_format_test",
    crate_root = "tests/journal_format.rs",
    srcs = ["tests/journal_format.rs", "//crates:test_support.rs"],
    compile_data = ["fixtures/legacy-journal.sql", "src/controls.sql", "src/observations_before_retention.sql", "src/inputs_and_commands_before_compaction.sql", "src/schema.sql", "//crates/alondrad:src/domain_store/schema.sql"],
    edition = "2024",
    env = {"HOME": "."},
    deps = [":store", "//crates/foundation:foundation"] + all_crate_deps(normal = True, normal_dev = True),
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])
