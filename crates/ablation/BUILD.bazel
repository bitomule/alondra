load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

rust_library(
    name = "alondra_ablation",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    compile_data = ["restore.sh"],
    crate_name = "alondra_ablation",
    edition = "2024",
    version = "0.1.0",
    deps = all_crate_deps(normal = True),
)

rust_binary(
    name = "ablation",
    srcs = ["src/main.rs"],
    edition = "2024",
    version = "0.1.0",
    deps = [":alondra_ablation"] + all_crate_deps(normal = True),
)

rust_test(
    name = "alondra_ablation_test",
    crate = ":alondra_ablation",
    edition = "2024",
    deps = all_crate_deps(normal_dev = True),
)

rust_test(
    name = "e2e_test",
    srcs = ["tests/e2e.rs"],
    data = [
        ":ablation",
        "tests/fake_bazel.sh",
    ],
    edition = "2024",
    env = {
        "ABLATION_BIN": "$(rootpath :ablation)",
        "FAKE_BAZEL": "$(rootpath tests/fake_bazel.sh)",
    },
    deps = all_crate_deps(normal = True, normal_dev = True),
)
