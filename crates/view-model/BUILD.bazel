load("//tools/bazel:crates.bzl", "port_crate")
load("//tools:tree.bzl", "repo_tree")
load("@crates//:defs.bzl", "all_crate_deps")
load("//tools:rust_test.bzl", "low_opt_rust_test")
load("//tools:rust_sources.bzl", "production_sources")
load("//tools:rust_inputs_test.bzl", "rust_inputs_test")

VIEW_MODEL_DEPS = all_crate_deps(normal = True) + [
    "//crates/core:alondra_core",
    "//crates/domain-rules:domain_rules",
    "//crates/foundation:foundation",
]

# What the daemon hands the screens: the wire types of a view and what it observes of live nodes.
port_crate(
    name = "view_model",
    srcs = production_sources(),
    crate_name = "alondra_view_model",
    version = "0.1.0",
    deps = VIEW_MODEL_DEPS,
)

low_opt_rust_test(
    name = "view_model_test",
    size = "small",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "alondra_view_model",
    crate_root = "src/lib.rs",
    deps = VIEW_MODEL_DEPS + all_crate_deps(normal_dev = True),
    edition = "2024",
    version = "0.1.0",
)

# The library compiles only production sources: a test file among its inputs would rebuild every
# crate above it whenever the test changes.
rust_inputs_test(
    name = "production_inputs_test",
    size = "small",
    required_sources = ["crates/view-model/src/lib.rs", "crates/view-model/src/live.rs"],
    source_dir = "crates/view-model/src/",
    target_under_test = ":view_model",
    test_only_sources = ["crates/view-model/src/now_fact/tests.rs", "crates/view-model/src/pr_images_tests.rs"],
    test_sources = False,
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

# The crate's production sources: the crash report's log catalog reads them, and fails on a test
# file among them.
filegroup(
    name = "report_sources",
    srcs = production_sources(),
    visibility = ["//crates/alondra:__pkg__", "//crates/cli-report:__pkg__", "//crates/views:__pkg__"],
)

repo_tree()
