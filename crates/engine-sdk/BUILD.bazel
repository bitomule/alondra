load("//tools/layers:crates.bzl", "application_crate")
load("//bazel/rules:tree.bzl", "repo_tree")
load("//bazel/rules:rust_test.bzl", "low_opt_rust_test")
load("@crates//:defs.bzl", "all_crate_deps")
load("//bazel/rules:rust_inputs_test.bzl", "rust_inputs_test")
load("//:version.bzl", "VERSION")
load("//bazel/rules:rust_sources.bzl", "production_sources")

# The SDK's crate asks the rest of the engine only through the port SdkEngine, and the rest of the
# engine asks it only through SdkHosts; alondrad puts them together.
WORKSPACE_DEPS = [
    "//crates/engine-ports:engine_ports",
    "//crates/agent-application:agent_application",
    "//crates/core:alondra_core",
    "//crates/domain:domain",
    "//crates/domain-rules:domain_rules",
    "//crates/foundation:foundation",
    "//crates/process-group:process_group",
    "//crates/provider-claude:provider_claude",
    "//crates/provider-antigravity:provider_antigravity",
    "//crates/provider-codex:provider_codex",
    "//crates/provider-contract:provider_contract",
    "//crates/store:store",
    "//crates/view-model:view_model",
]

# The fixtures of the tests that open the whole engine. No library compiles them: each test crate
# that uses them, here and above, compiles them as a module of its own (src/engine_fixtures.rs).
FIXTURES = [
    "src/auto_launch/fixtures.rs",
    "src/engine_assembly.rs",
    "src/engine_fixtures.rs",
    "src/engine_fixtures/model_hosts.rs",
    "src/engine_fixtures/orchestrator_tools.rs",
    "src/engine_fixtures/sdk_node_fixture.rs",
    "src/model_fixture/launch_fixture.rs",
    "src/sdk_owner/codex_fixtures.rs",
    "src/sdk_owner/fixtures.rs",
    "src/sdk_owner/untaken_fixtures.rs",
]

TEST_ONLY = FIXTURES + [
    "src/domain_schedule_runner/fixture.rs",
    "src/model_fixture.rs",
]

filegroup(
    name = "fixtures",
    testonly = True,
    srcs = FIXTURES,
    visibility = ["//crates/alondrad:__pkg__", "//crates/daemon-server:__pkg__"],
)

application_crate(
    name = "engine_sdk",
    srcs = production_sources(test_only = TEST_ONLY),
    crate_name = "alondra_engine_sdk",
    version = VERSION,
    test_visibility = ["//crates/machine-model:__pkg__"],
    deps = all_crate_deps(normal = True) + WORKSPACE_DEPS + [
        "//crates/daemon-engine-machine:daemon_engine_machine",
        "//crates/daemon-engine-model:daemon_engine_model",
        "//crates/daemon-support:daemon_support",
        "//crates/engine-github:engine_github",
        "//crates/engine-kernel:engine_kernel",
    ],
)

# What every test target links: the doubles of the engine's other pieces and the store they open.
TEST_HOOKS_DEPS = [
    "//crates/codex-protocol:codex_protocol",
    "//crates/daemon-engine-machine:daemon_engine_machine",
    "//crates/daemon-engine-model:daemon_engine_model",
    "//crates/store-sqlite:store_sqlite",
    "//crates/daemon-support:daemon_support",
    "//crates/engine-doubles:engine_doubles",
    "//crates/engine-github:engine_github",
    "//crates/engine-kernel:engine_kernel",
]

# The rest of the engine, for the tests that open it whole (the feature whole-engine).
WHOLE_ENGINE_DEPS = [
    "//crates/daemon-engine:daemon_engine",
    "//crates/engine-admission:engine_admission",
]

SDK_TEST_DATA = [
    "//agent-host:alondra-antigravity-host",
    "//agent-host:alondra-codex-host",
    "//agent-host:alondra-host",
    "//agent-host:alondra-codex-plan-legacy-fixture-host",
    "//agent-host:codex-legacy-fixture",
    "//agent-host:codex-model-double.py",
    "//agent-host:fake-codex-mcp.py",
    "//agent-host:fake-agy-acp.mjs",
    "//agent-host:fake-codex.py",
    "//agent-host:persistent-fake-claude.py",
    "//agent-host:pinned_node",
]

SDK_TEST_ENV = {
    "FIXTURE_ANTIGRAVITY_HOST": "$(rootpath //agent-host:alondra-antigravity-host)",
    "FIXTURE_ANTIGRAVITY_NATIVE": "$(rootpath //agent-host:fake-agy-acp.mjs)",
    "FIXTURE_NODE_RUNTIME": "$(rootpath //agent-host:pinned_node)",
    "FIXTURE_CODEX_HOST": "$(rootpath //agent-host:alondra-codex-host)",
    "FIXTURE_CODEX_LEGACY_HOST": "$(rootpath //agent-host:codex-legacy-fixture)",
    "FIXTURE_CODEX_MCP_NATIVE": "$(rootpath //agent-host:fake-codex-mcp.py)",
    "FIXTURE_CODEX_MODEL_DOUBLE": "$(rootpath //agent-host:codex-model-double.py)",
    "FIXTURE_CODEX_NATIVE": "$(rootpath //agent-host:fake-codex.py)",
    "FIXTURE_CODEX_PLAN_LEGACY_HOST": "$(rootpath //agent-host:alondra-codex-plan-legacy-fixture-host)",
    "FIXTURE_HOST": "$(rootpath //agent-host:alondra-host)",
    "FIXTURE_NATIVE": "$(rootpath //agent-host:persistent-fake-claude.py)",
    "FIXTURE_NODE": "$(rootpath //agent-host:alondra-host)",
    # Bazel test-setup resolves a relative HOME to this test's TEST_TMPDIR.
    "HOME": ".",
}

SDK_TEST_COMPILE_DATA = [
    "//fixtures/client-v2",
    "//fixtures/accounts:recorded-rows.json",
    "//fixtures/domain-v2:acceptance.json",
]

# The SDK's own tests: its pieces on a runtime whose other pieces are the doubles of
# engine-doubles, with the doubled hosts the Claude host model plays; they run no program. It links
# neither daemon-engine nor engine-admission (tools/layers/crate_layers_test.py), so an edit of those
# does not rerun it.
low_opt_rust_test(
    name = "engine_sdk_test",
    size = "medium",
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    compile_data = SDK_TEST_COMPILE_DATA,
    crate_name = "alondra_engine_sdk",
    crate_root = "src/lib.rs",
    edition = "2024",
    env = {"HOME": "."},
    version = VERSION,
    deps = all_crate_deps(normal = True, normal_dev = True) + WORKSPACE_DEPS + ["//crates/provider-claude:claude_host_model", "//crates/provider-codex:codex_host_model"] + TEST_HOOKS_DEPS,
)

# The tests that open the whole engine on the doubled hosts: the engine's own tests that live here,
# the automatic launches and the close of tasks end to end. No host starts and no host executable is
# an input; the only program they run is the git «allow always» asks which repository keeps a
# node's rules, which the engine runs itself rather than through the port Worktrees. It never
# carries a binary of the root: they link every crate, so an edit anywhere would rerun these tests.
low_opt_rust_test(
    name = "engine_sdk_engine_test",
    size = "large",
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs", "//crates/daemon-engine:src/wiring/owner_fixtures.rs"],
    compile_data = SDK_TEST_COMPILE_DATA,
    crate_features = ["whole-engine"],
    crate_name = "alondra_engine_sdk",
    crate_root = "src/lib.rs",
    edition = "2024",
    env = {"HOME": ".", "TEST_EXECS": "/usr/bin/git"},
    version = VERSION,
    deps = all_crate_deps(normal = True, normal_dev = True) + WORKSPACE_DEPS + ["//crates/provider-claude:claude_host_model", "//crates/provider-codex:codex_host_model"] + TEST_HOOKS_DEPS + WHOLE_ENGINE_DEPS,
)

# The tests that still need a real Agent SDK or Codex host, or a fake native Claude or Codex: the
# same sources with the feature real-hosts, which compiles only them. The tests that start the real
# daemon are //crates/alondrad:codex_adoption_process_test.
low_opt_rust_test(
    name = "engine_sdk_host_test",
    size = "large",
    srcs = glob(["src/**/*.rs"]) + ["//crates:test_support.rs"],
    compile_data = SDK_TEST_COMPILE_DATA,
    crate_features = [
        "real-hosts",
        "whole-engine",
    ],
    crate_name = "alondra_engine_sdk",
    crate_root = "src/lib.rs",
    data = SDK_TEST_DATA,
    edition = "2024",
    env = SDK_TEST_ENV | {"TEST_EXECS": "e2e"},
    tags = [
        "e2e",
        "manual",
    ],
    version = VERSION,
    deps = all_crate_deps(normal = True, normal_dev = True) + WORKSPACE_DEPS + ["//crates/agent-runtime:agent_runtime"] + TEST_HOOKS_DEPS + WHOLE_ENGINE_DEPS,
)

rust_inputs_test(
    name = "production_inputs_test",
    size = "small",
    required_sources = ["crates/engine-sdk/src/lib.rs", "crates/engine-sdk/src/wiring.rs"],
    source_dir = "crates/engine-sdk/src/",
    target_under_test = ":engine_sdk",
    test_only_sources = ["crates/engine-sdk/" + source for source in TEST_ONLY],
    test_sources = False,
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__", "//deploy/brew:__pkg__"])

# The crate's production sources: the crash report's log catalog reads them, and fails on a test
# file among them; alondrad's lock policy test reads them too.
filegroup(
    name = "report_sources",
    srcs = production_sources(test_only = TEST_ONLY),
    visibility = ["//crates/alondra:__pkg__", "//crates/cli-report:__pkg__", "//crates/alondrad:__pkg__", "//crates/daemon-server:__pkg__"],
)

repo_tree()
