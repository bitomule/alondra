load("@rules_rust//rust:defs.bzl", "rust_library")

rust_library(
    name = "provider_contract",
    srcs = ["src/lib.rs"],
    crate_name = "alondra_provider_contract",
    edition = "2024",
    version = "0.1.0",
    visibility = ["//crates:__subpackages__"],
    deps = ["//crates/foundation:foundation"],
)

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//crates:__pkg__"])

# Read by the crash report's build script for its log catalog and the words of the code.
filegroup(
    name = "report_sources",
    srcs = glob(["src/**/*.rs"]),
    visibility = ["//crates/alondra:__pkg__"],
)
