load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")

swift_library(
    name = "AlondraContracts",
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "AlondraContracts",
    visibility = ["//visibility:public"],
)

swift_library(
    name = "AlondraViewsContracts",
    srcs = glob(["Sources/*.swift"]),
    module_name = "AlondraContracts",
    copts = ["-D", "VIEWS_ONLY"],
    visibility = ["//visibility:public"],
)
