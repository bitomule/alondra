load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")

swift_library(
    name = "AlondraPushBinding",
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "AlondraPushBinding",
    visibility = ["//apple:__subpackages__"],
    deps = ["//apple/NotificationPayload:AlondraNotificationPayload"],
)

swift_test(
    name = "AlondraPushBindingTests",
    srcs = glob(["Tests/**/*.swift"]),
    deps = [":AlondraPushBinding", "//apple/NotificationPayload:AlondraNotificationPayload"],
)
