load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")

swift_library(
    name = "AlondraNotificationActions",
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "AlondraNotificationActions",
    features = ["swift.enable_testing"],
    visibility = ["//visibility:public"],
    deps = ["//apple/APIClient:AlondraAPIClient", "//apple/Contracts:AlondraContracts", "//apple/Domain:AlondraDomain", "//apple/NotificationPayload:AlondraNotificationPayload"],
)

swift_test(
    name = "AlondraNotificationActionsTests",
    srcs = glob(["Tests/**/*.swift"]),
    data = ["//fixtures/client-v2"],
    deps = ["//apple/ServicePairing:AlondraServicePairing", ":AlondraNotificationActions", "//apple/APIClient:AlondraAPIClient", "//apple/Contracts:AlondraContracts", "//apple/Domain:AlondraDomain", "//apple/NotificationPayload:AlondraNotificationPayload"],
)
