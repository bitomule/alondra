load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")

swift_library(
    name = "AlondraNotificationActions",
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "AlondraNotificationActions",
    visibility = ["//visibility:public"],
    deps = ["//apple/APIClient:AlondraAPIClient", "//apple/RelayClient:AlondraRelayClient", "//apple/Data/Commands:AlondraCommands", "//apple/NotificationPayload:AlondraNotificationPayload"],
)

swift_test(
    name = "AlondraNotificationActionsTests",
    srcs = glob(["Tests/**/*.swift"]),
    deps = [":AlondraNotificationActions", "//apple/RelayClient:AlondraRelayClient", "//apple/Data/Commands:AlondraCommands", "//apple/NotificationPayload:AlondraNotificationPayload"],
)
