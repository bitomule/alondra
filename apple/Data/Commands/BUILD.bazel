load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")

swift_library(
    name = "AlondraCommands",
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "AlondraCommands",
    visibility = ["//visibility:public"],
    deps = ["//apple/Domain:AlondraDomain", "//apple/Contracts:AlondraContracts"],
)

swift_test(
    name = "AlondraCommandsTests",
    srcs = glob(["Tests/**/*.swift"]),
    deps = [":AlondraCommands"],
)
