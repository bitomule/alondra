load("@build_bazel_rules_swift//swift:swift.bzl", "swift_binary", "swift_library", "swift_test")
load("//apple:swift.bzl", "STRICT_SWIFT_CONCURRENCY_COPTS")

swift_library(
    name = "AlondraFeed",
    copts = STRICT_SWIFT_CONCURRENCY_COPTS,
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "AlondraFeed",
    linkopts = ["-lsqlite3"],
    features = ["swift.enable_testing"],
    visibility = ["//visibility:public"],
    deps = [
        "//apple/Data/Transport:AlondraTransport",
        "//apple/Contract:AlondraContract",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

swift_test(
    name = "AlondraFeedTests",
    copts = STRICT_SWIFT_CONCURRENCY_COPTS,
    srcs = glob(["Tests/**/*.swift"]),
    deps = [
        ":AlondraFeed",
        "//apple/Testing:AlondraTestSupport",
        "//apple/Data/Transport:AlondraTransport",
        "//apple/Contract:AlondraContract",
    ],
)

# Runs only fixture children under Bazel's temporary directory; never launches a live daemon.
swift_binary(
    name = "ActionJournalProcessClient",
    testonly = True,
    copts = STRICT_SWIFT_CONCURRENCY_COPTS,
    srcs = glob(["ProcessFixtures/*.swift"]),
    deps = [
        ":AlondraFeed",
        "//apple/Contract:AlondraContract",
        "//apple/Data/Iroh:AlondraIroh",
        "//apple/Data/Transport:AlondraTransport",
    ],
)

swift_test(
    name = "ActionJournalProcessTests",
    copts = STRICT_SWIFT_CONCURRENCY_COPTS,
    srcs = ["ProcessTests/ActionJournalProcessTests.swift", "ProcessFixtures/ProcessProtocol.swift"],
    data = [":ActionJournalProcessClient", "//crates/alondrad:alondrad_test"],
    env_inherit = ["ALONDRA_MEASURE_RELAY"],
    deps = ["//apple/Contract:AlondraContract", "//apple/Testing:AlondraTestSupport"],
)

filegroup(
    name = "sources",
    srcs = glob(["Sources/**/*.swift"]),
    visibility = ["//apple:__pkg__"],
)
