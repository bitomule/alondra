load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")

swift_library(
    name = "AlondraWorkspace",
    testonly = True,
    module_name = "AlondraWorkspace",
    srcs = glob(["Sources/*.swift"], exclude = ["Sources/ViewsCloudAppServices.swift"]),
    visibility = ["//visibility:public"],
    deps = [
        "//apple:AlondraShared",
        "//apple/Contracts:AlondraContracts",
        "//apple/Domain:AlondraDomain",
        "//apple/APIClient:AlondraAPIClient",
        "//apple/Auth:AlondraAuth",
        "//apple/ServicePairing:AlondraServicePairing",
        "//apple/Data/AttachmentStorage:AlondraAttachmentStorage",
        "//apple/Data/Recovery:AlondraRecovery",
        "//apple/Data/RelayOutbox:AlondraRelayOutbox",
        "//apple/Data/RelaySession:AlondraRelaySession",
        "//apple/Data/LoopbackSession:AlondraLoopbackSession",
        "//apple/Data/Sync:AlondraSync",
        "//apple/Data/Views:AlondraViewsData",
        "//apple/Data/Notifications:AlondraNotificationActions",
        "//apple/NotificationPayload:AlondraNotificationPayload",
    ],
)

swift_library(
    name = "AlondraViewsWorkspaceServices",
    module_name = "AlondraViewsWorkspaceServices",
    srcs = ["Sources/ViewsCloudAppServices.swift", "Sources/ConnectionClassifier.swift"],
    visibility = ["//visibility:public"],
    deps = [
        "//apple/APIClient:AlondraViewsAPIClient",
        "//apple/Auth:AlondraAuth",
        "//apple/Contracts:AlondraViewsContracts",
        "//apple/Data/LoopbackSession:AlondraViewsLoopbackSession",
        "//apple/Data/Notifications:AlondraViewsNotificationActions",
        "//apple/Data/RelayOutbox:AlondraViewsRelayOutbox",
        "//apple/Data/RelaySession:AlondraViewsRelaySession",
        "//apple/Data/Sync:AlondraNetworkReachability",
        "//apple/Data/Views:AlondraViewsOnlyData",
        "//apple/NotificationPayload:AlondraNotificationPayload",
        "//apple/ServicePairing:AlondraViewsServicePairing",
        "//apple/Views:AlondraViews",
    ],
)

swift_test(
    name = "AlondraWorkspaceTests",
    srcs = glob(["Tests/*.swift"]),
    deps = [
        ":AlondraWorkspace",
        "//apple/Data/Notifications:AlondraNotificationActions",
        "//apple/NotificationPayload:AlondraNotificationPayload",
        "//apple/APIClient:AlondraAPIClient",
        "//apple/Auth:AlondraAuth",
        "//apple/Contracts:AlondraContracts",
        "//apple/Domain:AlondraDomain",
        "//apple/Data/LoopbackSession:AlondraLoopbackSession",
        "//apple/Data/RelaySession:AlondraRelaySession",
        "//apple/Data/Views:AlondraViewsData",
        "//apple/Views:AlondraViews",
    ],
)
