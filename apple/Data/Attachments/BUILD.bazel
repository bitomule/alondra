load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")
swift_library(
    name = "AlondraAttachmentsData",
    module_name = "AlondraAttachmentsData",
    srcs = glob(["Sources/*.swift"]),
    visibility = ["//visibility:public"],
    deps = ["//apple:AlondraShared", "//apple/Data/AttachmentStorage:AlondraAttachmentStorage", "//apple/Domain:AlondraDomain"],
)

swift_library(
    name = "AlondraViewsAttachmentsData",
    module_name = "AlondraAttachmentsData",
    srcs = glob(["ViewsSources/*.swift"]),
    visibility = ["//visibility:public"],
    deps = ["//apple:AlondraViewsShared", "//apple/Features/Attachments:AlondraViewsAttachmentsFeature"],
)

# Keep the existing validation entry point while the suite belongs to headless storage.
alias(
    name = "AlondraAttachmentsDataTests",
    actual = "//apple/Data/AttachmentStorage:AlondraAttachmentStorageTests",
)

swift_test(
    name = "AlondraAttachmentImportTests",
    srcs = glob(["Tests/*.swift"]),
    deps = [
        ":AlondraAttachmentsData",
        "//apple/Data/AttachmentStorage:AlondraAttachmentStorage",
        "//apple/Domain:AlondraDomain",
    ],
)
