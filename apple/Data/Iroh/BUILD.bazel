load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")
load("//apple:swift.bzl", "STRICT_SWIFT_CONCURRENCY_COPTS")

# Generated by iroh-ffi (uniffi); compiled as published.
swift_library(
    name = "IrohLib",
    srcs = ["@irohlib_swift//file"],
    module_name = "IrohLib",
    deps = ["@iroh_xcframework//:Iroh"],
)

swift_library(
    name = "AlondraIroh",
    copts = STRICT_SWIFT_CONCURRENCY_COPTS,
    srcs = glob(["Sources/*.swift"]),
    module_name = "AlondraIroh",
    visibility = ["//visibility:public"],
    deps = [
        ":IrohLib",
        "//apple/Data/Transport:AlondraTransport",
    ],
)

# Runs the real daemon as a fixture child under the test's own temporary directory.
swift_test(
    name = "AlondraIrohProcessTests",
    copts = STRICT_SWIFT_CONCURRENCY_COPTS,
    srcs = glob(["ProcessTests/*.swift"]),
    data = ["//crates/alondrad:alondrad_test"],
    deps = [
        ":AlondraIroh",
        "//apple/Data/Transport:AlondraTransport",
        "//apple/Testing:AlondraTestSupport",
    ],
)

filegroup(
    name = "sources",
    srcs = glob(["Sources/**/*.swift"]),
    visibility = ["//apple:__pkg__"],
)
