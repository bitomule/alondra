load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")

swift_library(
    name = "AlondraAttachmentStorage",
    module_name = "AlondraAttachmentStorage",
    srcs = glob(["Sources/*.swift"]),
    visibility = ["//visibility:public"],
    deps = ["//apple/Domain:AlondraDomain"],
)

swift_test(
    name = "AlondraAttachmentStorageTests",
    srcs = glob(["Tests/*.swift"]),
    deps = [":AlondraAttachmentStorage"],
)
