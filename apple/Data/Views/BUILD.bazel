load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")

swift_library(
    name = "AlondraViewsOnlyData",
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "AlondraViewsData",
    visibility = ["//visibility:public"],
    deps = ["//apple/APIClient:AlondraViewsAPIClient", "//apple/Contracts:AlondraViewsContracts", "//apple/Views:AlondraViews"],
    features = ["swift.enable_testing"],
)

swift_test(
    name = "AlondraViewsDataTests",
    srcs = glob(["Tests/**/*.swift"]),
    deps = [":AlondraViewsOnlyData", "//apple/APIClient:AlondraViewsAPIClient", "//apple/Views:AlondraViews"],
)
