load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")

swift_library(
    name = "AlondraDomain",
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "AlondraDomain",
    visibility = ["//visibility:public"],
    deps = ["//apple/Contracts:AlondraContracts"],
)

swift_test(
    name = "AlondraDomainTests",
    srcs = glob(["Tests/**/*.swift"]),
    deps = [
        ":AlondraDomain",
        "//apple/Contracts:AlondraContracts",
    ],
)
