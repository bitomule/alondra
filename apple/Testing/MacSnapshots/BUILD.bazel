load("@build_bazel_rules_swift//swift:swift.bzl", "swift_test")
load("//apple:swift.bzl", "STRICT_SWIFT_CONCURRENCY_COPTS")

# The strings the Mac app ships, as the `.lproj` folders the test bundle finds. `en` stays empty so
# English remains the preferred language and a key renders as itself; `es` is what a Spanish capture reads. Plural
# variations go to `.stringsdict`, as the app's compiled catalog has them, so a Spanish count reads in Spanish.
# The design library's own table is there too, so its Spanish reads in Spanish.
genrule(
    name = "localizations",
    srcs = ["//apple:macOS/Resources/Localizable.xcstrings", "//apple/Design:Resources/AlondraDesign.xcstrings"],
    outs = [
        "AlondraMacSnapshotTests.xctest/Contents/Resources/en.lproj/Localizable.strings",
        "AlondraMacSnapshotTests.xctest/Contents/Resources/es.lproj/Localizable.strings",
        "AlondraMacSnapshotTests.xctest/Contents/Resources/en.lproj/Localizable.stringsdict",
        "AlondraMacSnapshotTests.xctest/Contents/Resources/es.lproj/Localizable.stringsdict",
        "AlondraMacSnapshotTests.xctest/Contents/Resources/es.lproj/AlondraDesign.strings",
        "AlondraMacSnapshotTests.xctest/Contents/Resources/es.lproj/AlondraDesign.stringsdict",
    ],
    cmd = "python3 $(location xcstrings_to_strings.py) en $(RULEDIR)/AlondraMacSnapshotTests.xctest/Contents/Resources/en.lproj/Localizable.strings $(SRCS) && " +
          "python3 $(location xcstrings_to_strings.py) es $(RULEDIR)/AlondraMacSnapshotTests.xctest/Contents/Resources/es.lproj/Localizable.strings $(SRCS) && " +
          "python3 $(location xcstrings_to_strings.py) es $(RULEDIR)/AlondraMacSnapshotTests.xctest/Contents/Resources/es.lproj/AlondraDesign.strings $(location //apple/Design:Resources/AlondraDesign.xcstrings)",
    tools = ["xcstrings_to_strings.py"],
)

# The Mac window's own screens, in English and Spanish, drawn the way the daemon serves them to the Mac (`client: mac`) and
# captured through an NSHostingView, so a change to what the Mac shows is seen without launching it.
swift_test(
    name = "AlondraMacSnapshotTests",
    timeout = "moderate",
    copts = STRICT_SWIFT_CONCURRENCY_COPTS,
    args = ["-AppleLanguages", "(en)", "-AppleLocale", "en_US"],
    srcs = glob(["Tests/*.swift"]) + [
        "//apple/Testing/Snapshots:Support/AssertAppSnapshot.swift",
        "//apple/Testing/Fixtures:DiffFixture.swift",
        "//apple/Testing/Fixtures:RequestedFormCard.swift",
        "//apple/Testing/Fixtures:SpanishTestData.swift",
    ],
    data = glob(["Tests/__Snapshots__/**"], allow_empty = True) + [
        "//apple:macOS/Resources/Localizable.xcstrings",
        "//apple/Design:Resources/AlondraDesign.xcstrings",
        "//fixtures/diffs",
        "//fixtures/views:cards",
        "//fixtures/views:metrics",
        "//fixtures/views:newer_daemon",
        "//fixtures/views:pr_images",
        ":localizations",
    ],
    env = {
        "SNAPSHOT_ROOT": "apple/Testing/MacSnapshots/Tests/__Snapshots__",
        "TZ": "UTC",
    },
    # IssueReporting resolves its reporter with dlsym; retain it under -dead_strip.
    linkopts = ["-Wl,-export_dynamic"],
    deps = [
        "//apple:AlondraMacWorkspace",
        "//apple/Contract:AlondraContract",
        "//apple/Data/Feed:AlondraFeed",
        "//apple/Design:AlondraDesign",
        "//apple/Features:AlondraFeatures",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
        "@swiftpkg_swift_snapshot_testing//:SnapshotTesting",
        "@swiftpkg_swift_issue_reporting//:IssueReportingTestSupport",
    ],
)
