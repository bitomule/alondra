load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")
load("//apple:swift.bzl", "STRICT_SWIFT_CONCURRENCY_COPTS")

swift_test(
    name = "IssueReportingIntegrationTests",
    copts = STRICT_SWIFT_CONCURRENCY_COPTS,
    srcs = ["IssueReportingIntegrationTests.swift"],
    deps = [
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
        "@swiftpkg_swift_issue_reporting//:IssueReportingTestSupport",
    ],
    linkopts = ["-Wl,-export_dynamic"],
)

swift_library(
    name = "AlondraTestSupport",
    testonly = True,
    srcs = ["TemporaryFiles.swift"],
    module_name = "AlondraTestSupport",
    copts = STRICT_SWIFT_CONCURRENCY_COPTS,
    visibility = ["//visibility:public"],
)

swift_test(
    name = "TemporaryFilesTests",
    srcs = ["TemporaryFilesTests.swift"],
    copts = STRICT_SWIFT_CONCURRENCY_COPTS,
    deps = [":AlondraTestSupport"],
)
