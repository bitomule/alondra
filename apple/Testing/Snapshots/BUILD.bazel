load("@build_bazel_rules_apple//apple:ios.bzl", "ios_application", "ios_unit_test")
load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")
load("@simpool//:simpool_ios_test_runner.bzl", "simpool_ios_test_runner")
load("//apple:swift.bzl", "STRICT_SWIFT_CONCURRENCY_COPTS")

exports_files(
    ["Support/AssertAppSnapshot.swift"],
    visibility = [
        "//apple/Mermaid:__pkg__",
        "//apple/Testing/MacSnapshots:__pkg__",
    ],
)

# One canonical simulator and OS, so a baseline is recorded and verified on the same renderer.
# `-collect-test-diagnostics never`: a target with a `test_host` is driven through `xcodebuild`,
# which afterwards runs `xcrun simctl diagnose --timeout=600` against the pool simulator; that
# collection never completes and holds the pool slot for its whole timeout.
# Left alone, `xcodebuild` writes each run's result bundle into a new
# `~/Library/Developer/Xcode/DerivedData/temporary-*` folder that nothing deletes: 440 MB per
# failing or recording run, because every snapshot is attached. The bundle goes to the test's
# own outputs instead (replaced on every run, dropped on success by `KEEP_XCRESULT_ON_SUCCESS=0`),
# and the rest of DerivedData to the test's temporary directory. simpool splices
# `xcodebuild_args` unquoted into a bash array, so `$TEST_TMPDIR` expands when the test runs.
simpool_ios_test_runner(
    name = "iphone_17_pro_runner",
    create_xcresult_bundle = True,
    device_type = "iPhone 17 Pro",
    os_version = "26.3",
    pre_action = "//apple/Testing/Simulator:uninstall_test_host",
    visibility = ["//apple/Mermaid:__pkg__"],
    xcodebuild_args = [
        "-collect-test-diagnostics",
        "never",
        "-IDECustomDerivedDataLocation=\"$TEST_TMPDIR/DerivedData\"",
    ],
)

# SwiftUI snapshot strategies render through a real UIWindowScene; in a bare logic test bundle the
# iOS 26 simulator crashes while tearing the scene down. Hosting the bundle in this stub app gives
# it the scene lifecycle.
swift_library(
    name = "SnapshotTestHostLib",
    testonly = True,
    srcs = ["TestHost/TestHostApp.swift"],
    copts = STRICT_SWIFT_CONCURRENCY_COPTS,
    module_name = "SnapshotTestHost",
)

# The app's strings live in the host, as they do in the app, so a screen drawn in Spanish finds them.
ios_application(
    name = "SnapshotTestHost",
    testonly = True,
    bundle_id = "com.bitomule.alondra.snapshottesthost",
    families = ["iphone"],
    infoplists = ["TestHost/Info.plist"],
    minimum_os_version = "26.0",
    resources = [
        "//apple:iOS/Resources/Localizable.xcstrings",
        "//apple:iOSLiveActivity/Resources/LiveActivity.xcstrings",
    ],
    visibility = ["//apple/Mermaid:__pkg__"],
    deps = [":SnapshotTestHostLib"],
)

swift_library(
    name = "AlondraSnapshotTestsLib",
    testonly = True,
    srcs = glob([
        "Support/*.swift",
        "Tests/*.swift",
    ]) + ["//apple/Testing/Fixtures:sources"],
    copts = STRICT_SWIFT_CONCURRENCY_COPTS,
    module_name = "AlondraSnapshotTestsLib",
    deps = [
        "//apple/Contract:AlondraContract",
        "//apple/Data/Feed:AlondraFeed",
        "//apple/Data/LiveActivity:AlondraLiveActivity",
        "//apple:AlondraLiveActivityUI",
        "//apple/Design:AlondraDesign",
        "//apple/Features:AlondraFeatures",
        "//apple/Data/Transport:AlondraTransport",
        "//apple/iOS/UI:AlondraiOSUI",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
        "@swiftpkg_swift_snapshot_testing//:SnapshotTesting",
    ],
)

DETAIL_SUITES = [
    "CardDetailSnapshotTests",
    "MachineBadgeSnapshotTests",
    "PRChangesSnapshotTests",
    "PRReviewSnapshotTests",
]

TRIAGE_SUITE = "TriageSnapshotTests"

# Text on the cards drawn in a process's first seconds comes out a few levels off its baseline, and
# only under load. Every target draws this suite first, as the baselines were recorded.
FIRST_SUITE = "AccountSnapshotTests"

# The suites take about 200 seconds in one simulator, so three targets run them side by side, each
# on its own simulator slot. The last one skips what the others run: a new suite always runs.
[
    ios_unit_test(
        name = name,
        timeout = "moderate",
        bundle_id = "com.bitomule.alondra.snapshottests",
        data = glob(["Tests/__Snapshots__/**"], allow_empty = True) + [
            "Fixtures/pairing-native-label.png",
            "//apple:iOS/Resources/Localizable.xcstrings",
            "//apple/Testing/Samples:all",
            "//fixtures/diffs",
            "//fixtures/views:all",
            "//fixtures/views:cards",
            "//fixtures/views:metrics",
            "//fixtures/views:newer_daemon",
        ],
        env = {
            "KEEP_XCRESULT_ON_SUCCESS": "0",
            "TEST_HOST_BUNDLE_ID": "com.bitomule.alondra.snapshottesthost",
            "SNAPSHOT_ROOT": "apple/Testing/Snapshots/Tests/__Snapshots__",
        },
        minimum_os_version = "26.0",
        runner = ":iphone_17_pro_runner",
        test_filter = test_filter,
        test_host = ":SnapshotTestHost",
        deps = [":AlondraSnapshotTestsLib"],
    )
    for name, test_filter in {
        "AlondraDetailSnapshotTests": ",".join([FIRST_SUITE] + DETAIL_SUITES),
        "AlondraScreenSnapshotTests": ",".join(["-" + suite for suite in DETAIL_SUITES + [TRIAGE_SUITE]]),
        "AlondraTriageSnapshotTests": ",".join([FIRST_SUITE, TRIAGE_SUITE]),
    }.items()
]

test_suite(
    name = "AlondraSnapshotTests",
    tests = [
        ":AlondraDetailSnapshotTests",
        ":AlondraScreenSnapshotTests",
        ":AlondraTriageSnapshotTests",
    ],
    visibility = ["//visibility:public"],
)
