class LR
class Request "Request"
  attribute "+String text"
  attribute "+Date created"
class Task "Task"
  attribute "+String id"
  attribute "+Plan plan"
  method "+start()"
  method "+close()"
class Node "Node"
  attribute "+String session"
  attribute "+Model model"
class Card "Card" <<enumeration>>
  attribute "ask"
  attribute "result"
  attribute "plan"
relation Request none solid arrow Task from="1" to="0..1" "becomes"
relation Task composition solid none Node from="1" to="1" "runs on"
relation Task aggregation solid none Card "shows"
