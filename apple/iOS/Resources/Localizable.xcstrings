    "Collapsed": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Plegado"}}}},
    "Decide": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Decidir"}}}},
    "Authorize": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Autorizar"}}}},
    "Provide": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Aportar"}}}},
    "Test": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Probar"}}}},
    "Do": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Hacer"}}}},
    "Problem": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Problema"}}}},
    "Propose": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Propuesta"}}}},
    "Know": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Info"}}}},
    "Opens the details": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Abre el detalle"}}}},
    "More actions": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Más acciones"}}}},
    "Reply to the node…": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Responder al nodo…"}}}},
    "since": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "desde"}}}},
    "Pause": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Pausar"}}}},
    "Resume": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Reanudar"}}}},
    "Running": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "En marcha"}}}},
