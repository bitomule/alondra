          "stringUnit": {
            "state": "translated",
            "value": "Pasos"
          }
        }
      }
    },
    "Update Alondra to use this": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Actualiza Alondra para usar esto"}}}},
    "Update Alondra to see this": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Actualiza Alondra para ver esto"}}}},
    "Waiting to send": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Esperando para enviar"}}}},
    "Uploading attachments…": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Subiendo adjuntos…"}}}},
    "Not confirmed yet · Retrying…": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Sin confirmar · Reintentando…"}}}},
    "Not sent": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "No enviada"}}}},
    "Loading options…": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Cargando opciones…"}}}},
    "Discard": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Descartar"}}}},
    "Connection measurements": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Medidas de conexión"}}}},
    "No requests measured yet.": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Aún no hay peticiones medidas."}}}},
    "Share measurements": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Compartir medidas"}}}},
    "Clear measurements": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Borrar medidas"}}}},
    "How long each request to your Macs took, by path and network. Only times and paths are kept, nothing about your work.": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Cuánto tardó cada petición a tus Macs, por ruta y red. Solo se guardan tiempos y rutas, nada de tu trabajo."}}}},
    "Direct connection": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Conexión directa"}}}},
    "Live relay": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Relay en vivo"}}}},
    "Opening the connection": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Abrir la conexión"}}}},
    "Couldn’t reach your Mac": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "No se pudo llegar a tu Mac"}}}},
    "Your answer will be sent when you open Alondra.": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Tu respuesta se enviará cuando abras Alondra."}}}},
    "Your answer to %@ will be sent when you open Alondra.": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Tu respuesta a %@ se enviará cuando abras Alondra."}}}},
    "Opening the connection in the background": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Abrir la conexión en segundo plano"}}}},
    "Live updates · %@": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Actualizaciones en directo · %@"}}}},
    "No answer": {"localizations": {"es": {"stringUnit": {"state": "translated", "value": "Sin respuesta"}}}},
