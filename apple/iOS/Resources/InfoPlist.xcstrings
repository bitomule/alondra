{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alondra uses the camera to read the QR code that pairs this iPhone with your Mac, and to take photos you attach to a message."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alondra usa la cámara para leer el código QR con el que vinculas este iPhone a tu Mac, y para hacer las fotos que adjuntas a un mensaje."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alondra finds the Macs running Alondra on this network and connects to them directly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alondra busca los Mac de esta red que usan Alondra y se conecta a ellos directamente."
          }
        }
      }
    }
  },
  "version": "1.0"
}
