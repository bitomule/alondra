load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")

swift_library(
    name = "AlondraHomeFeature",
    srcs = glob(["Sources/*.swift"]),
    module_name = "AlondraHomeFeature",
    visibility = ["//visibility:public"],
    deps = [
        "//apple/Features/Attachments:AlondraAttachmentsFeature",
        "//apple/Views:AlondraViews",
        "//apple/Features/ViewsDependency:AlondraViewsDependency",
        "//apple/Features/ViewsUI:AlondraViewsUI",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

swift_test(
    name = "AlondraHomeFeatureTests",
    srcs = glob(["Tests/*.swift"]),
    data = ["//fixtures/views:all"],
    deps = [
        ":AlondraHomeFeature",
        "//apple/Views:AlondraViews",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)
