load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")

swift_library(
    name = "AlondraQuestionsFeature",
    srcs = glob(["Sources/*.swift"]),
    module_name = "AlondraQuestionsFeature",
    visibility = ["//visibility:public"],
    deps = [
        "//apple:AlondraShared",
        "//apple/Domain:AlondraDomain",
        "//apple/Contracts:AlondraContracts",
        "//apple/Features/Attachments:AlondraAttachmentsFeature",
        "//apple/Features/DomainDependency:AlondraDomainDependency",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

swift_test(
    # IssueReporting resolves its reporter with dlsym; retain it under -dead_strip.
    linkopts = ["-Wl,-export_dynamic"],
    name = "AlondraQuestionsFeatureTests",
    srcs = glob(["Tests/*.swift"]),
    data = ["//apple/APIClient:domain_v2_wire_fixtures"],
    deps = [
        ":AlondraQuestionsFeature",
        "//apple:AlondraShared",
        "//apple/Domain:AlondraDomain",
        "//apple/Contracts:AlondraContracts",
        "//apple/Features/Attachments:AlondraAttachmentsFeature",
        "//apple/Features/DomainDependency:AlondraDomainDependency",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
        "@swiftpkg_xctest_dynamic_overlay//:IssueReportingTestSupport",
    ],
)
