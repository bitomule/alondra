load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")

filegroup(
    name = "sources",
    srcs = glob(["Sources/**/*.swift"]),
    visibility = ["//apple:__pkg__"],
)

swift_library(
    name = "AlondraViewsOnlyUI",
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "AlondraViewsUI",
    visibility = ["//visibility:public"],
    deps = [
        "//apple/Features/Attachments:AlondraViewsAttachmentsFeature",
        "//apple:AlondraViewsShared",
        "//apple/Features/ViewsDependency:AlondraViewsOnlyDependency",
        "//apple/Views:AlondraViews",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

swift_test(
    name = "AlondraViewsUITests",
    srcs = glob(["Tests/**/*.swift"]),
    data = ["//fixtures/views:all"],
    deps = [
        ":AlondraViewsOnlyUI",
        "//apple/Views:AlondraViews",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)
