load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")
load("//apple:swift.bzl", "STRICT_SWIFT_CONCURRENCY_COPTS")

swift_library(
    name = "AlondraDesign",
    copts = STRICT_SWIFT_CONCURRENCY_COPTS,
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "AlondraDesign",
    features = ["swift.enable_testing"],
    data = glob(["Resources/*.xcstrings"]),
    visibility = ["//visibility:public"],
    deps = [
        "//apple/Contract:AlondraContract",
        "//apple/Data/Attachments:AlondraAttachments",
        "//apple/Mermaid:AlondraMermaid",
        "@swiftpkg_highlightswift//:HighlightSwift",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

swift_test(
    name = "AlondraDesignTests",
    size = "small",
    copts = STRICT_SWIFT_CONCURRENCY_COPTS,
    srcs = glob(["Tests/**/*.swift"]),
    data = [
        "Resources/AlondraDesign.xcstrings",
        "//fixtures/diffs",
        "//fixtures/markdown",
    ],
    deps = [
        ":AlondraDesign",
        "//apple/Testing:AlondraTestSupport",
        "//apple/Contract:AlondraContract",
        "//apple/Mermaid:AlondraMermaid",
    ],
)

exports_files(["Resources/AlondraDesign.xcstrings"])

filegroup(
    name = "sources",
    srcs = glob(["Sources/**/*.swift"]),
    visibility = ["//apple:__pkg__"],
)
