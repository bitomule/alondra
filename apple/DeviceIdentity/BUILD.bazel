load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")

swift_library(
    name = "AlondraDeviceIdentity",
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "AlondraDeviceIdentity",
    visibility = ["//visibility:public"],
    deps = ["//apple/APIClient:AlondraAPIClient"],
)

swift_test(
    name = "AlondraDeviceIdentityTests",
    srcs = glob(["Tests/**/*.swift"]),
    deps = [":AlondraDeviceIdentity", "//apple/APIClient:AlondraAPIClient"],
)
