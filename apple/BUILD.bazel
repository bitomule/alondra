load("@build_bazel_rules_apple//apple:ios.bzl", "ios_application", "ios_extension")
load("@build_bazel_rules_apple//apple:macos.bzl", "macos_application")
load("@build_bazel_rules_apple//apple:versioning.bzl", "apple_bundle_version")
load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")
load("@alondra_signing//:signing.bzl", "IOS_BUNDLE_ID", "IOS_PROFILE", "MAC_BUNDLE_ID", "NOTIFICATION_SERVICE_BUNDLE_ID", "NOTIFICATION_SERVICE_PROFILE")

swift_library(
    name = "AlondraShared",
    srcs = glob(
        ["Shared/Sources/**/*.swift"],
        exclude = ["Shared/Sources/DeviceKeyStore.swift", "Shared/Sources/RequestSigning.swift"],
    ),
    data = ["Shared/Resources/AlondraShared.xcstrings"],
    module_name = "AlondraShared",
    visibility = ["//visibility:public"],
    deps = [
        "//apple/APIClient:AlondraAPIClient",
        "//apple/Data/Commands:AlondraCommands",
        "//apple/Contracts:AlondraContracts",
        "//apple/Domain:AlondraDomain",
        "@swiftpkg_highlightswift//:HighlightSwift",
    ],
)

swift_test(
    name = "AlondraSharedTests",
    srcs = glob(["Shared/Tests/**/*.swift"]),
    data = ["//fixtures/markdown"],
    deps = [":AlondraShared", "//apple/APIClient:AlondraAPIClient", "//apple/Data/Commands:AlondraCommands"],
)

swift_library(
    name = "AlondraMacEntry",
    srcs = glob(["macOS/Sources/**/*.swift"]),
    module_name = "AlondraMac",
    deps = [
        ":AlondraShared",
        "//apple/Features/Fleet:AlondraFleetFeature",
        "//apple/Features/NewWork:AlondraNewWorkFeature",
        "//apple/Domain:AlondraDomain",
        "//apple/Contracts:AlondraContracts",
        "//apple/Features/Questions:AlondraQuestionsFeature",
        "//apple/Features/Tasks:AlondraTasksFeature",
        "//apple/Features/PullRequests:AlondraPullRequestsFeature",
        "//apple/Features/Workspace:AlondraWorkspaceFeature",
        "//apple/Features/Attachments:AlondraAttachmentsFeature",
        "//apple/Demo:AlondraDemoWorkspace",
        "//apple/Features/Settings:AlondraSettingsFeature",
        "//apple/Auth:AlondraAuth",
        "//apple/AppComposition:AlondraAppComposition",
        "//apple/Features/CloudPairing:AlondraCloudPairingFeature",
        "//apple/APIClient:AlondraAPIClient",
        "//apple/Data/Commands:AlondraCommands",
        "//apple/Data/Sync:AlondraSync",
        "//apple/DeviceIdentity:AlondraDeviceIdentity",
        "//apple/macOS/Feature:AlondraMacFeature",
        "//apple/Features/Triage:AlondraTriageFeature",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

swift_test(
    name = "AlondraMacTriageIntegrationTests",
    srcs = glob(
        ["macOS/Sources/**/*.swift", "macOS/Tests/*.swift"],
        exclude = ["macOS/Sources/AlondraMacApp.swift"],
    ),
    deps = [
        ":AlondraShared",
        "//apple/Features/Fleet:AlondraFleetFeature",
        "//apple/Features/NewWork:AlondraNewWorkFeature",
        "//apple/Domain:AlondraDomain",
        "//apple/Contracts:AlondraContracts",
        "//apple/Features/Questions:AlondraQuestionsFeature",
        "//apple/Features/Tasks:AlondraTasksFeature",
        "//apple/Features/PullRequests:AlondraPullRequestsFeature",
        "//apple/Features/Workspace:AlondraWorkspaceFeature",
        "//apple/Features/Attachments:AlondraAttachmentsFeature",
        "//apple/Demo:AlondraDemoWorkspace",
        "//apple/Features/Settings:AlondraSettingsFeature",
        "//apple/Auth:AlondraAuth",
        "//apple/AppComposition:AlondraAppComposition",
        "//apple/Features/CloudPairing:AlondraCloudPairingFeature",
        "//apple/APIClient:AlondraAPIClient",
        "//apple/Data/Commands:AlondraCommands",
        "//apple/Data/Sync:AlondraSync",
        "//apple/DeviceIdentity:AlondraDeviceIdentity",
        "//apple/macOS/Feature:AlondraMacFeature",
        "//apple/Features/Triage:AlondraTriageFeature",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

macos_application(
    name = "AlondraMac",
    app_icons = glob(["IconConcepts/Alondra.icon/**"]),
    bundle_id = MAC_BUNDLE_ID,
    bundle_name = "Alondra",
    infoplists = ["macOS/Info.plist"],
    minimum_os_version = "26.0",
    resources = glob(["macOS/Resources/*.xcstrings"]),
    version = ":Version",
    visibility = ["//visibility:public"],
    deps = [":AlondraMacEntry"],
)

apple_bundle_version(
    name = "Version",
    build_version = "1",
    short_version_string = "0.1.0",
)

swift_library(
    name = "AlondraiOSEntry",
    srcs = glob(["iOS/Sources/**/*.swift"]),
    module_name = "AlondraiOS",
    deps = [
        ":AlondraShared",
        "//apple/Features/Fleet:AlondraFleetFeature",
        "//apple/Features/NewWork:AlondraNewWorkFeature",
        "//apple/Domain:AlondraDomain",
        "//apple/Contracts:AlondraContracts",
        "//apple/Features/Workspace:AlondraWorkspaceFeature",
        "//apple/Features/Attachments:AlondraAttachmentsFeature",
        "//apple/Demo:AlondraDemoWorkspace",
        "//apple/Features/Settings:AlondraSettingsFeature",
        "//apple/Features/PullRequests:AlondraPullRequestsFeature",
        "//apple/Features/Questions:AlondraQuestionsFeature",
        "//apple/Features/Tasks:AlondraTasksFeature",
        "//apple/Auth:AlondraAuth",
        "//apple/AppComposition:AlondraAppComposition",
        "//apple/Features/CloudPairing:AlondraCloudPairingFeature",
        "//apple/ServicePairing:AlondraServicePairing",
        "//apple/Data/RelaySession:AlondraRelaySession",
        "//apple/Data/RelayOutbox:AlondraRelayOutbox",
        "//apple/APIClient:AlondraAPIClient",
        "//apple/Data/Commands:AlondraCommands",
        "//apple/Data/Notifications:AlondraNotificationActions",
        "//apple/Data/PushBinding:AlondraPushBinding",
        "//apple/Data/Sync:AlondraSync",
        "//apple/DeviceIdentity:AlondraDeviceIdentity",
        "//apple/NotificationPayload:AlondraNotificationPayload",
        "//apple/iOS/Feature:AlondraiOSFeature",
        "//apple/Features/Triage:AlondraTriageFeature",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

ios_application(
    name = "AlondraiOS",
    app_icons = glob(["IconConcepts/Alondra.icon/**"]),
    bundle_id = IOS_BUNDLE_ID,
    provisioning_profile = "//signing:" + IOS_PROFILE,
    bundle_name = "Alondra",
    entitlements = "iOS/Alondra.entitlements",
    families = ["iphone"],
    infoplists = ["iOS/Info.plist"],
    minimum_os_version = "26.0",
    resources = glob(["iOS/Resources/*.xcstrings"]),
    version = ":Version",
    extensions = [":AlondraNotificationService"],
    visibility = ["//visibility:public"],
    deps = [":AlondraiOSEntry"],
)

swift_library(
    name = "AlondraNotificationServiceLib",
    srcs = glob(["iOSNotificationService/Sources/**/*.swift"]),
    module_name = "AlondraNotificationService",
    deps = ["//apple/NotificationPayload:AlondraNotificationPayload", "//apple/Data/Notifications:AlondraNotificationActions"],
)

ios_extension(
    name = "AlondraNotificationService",
    entitlements = "iOSNotificationService/AlondraNotificationService.entitlements",
    bundle_id = NOTIFICATION_SERVICE_BUNDLE_ID,
    bundle_name = "AlondraNotificationService",
    families = ["iphone"],
    infoplists = ["iOSNotificationService/Info.plist"],
    minimum_os_version = "26.0",
    resources = glob(["iOSNotificationService/Resources/*.xcstrings"]),
    provisioning_profile = "//signing:" + NOTIFICATION_SERVICE_PROFILE,
    version = ":Version",
    deps = [":AlondraNotificationServiceLib"],
)
