load("@build_bazel_rules_apple//apple:ios.bzl", "ios_application", "ios_extension")
load("@build_bazel_rules_apple//apple:macos.bzl", "macos_application")
load("@build_bazel_rules_apple//apple:versioning.bzl", "apple_bundle_version")
load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")
load("@alondra_signing//:signing.bzl", "IOS_BUNDLE_ID", "IOS_PROFILE", "NOTIFICATION_SERVICE_BUNDLE_ID", "NOTIFICATION_SERVICE_PROFILE")
load("//apple:swift.bzl", "STRICT_SWIFT_CONCURRENCY_COPTS")
load("//tools:shared.bzl", "versions")

exports_files(
    ["iOS/Resources/Localizable.xcstrings", "macOS/Resources/Localizable.xcstrings"],
    visibility = ["//apple/Testing:__subpackages__"],
)

sh_test(
    name = "no_sleep_wording_test",
    srcs = ["no_sleep_wording_test.sh"],
    args = ["$(rootpaths :localization_catalogs)"],
    data = [":localization_catalogs"],
)

sh_test(
    name = "release_bonjour_test",
    srcs = ["release_bonjour_test.sh"],
    args = ["$(rootpath Bonjour/Bonjour.plist)", "$(rootpath iOS/Info.plist)", "$(rootpath macOS/Info.plist)"],
    data = ["Bonjour/Bonjour.plist", "iOS/Info.plist", "macOS/Info.plist"],
)

PUSH_KEYCHAIN_FILES = [
    "iOS/Info.plist",
    "iOSNotificationService/Info.plist",
    "iOS/Alondra.entitlements",
    "iOS/AppStore.entitlements",
    "iOSNotificationService/AlondraNotificationService.entitlements",
    "iOSNotificationService/AppStore.entitlements",
]

sh_test(
    name = "push_keychain_group_test",
    srcs = ["push_keychain_group_test.py"],
    args = ["$(rootpath %s)" % path for path in PUSH_KEYCHAIN_FILES],
    data = PUSH_KEYCHAIN_FILES,
)

UPDATE_KEEPS_SESSION_FILES = [
    "iOS/Alondra.entitlements",
    "iOS/AppStore.entitlements",
    "iOS/ViewsShipping/AccountBootstrap.swift",
    "//apple/Data/Account:Sources/Auth/KeychainRefreshTokenStorage.swift",
    "//apple/Data/Account:Sources/Composition/AppStorageLocation.swift",
    "//apple/Data/Pairing:Sources/PairingStore.swift",
]

sh_test(
    name = "update_keeps_session_test",
    srcs = ["update_keeps_session_test.py"],
    args = ["$(rootpath %s)" % path for path in UPDATE_KEEPS_SESSION_FILES],
    data = UPDATE_KEEPS_SESSION_FILES,
)

sh_test(
    name = "spanish_catalog_test",
    srcs = ["spanish_catalog_test.py"],
    args = [
        "$(rootpath //apple/Design:Resources/AlondraDesign.xcstrings)",
        "$(rootpath iOS/Resources/Localizable.xcstrings)",
        "$(rootpath macOS/Resources/Localizable.xcstrings)",
        "$(rootpaths :view_sources)",
    ],
    data = [
        "//apple/Design:Resources/AlondraDesign.xcstrings",
        "iOS/Resources/Localizable.xcstrings",
        "macOS/Resources/Localizable.xcstrings",
        ":view_sources",
    ],
)

filegroup(
    name = "view_sources",
    srcs = glob([
        "iOS/ViewsShipping/*.swift",
        "macOS/ViewsShipping/*.swift",
        "macOS/Workspace/*.swift",
    ]) + ["//apple/Features:sources", "//apple/iOS/UI:sources"],
)

APP_SOURCES = [
    ":view_sources",
    "//apple/Contract:sources",
    "//apple/Data/Account:sources",
    "//apple/Data/Attachments:sources",
    "//apple/Data/Feed:sources",
    "//apple/Data/Iroh:sources",
    "//apple/Data/Notifications:sources",
    "//apple/Data/Pairing:sources",
    "//apple/Data/Sync:sources",
    "//apple/Data/Transport:sources",
    "//apple/Demo:sources",
    "//apple/Design:sources",
    "//apple/Mermaid:sources",
]

sh_test(
    name = "unused_catalog_strings_test",
    srcs = ["unused_catalog_strings_test.py"],
    args = [
        "$(rootpath //apple/Design:Resources/AlondraDesign.xcstrings)",
        "$(rootpath iOS/Resources/Localizable.xcstrings)",
        "$(rootpath macOS/Resources/Localizable.xcstrings)",
    ] + ["$(rootpaths %s)" % sources for sources in APP_SOURCES],
    data = [
        "//apple/Design:Resources/AlondraDesign.xcstrings",
        "iOS/Resources/Localizable.xcstrings",
        "macOS/Resources/Localizable.xcstrings",
    ] + APP_SOURCES,
)

filegroup(
    name = "localization_catalogs",
    srcs = [
        "//apple/Design:Resources/AlondraDesign.xcstrings",
        "iOS/Resources/Localizable.xcstrings",
        "macOS/Resources/Localizable.xcstrings",
    ],
)

swift_test(
    copts = STRICT_SWIFT_CONCURRENCY_COPTS,
    # IssueReporting resolves its reporter with dlsym; retain it under -dead_strip.
    linkopts = ["-Wl,-export_dynamic"],
    name = "AlondraMacWorkspaceOwnerTests",
    srcs = ["macOS/Tests/MacWorkspaceOwnerTests.swift"],
    deps = [
        "//apple/Testing:AlondraTestSupport",
        "//apple/Data/Account:AlondraAccount",
        "//apple/Data/Transport:AlondraTransport",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
        "@swiftpkg_swift_issue_reporting//:IssueReportingTestSupport",
    ],
)

swift_test(
    copts = STRICT_SWIFT_CONCURRENCY_COPTS,
    # IssueReporting resolves its reporter with dlsym; retain it under -dead_strip.
    linkopts = ["-Wl,-export_dynamic"],
    name = "AlondraMacServiceNavigationTests",
    srcs = ["macOS/Tests/MacServiceNavigationTests.swift"],
    data = ["//fixtures/views:cards"],
    deps = [
        "//apple/Design:AlondraDesign",
        "//apple/Data/Feed:AlondraFeed",
        "//apple/Data/Transport:AlondraTransport",
        "//apple/Features:AlondraFeatures",
        "//apple/Contract:AlondraContract",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
        "@swiftpkg_swift_issue_reporting//:IssueReportingTestSupport",
    ],
)

config_setting(
    name = "distribution",
    define_values = {"alondra_distribution": "1"},
)

# `--define=alondra_sandbox=1` builds apps that also browse the e2e sandbox's Macs
# (`_alondra-sandbox._tcp`); every other build, releases included, lists only the real service.
config_setting(
    name = "sandbox",
    define_values = {"alondra_sandbox": "1"},
)

BONJOUR_PLIST = select({
    ":sandbox": ["Bonjour/BonjourSandbox.plist"],
    "//conditions:default": ["Bonjour/Bonjour.plist"],
})

macos_application(
    name = "AlondraMac",
    app_icons = glob(["IconConcepts/Alondra.icon/**"]),
    bundle_id = IOS_BUNDLE_ID,
    bundle_name = "Alondra",
    infoplists = ["macOS/Info.plist"] + BONJOUR_PLIST,
    entitlements = select({":distribution": "macOS/AppStore.entitlements", "//conditions:default": None}),
    provisioning_profile = select({":distribution": "//signing:Alondra_Mac_AppStore.provisionprofile", "//conditions:default": None}),
    minimum_os_version = "26.0",
    resources = glob(["macOS/Resources/*.xcstrings"]) + ["//fixtures/views:all", "//fixtures/views:cards_ios", "//fixtures/views:demo_mac"],
    version = ":Version",
    visibility = ["//visibility:public"],
    deps = [":AlondraMacViewsEntry"],
)

swift_library(
    name = "AlondraMacWorkspace",
    copts = STRICT_SWIFT_CONCURRENCY_COPTS,
    srcs = glob(["macOS/Workspace/*.swift"]),
    module_name = "AlondraMacWorkspace",
    visibility = ["//apple:__subpackages__"],
    deps = [
        "//apple/Design:AlondraDesign",
        "//apple/Data/Attachments:AlondraAttachments",
        "//apple/Contract:AlondraContract",
        "//apple/Features:AlondraFeatures",
        "//apple/Data/Feed:AlondraFeed",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

swift_library(
    name = "AlondraMacViewsEntry",
    copts = STRICT_SWIFT_CONCURRENCY_COPTS,
    srcs = glob(["macOS/ViewsShipping/*.swift"]),
    module_name = "AlondraMac",
    deps = [
        ":AlondraMacWorkspace",
        "//apple/Design:AlondraDesign",
        "//apple/Data/Transport:AlondraTransport",
        "//apple/Data/Account:AlondraAccount",
        "//apple/Data/Iroh:AlondraIroh",
        "//apple/Data/Notifications:AlondraNotifications",
        "//apple/Data/Pairing:AlondraPairing",
        "//apple/Contract:AlondraContract",
        "//apple/Data/Sync:AlondraNetworkReachability",
        "//apple/Data/Attachments:AlondraAttachments",
        "//apple/Features:AlondraFeatures",
        "//apple/Data/Feed:AlondraFeed",
        "//apple/Demo:AlondraDemo",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

apple_bundle_version(
    name = "Version",
    build_version = versions.build_number,
    short_version_string = versions.version,
)


ios_application(
    name = "AlondraiOS",
    app_icons = glob(["IconConcepts/Alondra.icon/**"]),
    bundle_id = IOS_BUNDLE_ID,
    provisioning_profile = select({":distribution": "//signing:Alondra_AppStore.mobileprovision", "//conditions:default": "//signing:" + IOS_PROFILE}),
    bundle_name = "Alondra",
    entitlements = select({":distribution": "iOS/AppStore.entitlements", "//conditions:default": "iOS/Alondra.entitlements"}),
    families = ["iphone"],
    infoplists = ["iOS/Info.plist"] + BONJOUR_PLIST,
    minimum_os_version = "26.0",
    resources = glob(["iOS/Resources/*.xcstrings"]) + ["//fixtures/views:cards_ios"],
    version = ":Version",
    extensions = [":AlondraNotificationService"],
    visibility = ["//visibility:public"],
    deps = [":AlondraiOSViewsEntry"],
)

swift_library(
    name = "AlondraiOSViewsEntry",
    copts = STRICT_SWIFT_CONCURRENCY_COPTS,
    srcs = glob(["iOS/ViewsShipping/*.swift"]),
    module_name = "AlondraiOS",
    deps = [
        "//apple/Design:AlondraDesign",
        "//apple/Data/Transport:AlondraTransport",
        "//apple/Data/Account:AlondraAccount",
        "//apple/Data/Iroh:AlondraIroh",
        "//apple/Contract:AlondraContract",
        "//apple/Data/Notifications:AlondraNotifications",
        "//apple/Data/Sync:AlondraNetworkReachability",
        "//apple/Demo:AlondraDemo",
        "//apple/Data/Attachments:AlondraAttachments",
        "//apple/Features:AlondraFeatures",
        "//apple/Data/Feed:AlondraFeed",
        "//apple/Data/Pairing:AlondraPairing",
        "//apple/iOS/UI:AlondraiOSUI",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

swift_library(
    name = "AlondraNotificationServiceLib",
    copts = STRICT_SWIFT_CONCURRENCY_COPTS,
    srcs = glob(["iOSNotificationService/Sources/**/*.swift"]),
    module_name = "AlondraNotificationService",
    deps = ["//apple/Data/Notifications:AlondraNotifications"],
)

ios_extension(
    name = "AlondraNotificationService",
    entitlements = select({":distribution": "iOSNotificationService/AppStore.entitlements", "//conditions:default": "iOSNotificationService/AlondraNotificationService.entitlements"}),
    bundle_id = NOTIFICATION_SERVICE_BUNDLE_ID,
    bundle_name = "AlondraNotificationService",
    families = ["iphone"],
    infoplists = ["iOSNotificationService/Info.plist"],
    minimum_os_version = "26.0",
    resources = glob(["iOSNotificationService/Resources/*.xcstrings"]),
    provisioning_profile = select({":distribution": "//signing:Alondra_NotificationService_AppStore.mobileprovision", "//conditions:default": "//signing:" + NOTIFICATION_SERVICE_PROFILE}),
    version = ":Version",
    deps = [":AlondraNotificationServiceLib"],
)
