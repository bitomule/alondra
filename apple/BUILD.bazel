load("@build_bazel_rules_apple//apple:ios.bzl", "ios_application", "ios_extension")
load("@build_bazel_rules_apple//apple:macos.bzl", "macos_application")
load("@build_bazel_rules_apple//apple:versioning.bzl", "apple_bundle_version")
load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")
load("@alondra_signing//:signing.bzl", "IOS_BUNDLE_ID", "IOS_PROFILE", "MAC_BUNDLE_ID", "NOTIFICATION_SERVICE_BUNDLE_ID", "NOTIFICATION_SERVICE_PROFILE")

sh_test(
    name = "no_sleep_wording_test",
    srcs = ["no_sleep_wording_test.sh"],
    args = ["$(rootpaths :localization_catalogs)"],
    data = [":localization_catalogs"],
)

filegroup(
    name = "localization_catalogs",
    srcs = [
        "Shared/Resources/AlondraShared.xcstrings",
        "iOS/Resources/Localizable.xcstrings",
        "macOS/Resources/Localizable.xcstrings",
    ],
)

swift_library(
    name = "AlondraViewsShared",
    srcs = [
        "Shared/Sources/AlondraError.swift",
        "Shared/Sources/Artifacts.swift",
        "Shared/Sources/AttachmentFile.swift",
        "Shared/Sources/CloseNode.swift",
        "Shared/Sources/Diff/DiffHighlighter.swift",
        "Shared/Sources/MarkdownBlocks.swift",
        "Shared/Sources/SendFailurePresentation.swift",
        "Shared/Sources/TableRowCard.swift",
    ] + glob(["Shared/Sources/Code/*.swift"]),
    data = ["Shared/Resources/AlondraShared.xcstrings"],
    module_name = "AlondraShared",
    visibility = ["//visibility:public"],
    deps = [
        "//apple/APIClient:AlondraViewsAPIClient",
        "//apple/Contracts:AlondraViewsContracts",
        "@swiftpkg_highlightswift//:HighlightSwift",
    ],
)

swift_test(
    name = "AlondraSharedTests",
    srcs = [
        "Shared/Tests/APIErrorPresentationTests.swift",
        "Shared/Tests/ArtifactTests.swift",
        "Shared/Tests/AttachmentTests.swift",
        "Shared/Tests/CodeColourTests.swift",
        "Shared/Tests/DiffHighlighterTests.swift",
        "Shared/Tests/MarkdownCorpusTests.swift",
        "Shared/Tests/MarkdownRulesTests.swift",
        "Shared/Tests/SendFailureTests.swift",
        "Shared/Tests/TableRowCardTests.swift",
    ],
    data = ["//fixtures/markdown"],
    deps = [":AlondraViewsShared", "//apple/APIClient:AlondraViewsAPIClient", "//apple/Contracts:AlondraViewsContracts"],
)

swift_test(
    # IssueReporting resolves its reporter with dlsym; retain it under -dead_strip.
    linkopts = ["-Wl,-export_dynamic"],
    name = "AlondraMacWorkspaceOwnerTests",
    srcs = ["macOS/Tests/MacWorkspaceOwnerTests.swift"],
    deps = [
        "//apple/AppComposition:AlondraViewsAppComposition",
        "//apple/Auth:AlondraAuth",
        "//apple/Data/LoopbackSession:AlondraViewsLoopbackSession",
        "//apple/Data/Workspace:AlondraViewsWorkspaceServices",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
        "@swiftpkg_xctest_dynamic_overlay//:IssueReportingTestSupport",
    ],
)

swift_test(
    # IssueReporting resolves its reporter with dlsym; retain it under -dead_strip.
    linkopts = ["-Wl,-export_dynamic"],
    name = "AlondraMacServiceNavigationTests",
    srcs = ["macOS/Tests/MacServiceNavigationTests.swift"],
    deps = [
        "//apple/Features/ViewsDependency:AlondraViewsOnlyDependency",
        "//apple/Features/Workspace:AlondraViewsWorkspaceFeature",
        "//apple/Views:AlondraViews",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
        "@swiftpkg_xctest_dynamic_overlay//:IssueReportingTestSupport",
    ],
)

config_setting(
    name = "distribution",
    define_values = {"alondra_distribution": "1"},
)

apple_bundle_version(
    name = "DistributionVersion",
    build_label_pattern = "alondra_{version}_{build}",
    capture_groups = {"version": "[0-9]+[.][0-9]+[.][0-9]+", "build": "[1-9][0-9]*"},
    build_version = "{build}",
    short_version_string = "{version}",
)

macos_application(
    name = "AlondraMac",
    app_icons = glob(["IconConcepts/Alondra.icon/**"]),
    bundle_id = MAC_BUNDLE_ID,
    bundle_name = "Alondra",
    infoplists = ["macOS/Info.plist"],
    entitlements = select({":distribution": "macOS/AppStore.entitlements", "//conditions:default": None}),
    provisioning_profile = select({":distribution": "//signing:Alondra_Mac_AppStore.provisionprofile", "//conditions:default": None}),
    minimum_os_version = "26.0",
    resources = glob(["macOS/Resources/*.xcstrings"]) + ["//fixtures/views:all"],
    version = select({":distribution": ":DistributionVersion", "//conditions:default": ":Version"}),
    visibility = ["//visibility:public"],
    deps = [":AlondraMacViewsEntry"],
)

swift_library(
    name = "AlondraMacViewsEntry",
    srcs = glob(["macOS/ViewsShipping/*.swift"]) + [
        "macOS/Sources/SidebarCountHeader.swift",
    ],
    module_name = "AlondraMac",
    deps = [
        ":AlondraViewsShared",
        "//apple/APIClient:AlondraViewsAPIClient",
        "//apple/Auth:AlondraAuth",
        "//apple/AuthPresentation:AlondraAuthPresentation",
        "//apple/Contracts:AlondraViewsContracts",
        "//apple/Data/Sync:AlondraNetworkReachability",
        "//apple/AppComposition:AlondraViewsAppComposition",
        "//apple/Data/Workspace:AlondraViewsWorkspaceServices",
        "//apple/Features/Attachments:AlondraViewsAttachmentsFeature",
        "//apple/Features/CloudPairing:AlondraViewsCloudPairingFeature",
        "//apple/Features/Connection:AlondraViewsConnectionFeature",
        "//apple/Features/Settings:AlondraViewsSettingsFeature",
        "//apple/Features/Workspace:AlondraViewsWorkspaceFeature",
        "//apple/Features/ViewsDependency:AlondraViewsOnlyDependency",
        "//apple/Features/ViewsUI:AlondraViewsOnlyUI",
        "//apple/Demo:AlondraViewsDemoWorkspace",
        "//apple/ViewsDiff:AlondraViewsDiff",
        "//apple/Views:AlondraViews",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

apple_bundle_version(
    name = "Version",
    build_version = "3",
    short_version_string = "0.1.1",
)


ios_application(
    name = "AlondraiOS",
    app_icons = glob(["IconConcepts/Alondra.icon/**"]),
    bundle_id = IOS_BUNDLE_ID,
    provisioning_profile = select({":distribution": "//signing:Alondra_AppStore.mobileprovision", "//conditions:default": "//signing:" + IOS_PROFILE}),
    bundle_name = "Alondra",
    entitlements = select({":distribution": "iOS/AppStore.entitlements", "//conditions:default": "iOS/Alondra.entitlements"}),
    families = ["iphone"],
    infoplists = ["iOS/Info.plist"],
    minimum_os_version = "26.0",
    resources = glob(["iOS/Resources/*.xcstrings"]) + ["//fixtures/views:all"],
    version = select({":distribution": ":DistributionVersion", "//conditions:default": ":Version"}),
    extensions = [":AlondraNotificationService"],
    visibility = ["//visibility:public"],
    deps = [":AlondraiOSViewsEntry"],
)

swift_library(
    name = "AlondraiOSViewsEntry",
    srcs = glob(["iOS/ViewsShipping/*.swift"]) + [
        "iOS/Sources/CameraPicker.swift",
        "iOS/Sources/MarkdownBlockView.swift",
        "iOS/Sources/Presentation/PressStyle.swift",
        "iOS/Sources/ServiceAttachButton.swift",
        "iOS/Sources/ServiceAttachmentStrip.swift",
        "iOS/Sources/TableRowCardView.swift",
        "iOS/Sources/ServiceTriage/ServiceHomeCard.swift",
        "iOS/Sources/ServiceTriage/ServiceHomeView.swift",
        "iOS/Sources/ServiceTriage/ServiceWireDocumentView.swift",
        "iOS/Sources/ServiceTriage/ServiceWirePullRequestView.swift",
        "iOS/Sources/Theme.swift",
    ],
    module_name = "AlondraiOS",
    deps = [
        ":AlondraViewsShared",
        "//apple/APIClient:AlondraViewsAPIClient",
        "//apple/Auth:AlondraAuth",
        "//apple/AuthPresentation:AlondraAuthPresentation",
        "//apple/Contracts:AlondraViewsContracts",
        "//apple/Data/Notifications:AlondraViewsNotificationActions",
        "//apple/Data/PushBinding:AlondraPushBinding",
        "//apple/Data/Sync:AlondraNetworkReachability",
        "//apple/Demo:AlondraViewsDemoWorkspace",
        "//apple/NotificationPayload:AlondraNotificationPayload",
        "//apple/AppComposition:AlondraViewsAppComposition",
        "//apple/Data/Workspace:AlondraViewsWorkspaceServices",
        "//apple/Features/Attachments:AlondraViewsAttachmentsFeature",
        "//apple/Features/CloudPairing:AlondraViewsCloudPairingFeature",
        "//apple/Features/Connection:AlondraViewsConnectionFeature",
        "//apple/Features/Home:AlondraViewsHomeFeature",
        "//apple/Features/Settings:AlondraViewsSettingsFeature",
        "//apple/Features/Workspace:AlondraViewsWorkspaceFeature",
        "//apple/Features/ViewsDependency:AlondraViewsOnlyDependency",
        "//apple/Features/ViewsUI:AlondraViewsOnlyUI",
        "//apple/ViewsDiff:AlondraViewsDiff",
        "//apple/ServicePairing:AlondraViewsServicePairing",
        "//apple/Views:AlondraViews",
        "@swiftpkg_swift_composable_architecture//:ComposableArchitecture",
    ],
)

swift_library(
    name = "AlondraNotificationServiceLib",
    srcs = glob(["iOSNotificationService/Sources/**/*.swift"]),
    module_name = "AlondraNotificationService",
    deps = ["//apple/NotificationPayload:AlondraNotificationPayload", "//apple/Data/Notifications:AlondraViewsNotificationActions"],
)

ios_extension(
    name = "AlondraNotificationService",
    entitlements = select({":distribution": "iOSNotificationService/AppStore.entitlements", "//conditions:default": "iOSNotificationService/AlondraNotificationService.entitlements"}),
    bundle_id = NOTIFICATION_SERVICE_BUNDLE_ID,
    bundle_name = "AlondraNotificationService",
    families = ["iphone"],
    infoplists = ["iOSNotificationService/Info.plist"],
    minimum_os_version = "26.0",
    resources = glob(["iOSNotificationService/Resources/*.xcstrings"]),
    provisioning_profile = select({":distribution": "//signing:Alondra_NotificationService_AppStore.mobileprovision", "//conditions:default": "//signing:" + NOTIFICATION_SERVICE_PROFILE}),
    version = select({":distribution": ":DistributionVersion", "//conditions:default": ":Version"}),
    deps = [":AlondraNotificationServiceLib"],
)
