load("@build_bazel_rules_apple//apple:ios.bzl", "ios_application")
load("@build_bazel_rules_apple//apple:macos.bzl", "macos_application")
load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")
load("//apple:swift.bzl", "STRICT_SWIFT_CONCURRENCY_COPTS")

swift_library(
    name = "AlondraNativeScenarios",
    copts = STRICT_SWIFT_CONCURRENCY_COPTS,
    testonly = True,
    srcs = glob(["Sources/*.swift"]),
    module_name = "AlondraNativeScenarios",
    deps = [
        "//apple/Data/Transport:AlondraTransport",
        "//apple/Data/Account:AlondraAccount",
    ],
)

swift_library(
    name = "iOSEntry",
    copts = STRICT_SWIFT_CONCURRENCY_COPTS,
    testonly = True,
    srcs = ["iOS/Main.swift"],
    deps = [":AlondraNativeScenarios"],
)

swift_library(
    name = "MacEntry",
    copts = STRICT_SWIFT_CONCURRENCY_COPTS,
    testonly = True,
    srcs = ["macOS/Main.swift"],
    deps = [":AlondraNativeScenarios"],
)

ios_application(
    name = "AlondraNativeHarnessiOS",
    testonly = True,
    bundle_id = "com.bitomule.alondra.nativeharness",
    bundle_name = "AlondraNativeHarness",
    families = ["iphone"],
    infoplists = ["Info.plist"],
    minimum_os_version = "26.0",
    deps = [":iOSEntry"],
)

macos_application(
    name = "AlondraNativeHarnessMac",
    testonly = True,
    bundle_id = "com.bitomule.alondra.nativeharness",
    bundle_name = "AlondraNativeHarness",
    infoplists = ["Info.plist"],
    minimum_os_version = "26.0",
    deps = [":MacEntry"],
)
