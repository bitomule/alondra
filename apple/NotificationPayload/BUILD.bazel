load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")

swift_library(
    name = "AlondraNotificationPayload",
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "AlondraNotificationPayload",
    visibility = ["//apple:__subpackages__"],
)

swift_test(
    name = "AlondraNotificationPayloadTests",
    srcs = glob(["Tests/**/*.swift"]),
    data = ["//fixtures/views:all"],
    deps = [":AlondraNotificationPayload", "//apple/Contracts:AlondraViewsContracts"],
)
