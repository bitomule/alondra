load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")

swift_library(
    name = "AlondraServicePairing",
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "AlondraServicePairing",
    features = ["swift.enable_testing"],
    visibility = ["//visibility:public"],
    deps = ["//apple/RelayClient:AlondraRelayClient"],
)

swift_test(
    name = "AlondraServicePairingTests",
    srcs = glob(["Tests/**/*.swift"]),
    deps = [":AlondraServicePairing", "//apple/RelayClient:AlondraRelayClient"],
)
