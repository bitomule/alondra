load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library", "swift_test")

swift_library(
    name = "AlondraViewsServicePairing",
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "AlondraServicePairing",
    visibility = ["//visibility:public"],
    deps = ["//apple/APIClient:AlondraViewsAPIClient"],
    features = ["swift.enable_testing"],
)

swift_test(
    name = "AlondraServicePairingTests",
    srcs = glob(["Tests/**/*.swift"]),
    deps = [":AlondraViewsServicePairing", "//apple/APIClient:AlondraViewsAPIClient"],
)
