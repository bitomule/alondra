filegroup(
    name = "license_inputs",
    srcs = [
        "alondra.rb.in",
        "node/LICENSE",
    ],
    visibility = ["//tools:__pkg__"],
)

sh_test(
    name = "upgrade_rehearsal_test",
    srcs = ["tests/test_upgrade_rehearsal.py"],
    data = [
        "release.py",
        "upgrade-rehearsal.py",
        "//launchd:alondra.plist.in",
    ],
    timeout = "moderate",
    # Runs fake daemons outside Bazel's sandbox; unlike `local`, its result is still cached.
    tags = ["no-sandbox"],
)

sh_test(
    name = "plugin_payload_test",
    size = "small",
    srcs = ["plugin_payload_test.py"],
    args = [
        "$(rootpath release.py)",
        "$(rootpaths //:plugin_files)",
    ],
    data = [
        "release.py",
        "//:plugin_files",
    ],
)

sh_test(
    name = "local_release_test",
    size = "small",
    env_inherit = ["PATH"],
    srcs = ["tests/run-release-tests.sh"],
    args = ["$(rootpath tests/test_local_release.py)"],
    data = [
        "local-release.py",
        "release.py",
        "tests/test_local_release.py",
        "//:Cargo.lock",
        "//:Cargo.toml",
        "//agent-host:codex-main.ts",
        "//agent-host:host-entitlements.plist",
        "//agent-host:persistent-main.ts",
        "//crates:workspace_manifests",
        "//crates/alondrad:Info.plist",
    ],
    tags = ["no-sandbox"],
)

sh_test(
    name = "release_test",
    size = "small",
    env_inherit = ["PATH"],
    srcs = ["tests/run-release-tests.sh"],
    args = ["$(rootpath tests/test_release.py)"],
    data = [
        "alondra.rb.in",
        "node/LICENSE",
        "release.py",
        "tests/test_release.py",
        "//:Cargo.toml",
        "//:LICENSE.md",
        "//:THIRD_PARTY_NOTICES.md",
        "//:plugin_files",
        "//:version.bzl",
    ],
    tags = ["no-sandbox"],
)
