startup --digest_function=blake3
common --cache_computed_file_digests=500000
common --noworker_sandboxing
common --spawn_strategy=worker,local
build --incompatible_strict_action_env
build --macos_minimum_os=26.0
build -c opt

# Clippy resolves the APIs used by tests, including aliases and imported functions.
build --@rules_rust//rust/settings:clippy.toml=//:clippy.toml
build --@rules_rust//rust/settings:clippy_flags=-Aclippy::all,-Dclippy::disallowed_methods
build --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build --output_groups=+clippy_checks

# BuildBuddy remote cache, opt-in: `--config=buildbuddy` reads it, `--config=upload` also writes.
# A fresh clone builds without sending anything to a third party. On the maintainer's Mac,
# ~/.bazelrc is read after this file and turns the cache and uploads on for every build. The API
# key never lives here: locally it comes from ~/.bazelrc (a credential helper), in CI from
# `--remote_header=x-buildbuddy-api-key=<secret>` on the command line.
common:buildbuddy --remote_cache=grpcs://remote.buildbuddy.io
common:buildbuddy --remote_cache_compression
common:buildbuddy --noremote_upload_local_results
common:upload --config=buildbuddy
common:upload --remote_upload_local_results

# Signing, linking and bundling outputs are machine-specific or cheap to redo; never cache them.
common --modify_execution_info=^(AppleLipo|BitcodeSymbolsCopy|BundleApp|BundleTreeApp|DsymDwarf|DsymLipo|GenerateAppleSymbolsFile|ObjcBinarySymbolStrip|CppArchive|CppLink|ObjcLink|ProcessAndSign|SignBinary|SwiftArchive|SwiftStdlibCopy)$=+no-remote,^(BundleResources|ImportedDynamicFrameworkProcessor)$=+no-remote-exec

common:ci --config=upload
common:ci --color=yes
common:ci --announce_rc
common:ci --bes_backend=grpcs://remote.buildbuddy.io
common:ci --bes_results_url=https://app.buildbuddy.io/invocation/

common:warming --config=upload
common:warming --remote_download_minimal

test --keep_going
# Every test gets its own short TMPDIR under /tmp, removed when it ends: macOS caps a unix socket
# path at 104 bytes, and the default one under /var/folders is too long for the daemon's sockets.
test --run_under=//tools:test_tmpdir

# musts: stamp every build with the scope hashes and keep the last test invocation for `musts record`.
build --workspace_status_command=tools/musts-stamp.sh
test --build_event_json_file=.musts/bep.json
