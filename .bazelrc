startup --digest_function=blake3
common --cache_computed_file_digests=500000
common --noworker_sandboxing
common --spawn_strategy=worker,local
build --incompatible_strict_action_env
# The convenience symlinks go in one directory that .bazelignore skips: a symlink at the root leads
# the root package's glob into a runfiles tree that links back to the checkout, an infinite loop.
common --symlink_prefix=.bazel-links/bazel-
build --macos_minimum_os=26.0
build -c opt

# rustc compiles incrementally: a one-line edit recompiles only what it changed. Actions run
# unsandboxed in the execroot, so the state lives two levels up, in this checkout's output base,
# and goes with it. Clippy keeps its own state: sharing rustc's would discard it on every check.
# A release builds without it (`--config=release`); `bazelisk clean --expunge` deletes the state.
build --@rules_rust//rust/settings:extra_rustc_flags=-Cincremental=../../rustc-incremental

# Clippy resolves the APIs used by tests, including aliases and imported functions.
build --@rules_rust//rust/settings:clippy.toml=//:clippy.toml
build --@rules_rust//rust/settings:clippy_flags=-Aclippy::all,-Dclippy::disallowed_methods,-Cincremental=../../rustc-incremental-clippy
build --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build --output_groups=+clippy_checks

# BuildBuddy remote cache, opt-in: `--config=buildbuddy` reads it, `--config=upload` also writes.
# A fresh clone builds without sending anything to a third party. On the maintainer's Mac,
# ~/.bazelrc is read after this file and turns the cache and uploads on for every build. The API
# key comes from a local credential helper. External contribution CI uses no remote cache.
common:buildbuddy --remote_cache=grpcs://remote.buildbuddy.io
common:buildbuddy --remote_cache_compression
common:buildbuddy --noremote_upload_local_results
common:upload --config=buildbuddy
common:upload --remote_upload_local_results

# Signing, linking and bundling outputs are machine-specific or cheap to redo; never cache them.
common --modify_execution_info=^(AppleLipo|BitcodeSymbolsCopy|BundleApp|BundleTreeApp|DsymDwarf|DsymLipo|GenerateAppleSymbolsFile|ObjcBinarySymbolStrip|CppArchive|CppLink|ObjcLink|ProcessAndSign|SignBinary|SwiftArchive|SwiftStdlibCopy)$=+no-remote,^(BundleResources|ImportedDynamicFrameworkProcessor)$=+no-remote-exec

common:ci --color=yes
common:ci --announce_rc
common:ci --remote_cache=
common:ci --noremote_upload_local_results
common:ci --bes_backend=
build:ci --jobs=2
# A runner starts empty and is thrown away: it compiles from scratch, like a release.
build:ci --@rules_rust//rust/settings:extra_rustc_flags=
build:ci --@rules_rust//rust/settings:clippy_flags=-Aclippy::all,-Dclippy::disallowed_methods
build:ci --xcode_version=27.1
test:ci --local_test_jobs=1
test:ci --experimental_ui_max_stdouterr_bytes=16777216
test:ci --test_env=DISABLE_AUTOUPDATER=1
test:ci --test_env=CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

common:warming --config=upload
common:warming --remote_download_minimal

# What ships compiles from scratch, as before the edit loop went incremental; the release tests the
# same binaries in this configuration, so it never compiles them twice.
build:release --@rules_rust//rust/settings:extra_rustc_flags=
build:release --@rules_rust//rust/settings:clippy_flags=-Aclippy::all,-Dclippy::disallowed_methods

# A full disk makes `java.log` fail while another thread holds the console, and Bazel 8.4.2 deadlocks
# between the two: the server stops forever with no test running, and no test timeout can end it.
common --logging=0

# Short, moderate, long and eternal, in seconds. `tools/test_limits.py` keeps a limit on every test.
test --test_timeout=60,300,600,900
test --keep_going
import %workspace%/tools/test-wrapper.bazelrc

# musts: stamp every build with the scope hashes and keep the last test invocation for `musts record`.
build --workspace_status_command=tools/musts-stamp.sh
test --build_event_json_file=.musts/bep.json

try-import %workspace%/.bazelrc.local
