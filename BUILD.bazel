exports_files(["Cargo.toml", "Cargo.lock", "clippy.toml"])

# What `//tools:licenses_test` reads: the license, its notices and the lockfiles they come from.
filegroup(
    name = "license_inputs",
    srcs = [
        "LICENSE.md",
        "THIRD_PARTY_NOTICES.md",
        "//apple/Features:Sources/Settings/Licenses/AppLicenses.swift",
        "Cargo.toml",
        "Cargo.lock",
        "MODULE.bazel",
        "Package.resolved",
        "web/package.json",
        "web/package-lock.json",
        "web/app/public/fonts/OFL-archivo.txt",
        "web/app/public/fonts/OFL-martian-mono.txt",
        "web/app/public/fonts/OFL-newsreader.txt",
    ],
    visibility = ["//tools:__pkg__"],
)

exports_files(
    [
        "plugin/skills/alondra/SKILL.md",
        "plugin-orchestrator/skills/alondra-orchestrator/SKILL.md",
    ],
    visibility = ["//crates/alondra:__pkg__"],
)

exports_files(
    ["Makefile"],
    visibility = ["//crates/alondra:__pkg__", "//deploy/apple:__pkg__", "//tools:__pkg__"],
)

exports_files([".bazelrc"], visibility = ["//tools:__pkg__"])

# What Claude Code writes beside a mod it loads with --plugin-dir: never part of the plugin.
MOD_TYPES = [
    "plugin/.gitignore",
    "plugin/tsconfig.json",
    "plugin/.claude-plugin/types/**",
]

# The skill evals (`make skill-evals`) test the plugins from the repository; users never get them.
SKILL_EVALS = [
    "plugin/evals/**",
    "plugin-orchestrator/evals/**",
]

filegroup(
    name = "plugin_files",
    srcs = glob(
        [
            ".claude-plugin/**",
            "plugin/**",
            "plugin-orchestrator/**",
        ],
        exclude = ["plugin-orchestrator/bin/**"] + MOD_TYPES + SKILL_EVALS,
    ),
    visibility = [
        "//deploy/brew:__pkg__",
        "//tests/sandbox:__pkg__",
    ],
)

sh_test(
    name = "plugin_mod_test",
    srcs = ["//tools:plugin-mod-test.sh"],
    args = ["$(rootpath plugin/.claude-plugin/plugin.json)"],
    data = glob(["plugin/**"], exclude = MOD_TYPES + SKILL_EVALS),
    env_inherit = ["PATH"],
    size = "small",
    tags = ["local"],
)

# Starts the real SourceKit-LSP on the root files it reads, with a fake build server.
sh_test(
    name = "sourcekit_lsp_workspace_test",
    srcs = ["//tools:tests/test_sourcekit_lsp_workspace.py"],
    data = ["Package.swift", "Package.resolved"] + glob(
        [".bsp/skbsp.json", ".sourcekit-lsp/config.json"],
        allow_empty = True,
    ),
    size = "small",
    tags = ["no-sandbox"],
)
